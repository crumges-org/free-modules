msgid ""
"<code>\n"
"                                        {\n"
"                                            \"array_source\": \"product_variant_ids\", // Odoo One2many or Many2many field\n"
"                                            \"item_mapping\": {\n"
"                                                \"id\": {\"field\": \"external_id\", \"type\": \"integer\"},\n"
"                                                \"values\": {\"expression\": \"[{'en': av.name} for av in item.attribute_value_ids]\"},\n"
"                                                \"price\": {\"field\": \"list_price\", \"transform\": \"f'{float(value):.2f}'\"}\n"
"                                            }\n"
"                                        }\n"
"                                        </code>"
msgstr ""
"<code>\n"
"                                        {\n"
"                                            \"array_source\": \"product_variant_ids\", // Campo One2many o Many2many de Odoo\n"
"                                            \"item_mapping\": {\n"
"                                                \"id\": {\"field\": \"external_id\", \"type\": \"integer\"},\n"
"                                                \"values\": {\"expression\": \"[{'en': av.name} for av in item.attribute_value_ids]\"},\n"
"                                                \"price\": {\"field\": \"list_price\", \"transform\": \"f'{float(value):.2f}'\"}\n"
"                                            }\n"
"                                        }\n"
"                                        </code>"

#. module: solt_api_connector
#: model_terms:ir.ui.view,arch_db:solt_api_connector.view_solt_api_endpoint_form
msgid ""
"<code>\n"
"                                        {\n"
"                                            \"id\": {\"field\": \"external_id\", \"type\": \"integer\"},\n"
"                                            \"variants\": {\n"
"                                              \"source\": \"product_variant_ids\",\n"
"                                              \"items\": [\n"
"                                                {\n"
"                                                  \"id\": {\"field\": \"external_id\", \"type\": \"integer\"},\n"
"                                                  \"price\": {\"field\": \"list_price\", \"type\": \"float\"},\n"
"                                                  \"inventory_levels\": {\n"
"                                                    \"source\": \"stock_quant_ids\",\n"
"                                                    \"items\": [\n"
"                                                      {\n"
"                                                        \"stock\": {\"field\": \"quantity\", \"type\": \"integer\"}\n"
"                                                      }\n"
"                                                    ]\n"
"                                                  }\n"
"                                                }\n"
"                                              ]\n"
"                                            }\n"
"                                        }\n"
"                                        </code>"
msgstr ""

#. module: solt_api_connector
#: model_terms:ir.ui.view,arch_db:solt_api_connector.view_solt_api_endpoint_form
msgid ""
"<code>\n"
"                                        {\n"
"                                        \"name\": \"data['name']\", // Direct access to a field\n"
"                                        \"reference\": \"data.get('ref', '')\", // With default value\n"
"                                        \"date_order\": \"fields.Date.to_date(data['date'])\", // Type conversion\n"
"                                        \"amount_total\": \"float(data['amount']) * 1.16\", // Mathematical operation\n"
"                                        \"state\": \"'paid' if float(data['amount']) &gt; 0 else 'draft'\", // Conditional\n"
"\n"
"                                        // Relational field (many2one)\n"
"                                        \"partner_id\": \"env['res.partner'].search([('ref', '=', data['customer_id'])],\n"
"                                        limit=1).id\",\n"
"\n"
"                                        // Create record if it doesn't exist\n"
"                                        \"partner_id\": \"env['res.partner'].search([('ref', '=', data['customer_id'])],\n"
"                                        limit=1).id or env['res.partner'].create({'ref': data['customer_id'], 'name':\n"
"                                        data['customer_name']}).id\",\n"
"\n"
"                                        // one2many lines using list comprehension\n"
"                                        \"line_ids\": \"[Command.create({'product_id':\n"
"                                        env['product.product'].search([('default_code', '=', item['code'])], limit=1).id,\n"
"                                        'quantity': float(item['qty']), 'price_unit': float(item['price'])}) for item in\n"
"                                        data.get('items', [])]\"\n"
"\n"
"                                        // Execute functions by passing their name and parameters\n"
"                                            \"name\": \"method('func_name', data.get('name'))\"\n"
"                                        }\n"
"                                    </code>"
msgstr ""
"<code>\n"
"                                        {\n"
"                                        \"name\": \"data['name']\", // Acceso directo a un campo\n"
"                                        \"reference\": \"data.get('ref', '')\", // Con valor predeterminado\n"
"                                        \"date_order\": \"fields.Date.to_date(data['date'])\", // Conversión de tipo\n"
"                                        \"amount_total\": \"float(data['amount']) * 1.16\", // Operación matemática\n"
"                                        \"state\": \"'paid' if float(data['amount']) &gt; 0 else 'draft'\", // Condicional\n"
"\n"
"                                        // Campo relacional (many2one)\n"
"                                        \"partner_id\": \"env['res.partner'].search([('ref', '=', data['customer_id'])],\n"
"                                        limit=1).id\",\n"
"\n"
"                                        // Crear el registro si no existe\n"
"                                        \"partner_id\": \"env['res.partner'].search([('ref', '=', data['customer_id'])],\n"
"                                        limit=1).id or env['res.partner'].create({'ref': data['customer_id'], 'name':\n"
"                                        data['customer_name']}).id\",\n"
"\n"
"                                        // Líneas one2many usando list comprehension\n"
"                                        \"line_ids\": \"[Command.create({'product_id':\n"
"                                        env['product.product'].search([('default_code', '=', item['code'])], limit=1).id,\n"
"                                        'quantity': float(item['qty']), 'price_unit': float(item['price'])}) for item in\n"
"                                        data.get('items', [])]\"\n"
"\n"
"                                        // Ejecutar funciones pasando su nombre y parámetros\n"
"                                            \"name\": \"method('func_name', data.get('name'))\"\n"
"                                        }\n"
"                                    </code>"


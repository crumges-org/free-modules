<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_data_initial_import_check" model="ir.cron">
            <field name="name">API Connector: Automation Initial Import: check and execute</field>
            <field name="model_id" ref="model_ir_actions_server"/>
            <field name="state">code</field>
            <field name="code">model.cron_execute_initial_imports(True)</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <!-- Clear sync flags cron -->
        <record id="ir_cron_clear_all_sync_flags" model="ir.cron">
            <field name="name">API Connector: Clear all sync flags</field>
            <field name="model_id" ref="model_connector_sync_mixin"/>
            <field name="state">code</field>
            <field name="code">model.clear_all_sync_flags()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Initial export cron -->
        <record id="ir_cron_data_initial_export_check" model="ir.cron">
            <field name="name">API Connector: Initial export processing</field>
            <field name="model_id" ref="base.model_ir_actions_server"/>
            <field name="code">model.cron_execute_initial_exports(automatic=True)</field>
            <field name="state">code</field>
            <field name="active" eval="False"/>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>

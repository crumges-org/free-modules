<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Improved form view for solt.api.endpoint in Odoo 17 -->
    <record id="view_solt_api_endpoint_form" model="ir.ui.view">
        <field name="name">solt.api.endpoint.form</field>
        <field name="model">solt.api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Endpoint name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="connector_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="model_id" options="{'no_create': True}" domain="[('transient','=',False)]"/>
                            <field name="code" placeholder="unique_identifier"/>
                        </group>
                        <group>
                            <field name="endpoint_path" placeholder="/route/{id}/resource"/>
                            <field name="method"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Tab for request mapping with compact format examples -->
                        <page string="Request Mapping" name="request_mapping" invisible="method in ['GET', 'DELETE']">
                            <div class="col-md-6 col-xl-5">
                                <label for="request_as_array" string="Send request as array"/>
                                <field name="request_as_array"/>
                            </div>
                            <div class="alert alert-info" role="alert">
                                <div class="mb-1">
                                    <strong>Request mapping format (Odoo → API):</strong>
                                </div>
                                <div class="mb-1">
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "client_id": "15612", // Constant direct value
                                            "client_secret": "a356cdf67a71ca483d309a56315744be646e6d5816531afc",
                                            "grant_type": "authorization_code",
                                            "code": {"payload": "code"}, // Payload value
                                            "customer_name": {"field": "partner_id.name"}, // Odoo field
                                            "amount": {"field": "amount_total", "type": "float"}, // With type conversion
                                            "date": {"field": "date", "transform": "value.strftime('%Y-%m-%d')"}, // With transformation
                                            "name": {"field": "name", "transform": "method('_get_name', value)"}, // Execute method with transformation
                                            }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mt-3"><strong>Array format:</strong></div>
                                <div class="mb-1">Simple array
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "array_source": "product_variant_ids", // Odoo One2many or Many2many field
                                            "item_mapping": {
                                            "id": {"field": "external_id", "type": "integer"},
                                            "values": {"expression": "[{'en': av.name} for av in item.attribute_value_ids]"},
                                            "price": {"field": "list_price", "transform": "f'{float(value):.2f}'"}
                                            }
                                            }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mb-1">
                                    Nested arrays
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "id": {"field": "external_id", "type": "integer"},
                                            "variants": {
                                            "source": "product_variant_ids",
                                            "items": [
                                            {
                                            "id": {"field": "external_id", "type": "integer"},
                                            "price": {"field": "list_price", "type": "float"},
                                            "inventory_levels": {
                                            "source": "stock_quant_ids",
                                            "items": [
                                            {
                                            "stock": {"field": "quantity", "type": "integer"}
                                            }
                                            ]
                                            }
                                            }
                                            ]
                                            }
                                            }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mt-3"><strong>Syntax reference:</strong></div>
                                <ul class="mt-2">
                                    <li><code>"api_field": "value"</code> - Constant value</li>
                                    <li><code>"api_field": {"field": "odoo_field.subfield"}</code> - Odoo field</li>
                                    <li><code>"api_field": {"payload": "param_name"}</code> - Payload/parameter value</li>
                                    <li><code>"api_field": {"field": "field", "type": "float|integer|string|boolean|date|datetime"}</code> - Type conversion</li>
                                    <li><code>"api_field": {"field": "field", "transform": "python code using 'value'"}</code> - Transformation</li>
                                    <li><code>"api_field": {"expression": "Python expression with access to 'item' and 'env'"}</code> - Python expression</li>
                                </ul>
                            </div>
                            <field name="request_mapping" widget="ace" placeholder='{
  "client_id": "15612",
  "client_secret": "a356cdf67a71ca483d309a56315744be646e6d5816531afc",
  "grant_type": "authorization_code",
  "code": {"payload": "code"}
}' required="method in ['PUT', 'POST']"/>
                        </page>

                        <!-- Tab for response mapping with examples using Python expressions -->
                        <page string="Mapeo de Respuesta" name="response_mapping" invisible="method in ['DELETE']">
                            <div class="alert alert-info" role="alert">
                                <div class="mb-1">
                                    <strong>Python expression mapping (API → Odoo):</strong>
                                </div>
                                <div class="mb-1">
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "name": "data['name']", // Direct access to a field
                                            "reference": "data.get('ref', '')", // With default value
                                            "date_order": "fields.Date.to_date(data['date'])", // Type conversion
                                            "amount_total": "float(data['amount']) * 1.16", // Mathematical operation
                                            "state": "'paid' if float(data['amount']) > 0 else 'draft'", // Conditional

                                            // Relational field (many2one)
                                            "partner_id": "env['res.partner'].search([('ref', '=', data['customer_id'])],
                                            limit=1).id",

                                            // Create record if it doesn't exist
                                            "partner_id": "env['res.partner'].search([('ref', '=', data['customer_id'])],
                                            limit=1).id or env['res.partner'].create({'ref': data['customer_id'], 'name':
                                            data['customer_name']}).id",

                                            // one2many lines using list comprehension
                                            "line_ids": "[Command.create({'product_id':
                                            env['product.product'].search([('default_code', '=', item['code'])], limit=1).id,
                                            'quantity': float(item['qty']), 'price_unit': float(item['price'])}) for item in
                                            data.get('items', [])]"

                                            // Execute functions by passing their name and parameters
                                            "name": "method('func_name', data.get('name'))"
                                            }
                                        </code>
                                    </pre>
                                </div>
                                <div class="mt-3">Expressions have access to:</div>
                                <ul class="mt-2">
                                    <li><code>data</code>: API response data</li>
                                    <li><code>env</code>: Odoo environment</li>
                                    <li><code>record</code>: Current record (for updates)</li>
                                    <li><code>fields</code>: Helper for conversions</li>
                                    <li><code>Command</code>: one2many/many2many commands</li>
                                    <li><code>datetime</code>, <code>json</code>, <code>re</code>: useful Python libs</li>
                                    <li><code>method</code>: Execute Odoo methods</li>
                                </ul>
                            </div>
                            <field name="response_mapping" widget="ace" placeholder='{
  "name": "data[\"name\"]",
  "amount_total": "float(data[\"amount\"]) * 1.16",
  "partner_id": "env[\"res.partner\"].search([(\"ref\", \"=\", data[\"customer_id\"])], limit=1).id or env[\"res.partner\"].create({\"ref\": data[\"customer_id\"], \"name\": data[\"customer_name\"]}).id"
}'/>
                        </page>

                        <!-- Tab for parameters configuration -->
                        <page string="Parameters" name="parameters" invisible="method != 'GET'">
                            <div class="alert alert-info" role="alert">
                                <div class="mb-3">
                                    <strong>Parameters for GET requests:</strong>
                                </div>
                                <div class="mb-1">
                                    <pre class="o_format_json_structure">
                                        <code>
                                            {
                                            "cliente_id": {"field": "partner_id.id"}, // Dynamic parameter from Odoo field
                                            "estado": "activo", // Fixed value parameter
                                            "token": {"payload": "token"} // Parameter from payload
                                            }
                                        </code>
                                    </pre>
                                </div>
                            </div>
                            <field name="request_param" widget="ace" placeholder='{
                              "client_id": "15612",
                              "redirect_uri": "https://example.com/callback"
                            }'/>
                        </page>
                        <page string="Headers" name="headers">
                            <field name="headers" widget="ace" placeholder='{
                          "client_id": "15612",
                          "redirect_uri": "https://example.com/callback"
                        }'/>
                        </page>
                        <!-- Tab for required API fields configuration -->
                        <page string="Required fields" name="required_request" invisible="method not in ['POST', 'PUT']">
                            <group>
                                <field name="check_required_request_field"/>
                            </group>
                            <field name="required_request_field" widget="ace" placeholder='{
                             "id": "x_external_id"
                            }' required="check_required_request_field == True" invisible="check_required_request_field == False"/>
                        </page>

                        <!-- Tab for pagination configuration -->
                        <page string="Pagination" name="pagination" invisible="method != 'GET'">
                            <group>
                                <field name="pagination_enabled"/>
                                <field name="pagination_param"
                                       invisible="not pagination_enabled"
                                       required="pagination_enabled"
                                       placeholder="page"/>
                                <field name="pagination_size_param"
                                       invisible="not pagination_enabled"
                                       required="pagination_enabled"
                                       placeholder="limit"/>
                                <field name="pagination_size"
                                       invisible="not pagination_enabled"
                                       required="pagination_enabled"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for solt.api.endpoint -->
    <record id="view_solt_api_endpoint_list" model="ir.ui.view">
        <field name="name">solt.api.endpoint.list</field>
        <field name="model">solt.api.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="connector_id"/>
                <field name="endpoint_path"/>
                <field name="method"/>
                <field name="model_id"/>
            </list>
        </field>
    </record>

    <!-- Search view for solt.api.endpoint -->
    <record id="view_solt_api_endpoint_search" model="ir.ui.view">
        <field name="name">solt.api.endpoint.search</field>
        <field name="model">solt.api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="endpoint_path"/>
                <field name="connector_id"/>
                <field name="model_id"/>
                <group>
                    <filter string="Connector" name="group_by_connector" context="{'group_by':'connector_id'}"/>
                    <filter string="Method" name="group_by_method" context="{'group_by':'method'}"/>
                    <filter string="Model" name="group_by_model" context="{'group_by':'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Menu action for solt.api.endpoint -->
    <record id="action_solt_api_endpoint" model="ir.actions.act_window">
        <field name="name">API Endpoints</field>
        <field name="res_model">solt.api.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new API endpoint
            </p>
            <p>
                API endpoints define the operations available on connectors.
            </p>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_access_token_tree" model="ir.ui.view">
        <field name="name">api.access_token.view.tree</field>
        <field name="model">api.access_token</field>
        <field name="arch" type="xml">
            <list string="Access Token" create="0" edit="0">
                <field name="user_id"/>
                <field name="access_token"/>
                <field name="refresh_token"/>
                <field name="access_token_expires"/>
                <field name="refresh_token_expires"/>
                <field name="scope"/>
            </list>
        </field>
    </record>

    <record id="action_access_token_api" model="ir.actions.act_window">
	    <field name="name">Access Token</field>
	    <field name="res_model">api.access_token</field>
	    <field name="view_mode">list</field>
	    <field name="view_id" ref="view_api_access_token_tree"/>
	</record>
    
    <menuitem 
        id="access_token_api"
        name="Access token"
        action="action_access_token_api"
        parent="base.menu_custom"
        sequence="35"
    />
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="access_token_view_users_form_inherit" model="ir.ui.view">
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[last()]" position="after">
                    <page name="access_token" string="Access Token" groups="base.group_no_one">
                        <field name="token_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="access_token"/>
                                <field name="refresh_token"/>
                                <field name="access_token_expires"/>
                                <field name="refresh_token_expires"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

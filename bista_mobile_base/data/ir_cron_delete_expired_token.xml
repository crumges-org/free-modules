<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="ir_delete_expired_token" model="ir.cron">
            <field name="name">Delete Expired Access Token and Refresh Token</field>
            <field name="model_id" ref="bista_mobile_base.model_api_access_token"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.delete_expired_token()</field>
            <field name="active" eval="False"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=40, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority" eval="10" />
            <field name="help">      Remove authentication tokens when the refresh token has expired.
            </field>
        </record>

        <record id="ir_delete_token" model="ir.cron">
            <field name="name">Delete Access Token and Refresh Token</field>
            <field name="model_id" ref="bista_mobile_base.model_api_access_token"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.delete_token()</field>
            <field name="active" eval="False"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=40, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="priority" eval="10" />
            <field name="help">      Clean up token records where access_token OR refresh_token OR expires_at is NULL/empty.
            </field>
        </record>
    </data>
</odoo>

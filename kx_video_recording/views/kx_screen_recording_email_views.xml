<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kx_screen_recording_email_wizard_view_form" model="ir.ui.view">
        <field name="name">kx.screen.recording.email.wizard.form</field>
        <field name="model">kx.screen.recording.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Email recording">
                <div class="alert alert-info mb-0" role="status">
                    Recipients receive a <strong>watch link</strong> in the email (no video attachment).
                    If auto-delete is enabled, the expiry notice is included automatically.
                </div>
                <group>
                    <field name="recording_id" readonly="1"/>
                    <field name="email_to" placeholder="client@example.com, partner@company.com"/>
                    <field name="subject"/>
                    <field name="body" widget="html"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show portal card pictograms without requiring Website → Customize → Use Pictograms -->
    <template id="portal_docs_entry_show_icon" name="Portal docs entry: always show icon"
              inherit_id="portal.portal_docs_entry" priority="99">
        <xpath expr="//div[hasclass('o_portal_icon')]" position="attributes">
            <attribute name="class">o_portal_icon d-block align-self-start</attribute>
        </xpath>
    </template>

    <template id="portal_my_home_screen_recordings" name="Portal My Home: Screen recordings"
              inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/kx_video_recording/static/src/img/screen_recording.svg'"/>
                <t t-set="title">Screen Recordings</t>
                <t t-set="text">Watch and download screen recordings shared with you</t>
                <t t-set="url" t-value="'/my/screen_recordings'"/>
                <t t-set="placeholder_count" t-value="'recording_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_home_menu_screen_recordings" name="Portal layout: screen recordings menu"
              inherit_id="portal.portal_breadcrumbs" priority="50">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'screen_recordings'" class="breadcrumb-item active">
                Screen Recordings
            </li>
        </xpath>
    </template>

    <template id="portal_screen_recording_row_actions" name="Portal recording actions">
        <a t-att-href="rec['watch_url']" class="btn btn-sm btn-primary me-1"
           target="_blank" rel="noopener">
            <i class="fa fa-play me-1"/>Watch
        </a>
        <a t-if="rec.get('download_url')" t-att-href="rec['download_url']"
           class="btn btn-sm btn-outline-secondary">
            <i class="fa fa-download me-1"/>Download
        </a>
    </template>

    <template id="portal_screen_recordings" name="Portal Screen Recordings">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Screen Recordings</t>
            </t>
            <div class="o_portal_wrap mt-3 o_kx_portal_recordings o_kx_view_kanban">
                <p class="text-muted mb-4" t-if="not recordings">
                    No screen recordings are available for your account.
                </p>
                <t t-if="recordings">
                    <div class="d-flex justify-content-end mb-3 o_kx_view_switcher" role="group"
                         aria-label="View mode">
                        <div class="btn-group">
                            <button type="button" class="btn btn-light o_kx_view_btn active"
                                    data-view="kanban" aria-pressed="true" title="Cards">
                                <i class="fa fa-th-large"/>
                            </button>
                            <button type="button" class="btn btn-light o_kx_view_btn"
                                    data-view="list" aria-pressed="false" title="List">
                                <i class="fa fa-list"/>
                            </button>
                        </div>
                    </div>

                    <div class="o_kx_recording_kanban">
                        <div class="row g-3">
                            <div class="col-12 col-lg-6" t-foreach="recordings" t-as="rec">
                                <div class="card h-100 shadow-sm border-0 bg-100">
                                    <div class="card-body">
                                        <div class="d-flex align-items-start gap-2 mb-3">
                                            <img src="/kx_video_recording/static/src/img/screen_recording.svg"
                                                 alt="" class="flex-shrink-0" width="40" height="40"/>
                                            <div class="flex-grow-1 min-w-0">
                                                <h5 class="card-title mb-1 text-truncate" t-esc="rec['name']"/>
                                                <p class="text-muted small mb-0"
                                                   t-if="rec.get('linked_document_name')">
                                                    <i class="fa fa-link me-1"/>
                                                    <span t-esc="rec['linked_document_name']"/>
                                                </p>
                                            </div>
                                        </div>
                                        <dl class="row g-2 mb-0 small">
                                            <dt class="col-sm-4 col-5 text-muted mb-0">Recorded by</dt>
                                            <dd class="col-sm-8 col-7 mb-0 fw-medium"
                                                t-esc="rec['recorded_by_name']"/>
                                            <dt class="col-sm-4 col-5 text-muted mb-0">Recorded on</dt>
                                            <dd class="col-sm-8 col-7 mb-0"
                                                t-esc="rec['recorded_at_display']"/>
                                            <dt class="col-sm-4 col-5 text-muted mb-0">Duration</dt>
                                            <dd class="col-sm-8 col-7 mb-0">
                                                <i class="fa fa-clock-o me-1 text-muted"/>
                                                <span t-esc="rec['duration_display']"/>
                                            </dd>
                                            <dt class="col-sm-4 col-5 text-muted mb-0">File size</dt>
                                            <dd class="col-sm-8 col-7 mb-0"
                                                t-esc="rec['file_size_display']"/>
                                            <dt class="col-sm-4 col-5 text-muted mb-0">Expires on</dt>
                                            <dd class="col-sm-8 col-7 mb-0">
                                                <t t-if="rec.get('has_expiry')">
                                                    <span class="badge text-bg-warning text-dark"
                                                          t-esc="rec['expires_on_display']"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="text-muted">—</span>
                                                </t>
                                                <div class="text-muted mt-1" style="font-size: 0.85em;"
                                                     t-esc="rec['expires_note']"/>
                                            </dd>
                                        </dl>
                                    </div>
                                    <div class="card-footer bg-transparent border-top d-flex flex-wrap gap-2">
                                        <t t-call="kx_video_recording.portal_screen_recording_row_actions"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_kx_recording_list">
                        <div class="table-responsive">
                            <table class="table table-hover o_portal_my_doc_table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Recorded by</th>
                                        <th>Recorded on</th>
                                        <th>Duration</th>
                                        <th>File size</th>
                                        <th>Linked to</th>
                                        <th>Expires on</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="recordings" t-as="rec">
                                        <td>
                                            <span class="fw-medium" t-esc="rec['name']"/>
                                        </td>
                                        <td t-esc="rec['recorded_by_name']"/>
                                        <td t-esc="rec['recorded_at_display']"/>
                                        <td t-esc="rec['duration_display']"/>
                                        <td t-esc="rec['file_size_display']"/>
                                        <td>
                                            <span t-if="rec.get('linked_document_name')"
                                                  t-esc="rec['linked_document_name']"/>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                        <td>
                                            <t t-if="rec.get('has_expiry')">
                                                <span t-esc="rec['expires_on_display']"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">—</span>
                                            </t>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <t t-call="kx_video_recording.portal_screen_recording_row_actions"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>

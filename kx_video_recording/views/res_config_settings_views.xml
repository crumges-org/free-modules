<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_kx_video_recording" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kx_video_recording</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='languages']" position="after">
                <div id="kx_video_recording_settings">
                    <block title="Screen recording" name="kx_video_recording_block">
                        <setting
                            string="Screen recording in chatter"
                            help="Record screen videos with microphone and system audio from the chatter. Recordings are stored as attachments and can be linked to documents."
                        >
                            <field name="kx_video_recording_active"/>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kx_screen_recording_share_wizard_view_form" model="ir.ui.view">
        <field name="name">kx.screen.recording.share.wizard.form</field>
        <field name="model">kx.screen.recording.share.wizard</field>
        <field name="arch" type="xml">
            <form string="Share recording">
                <group>
                    <field name="recording_id" readonly="1"/>
                    <field name="recording_owner_id" readonly="1" string="Recorded by"/>
                    <field name="user_ids" widget="many2many_tags"
                           string="Share with"
                           placeholder="Select users…"
                           options="{'no_create': True}"
                           force_save="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

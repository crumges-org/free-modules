<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="kx_video_recording.RecordingSystray">
        <Dropdown position="'bottom-end'" menuClass="'o-kx-recording-dropdown-menu p-0'" state="dropdown" beforeOpen.bind="onBeforeOpen">
            <button type="button"
                    class="o-kx-recording-systray-btn btn btn-link o_nav_entry px-2 d-flex align-items-center gap-1"
                    t-att-class="{'o-kx-recording-systray-btn--recording': isRecording, 'o-kx-recording-systray-btn--paused': isRecording and recState.isPaused}"
                    title="Screen recording"
                    aria-label="Screen recording">
                <span class="o-kx-recording-systray-icon-wrap position-relative d-flex align-items-center">
                    <i class="fa fa-desktop fa-lg o-kx-recording-systray-icon" role="img" aria-hidden="true"/>
                    <span t-if="isRecording" class="o-kx-recording-systray-dot" aria-hidden="true"/>
                </span>
                <span t-if="isRecording" t-key="uiTick.n"
                      class="o-kx-recording-systray-time">
                    <t t-esc="formatDuration(recState.duration)"/>
                </span>
            </button>

            <t t-set-slot="content">
                <div class="o-kx-recording-panel d-flex flex-column" style="width: 320px; max-width: 90vw;">
                    <div class="o-kx-recording-panel-header px-3 py-2 border-bottom fw-bold">
                        Screen recording
                    </div>

                    <div class="o-kx-recording-panel-body px-3 py-2 d-flex flex-column gap-2">
                        <p class="text-muted small mb-0" t-if="recState.phase === 'idle' or recState.phase === 'setup'">
                            Choose what to record. Recording starts as soon as you share — no extra confirm step.
                        </p>
                        <div t-if="(recState.phase === 'idle' or recState.phase === 'setup') and recState.formLink"
                             class="border rounded px-2 py-1 bg-light">
                            <label class="form-check mb-0 small">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="recState.linkToCurrentDocument"
                                       t-on-change="onToggleLinkDocument"/>
                                <span class="form-check-label">
                                    Link to <strong t-esc="recState.formLink.displayName"/>
                                </span>
                            </label>
                        </div>
                        <p class="text-muted small mb-0" t-if="recState.phase === 'picking' or recState.isStarting">
                            Starting recording…
                        </p>
                        <p class="text-muted small mb-0" t-if="recState.phase === 'ready'">
                            Preview below, then start recording.
                        </p>
                        <div t-if="recState.phase === 'preview'" class="d-flex flex-column gap-1">
                            <label class="form-label small mb-0">Recording name</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Screen recording"
                                   t-att-value="recState.recordingName"
                                   t-on-input="onRecordingNameInput"/>
                        </div>
                        <p class="text-muted small mb-0" t-if="recState.phase === 'recording'" t-key="uiTick.n">
                            <span class="text-danger fw-bold" t-if="!recState.isPaused">Recording</span>
                            <span class="text-warning fw-bold" t-else="">Paused</span>
                            <t t-esc="formatDuration(recState.duration)"/> — close this menu anytime; open it again or use the camera icon to stop.
                        </p>
                        <p class="text-success small mb-0" t-if="recState.phase === 'saved'">
                            <i class="fa fa-check-circle me-1"/>
                            <strong t-esc="recState.lastSaved?.name or 'Recording saved'"/>
                        </p>

                        <div t-if="recState.phase === 'idle' or recState.phase === 'setup'" class="d-flex flex-wrap gap-3">
                            <label class="form-check mb-0">
                                <input type="checkbox" class="form-check-input" t-att-checked="recState.includeMic" t-on-change="onToggleIncludeMic"/>
                                <span class="form-check-label">Microphone</span>
                            </label>
                            <label class="form-check mb-0">
                                <input type="checkbox" class="form-check-input" t-att-checked="recState.includeSystemAudio" t-on-change="onToggleIncludeSystemAudio"/>
                                <span class="form-check-label">System / tab audio</span>
                            </label>
                        </div>

                        <div t-if="recState.phase === 'idle' or recState.phase === 'setup'" class="d-flex flex-wrap align-items-center gap-2">
                            <label class="form-check mb-0">
                                <input type="checkbox" class="form-check-input"
                                       t-att-checked="recState.autoDelete"
                                       t-on-change="onToggleAutoDelete"/>
                                <span class="form-check-label small">Auto delete</span>
                            </label>
                            <select t-if="recState.autoDelete" t-key="'auto-delete-days-' + uiTick.n"
                                    class="form-select form-select-sm w-auto"
                                    t-att-value="recState.autoDeleteDays"
                                    t-on-change="onAutoDeleteDaysChange">
                                <option value="7">After 7 days</option>
                                <option value="14">After 14 days</option>
                                <option value="30">After 30 days</option>
                                <option value="60">After 60 days</option>
                                <option value="90">After 90 days</option>
                            </select>
                        </div>

                        <div t-if="showRecordingPlaceholder"
                             class="o-kx-recording-preview o-kx-recording-preview--recording ratio ratio-16x9 rounded overflow-hidden position-relative d-flex align-items-center justify-content-center p-3">
                            <p class="text-center text-white-50 small mb-0">
                                <i class="fa fa-circle text-danger me-1"/> Recording
                                <span class="fw-bold text-white ms-1" t-key="uiTick.n" t-esc="formatDuration(recState.duration)"/>
                                <br/>
                                <span class="opacity-75">Live preview is hidden while recording this tab. Share a window or another screen before recording to see a preview.</span>
                            </p>
                        </div>

                        <div t-if="showLivePreview" class="o-kx-recording-preview ratio ratio-16x9 bg-black rounded overflow-hidden position-relative">
                            <video t-ref="liveVideo" class="o-kx-recording-preview-video" muted="muted" playsinline="playsinline" autoplay="autoplay"
                                   t-att-class="{'d-none': recState.phase === 'preview'}"/>
                            <video t-ref="playbackVideo" class="o-kx-recording-preview-video" controls="controls" playsinline="playsinline"
                                   t-att-class="{'d-none': recState.phase !== 'preview'}"/>
                        </div>

                        <p t-if="recState.error" class="text-danger small mb-0" t-esc="recState.error"/>
                    </div>

                    <div class="o-kx-recording-panel-footer px-3 py-2 border-top d-flex flex-wrap gap-2 justify-content-end">
                        <t t-if="recState.phase === 'idle' or recState.phase === 'setup'">
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="onCancel">Close</button>
                            <button type="button" class="btn btn-sm btn-primary" t-on-click="onRecordCurrentTab">
                                <i class="fa fa-play-circle me-1"/> Record this tab
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="onPickOtherScreen">
                                <i class="fa fa-desktop me-1"/> Other screen / tab
                            </button>
                        </t>
                        <t t-if="recState.phase === 'picking' or recState.isStarting">
                            <button type="button" class="btn btn-sm btn-secondary" disabled="disabled">Starting…</button>
                        </t>
                        <t t-if="recState.phase === 'ready'">
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="onCancel">Cancel</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onChangeScreen">Change</button>
                            <button type="button" class="btn btn-sm btn-danger" t-on-click="onStartRecording"
                                    t-att-disabled="recState.isStarting ? 'disabled' : false">
                                <t t-if="recState.isStarting">Starting…</t>
                                <t t-else=""><i class="fa fa-circle me-1"/> Record</t>
                            </button>
                        </t>
                        <t t-if="recState.phase === 'recording'">
                            <button t-if="supportsPause and !recState.isPaused" type="button"
                                    class="btn btn-sm btn-outline-secondary" t-on-click="onPauseRecording">
                                <i class="fa fa-pause me-1"/> Pause
                            </button>
                            <button t-if="supportsPause and recState.isPaused" type="button"
                                    class="btn btn-sm btn-outline-primary" t-on-click="onResumeRecording">
                                <i class="fa fa-play me-1"/> Resume
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" t-on-click="onStopRecording">Stop</button>
                        </t>
                        <t t-if="recState.phase === 'preview'">
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="onDiscardPreview">Again</button>
                            <button type="button" class="btn btn-sm btn-primary" t-on-click="onSave">Save</button>
                        </t>
                        <t t-if="recState.phase === 'saving'">
                            <button type="button" class="btn btn-sm btn-primary" disabled="disabled">Saving…</button>
                        </t>
                        <t t-if="recState.phase === 'saved'" t-key="'saved-footer-' + uiTick.n">
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="onDismissSaved">Close</button>
                            <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="onNewRecording">
                                <i class="fa fa-video-camera me-1"/> Record again
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onDownloadSaved">
                                <i class="fa fa-download me-1"/> Download
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="onEmailSaved">
                                <i class="fa fa-envelope me-1"/> Email
                            </button>
                            <button type="button" class="btn btn-sm btn-primary" t-on-click="onViewSaved">
                                <i class="fa fa-play me-1"/> View recording
                            </button>
                        </t>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>

</templates>

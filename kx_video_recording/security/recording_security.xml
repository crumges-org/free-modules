<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_kx_screen_recording_user_read" model="ir.rule">
        <field name="name">Screen recording: user read own and shared</field>
        <field name="model_id" ref="model_kx_screen_recording"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('share_ids.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_recording_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_kx_screen_recording_user_write_own" model="ir.rule">
        <field name="name">Screen recording: user write own</field>
        <field name="model_id" ref="model_kx_screen_recording"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_recording_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_kx_screen_recording_manager" model="ir.rule">
        <field name="name">Screen recording: manager company</field>
        <field name="model_id" ref="model_kx_screen_recording"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_recording_manager'))]"/>
    </record>

    <record id="rule_kx_screen_recording_share_user_write" model="ir.rule">
        <field name="name">Screen recording share: owner may share</field>
        <field name="model_id" ref="model_kx_screen_recording_share"/>
        <field name="domain_force">[('recording_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_recording_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_kx_screen_recording_share_user" model="ir.rule">
        <field name="name">Screen recording share: user via recording</field>
        <field name="model_id" ref="model_kx_screen_recording_share"/>
        <field name="domain_force">[
            '|',
            ('recording_id.user_id', '=', user.id),
            ('user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_recording_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_kx_screen_recording_share_manager" model="ir.rule">
        <field name="name">Screen recording share: manager company</field>
        <field name="model_id" ref="model_kx_screen_recording_share"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_recording_manager'))]"/>
    </record>

    <record id="rule_kx_screen_recording_log_user" model="ir.rule">
        <field name="name">Screen recording log: user via recording</field>
        <field name="model_id" ref="model_kx_screen_recording_log"/>
        <field name="domain_force">[
            '|',
            ('recording_id.user_id', '=', user.id),
            ('recording_id.share_ids.user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_recording_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_kx_screen_recording_portal_read" model="ir.rule">
        <field name="name">Screen recording: portal read</field>
        <field name="model_id" ref="model_kx_screen_recording"/>
        <field name="domain_force">[
            '|',
            ('share_ids.user_id', '=', user.id),
            ('user_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_kx_screen_recording_log_manager" model="ir.rule">
        <field name="name">Screen recording log: manager company</field>
        <field name="model_id" ref="model_kx_screen_recording_log"/>
        <field name="domain_force">[('recording_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_recording_manager'))]"/>
    </record>

</odoo>

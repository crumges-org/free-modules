<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="nube_view_solt_api_connector_kanban_inherit" model="ir.ui.view">
            <field name="name">nube.connector.order.kanban.inherit</field>
            <field name="model">solt.api.connector</field>
            <field name="inherit_id" ref="solt_api_connector.view_solt_api_connector_kanban"/>
            <field name="arch" type="xml">
                <field name="active" position="after">
                    <field name="orders_count"/>
                    <field name="orders_today_count"/>
                </field>
                <xpath expr="//t[@t-set='module_name']" position="attributes">
                    <attribute name="t-value">'solt_tiendanube'</attribute>
                </xpath>

                <xpath expr="//div[@id='orders_info']/a" position="replace">
                    <a class="hoverable-card d-block pt-2 pb-2 text-black" href="#">
                        <span class="h2 d-block">
                            <field name="orders_today_count" /> / <field name="orders_count" />
                        </span>
                        last 24h / total orders
                    </a>
                </xpath>
            </field>
        </record>

        <record id="nube_view_solt_api_connector_form_inherit" model="ir.ui.view">
            <field name="name">nube.connector.form.inherit</field>
            <field name="model">solt.api.connector</field>
            <field name="inherit_id" ref="solt_api_connector.view_solt_api_connector_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='active']" position="after">
                    <field name="show_button_wh_tn" invisible="True"/>
                </xpath>

                <xpath expr="//button[@name='action_all_inactive']" position="after">
                    <button name="action_create_tn_webhooks" string="Create Tiendanube Webhook" type="object"
                            class="btn-secondary"
                            invisible="not show_button_wh_tn"
                            confirm="The action will create all Tiendanube Webhooks. Do you want to continue?"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>

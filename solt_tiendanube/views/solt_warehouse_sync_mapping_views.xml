<odoo>
    <data>
        <record id="solt_warehouse_sync_mapping_view_list" model="ir.ui.view">
            <field name="name">solt.warehouse.sync.mapping.view.list</field>
            <field name="model">solt.warehouse.sync.mapping</field>
            <field name="arch" type="xml">
                <list string="Warehouse Sync Mapper" create="0" delete="0" editable="bottom">
                    <field name="tn_name"/>
                    <field name="warehouse_id" options="{'no_create': True}" readonly="is_synchronized"/>
                    <field name="company_id" readonly="True" optional="hide"/>
                    <field name="is_synchronized" column_invisible="True"/>
                    <field name="response_body" column_invisible="True"/>
                    <field name="response_mapping" column_invisible="True"/>
                    <button name="action_sync_warehouse" icon="fa-exchange fa-2x" type="object"
                            string="Sync"
                            invisible="is_synchronized or not warehouse_id"
                            confirm="The action will sync the warehouse. Do you want to continue?"
                    />
                    <button name="action_create_warehouse" icon="fa-plus-square fa-2x" type="object"
                            string="Create"
                            invisible="warehouse_id"
                            confirm="The action will create and sync the warehouse. Do you want to continue?"
                    />
                </list>
            </field>
        </record>

        <record id="tnube_menu_solt_sync_mapping_view_action" model="ir.actions.act_window">
            <field name="name">Warehouse Sync Mapper</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solt.warehouse.sync.mapping</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>

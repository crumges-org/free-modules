<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_normal_form_view_categies_inherit" model="ir.ui.view">
        <field name="name">product.product.categories.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_only_form_view_categies_inherit" model="ir.ui.view">
        <field name="name">product.template.only.categies.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>


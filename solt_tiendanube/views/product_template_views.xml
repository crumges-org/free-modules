<odoo>
    <data>
        <!-- Inherit Form View to Modify it -->
        <record id="nube_product_template_form_inherit" model="ir.ui.view">
            <field name="name">nube.product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <notebook position="inside">
                    <page name="integration_nube_page" string="Tiendanube Integration">
                        <group>
                            <group string="SEO">
                                <field name="website_seo_metatitle"/>
                                <field name="website_seo_description"/>
                            </group>
                            <group string="Other Information">
                                <field name="is_published"/>
                                <field name="promotional_price" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                                <field name="nube_video_url"/>
                            </group>
                        </group>
                        <group string="Dimensions" invisible="type not in ['consu', 'combo'] or product_variant_count &gt; 1 and not is_product_variant">
                            <label for="product_height" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                            <div class="o_row" name="product_height"
                                 invisible="product_variant_count &gt; 1 and not is_product_variant">
                                <field name="product_height" class="oe_inline"/>
                                <field name="product_height_uom_name"/>
                            </div>
                            <label for="product_width" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                            <div class="o_row" name="product_width"
                                 invisible="product_variant_count &gt; 1 and not is_product_variant">
                                <field name="product_width" string="Width" class="oe_inline"/>
                                <field name="product_width_uom_name"/>
                            </div>
                            <label for="product_depth" invisible="product_variant_count &gt; 1 and not is_product_variant"/>
                            <div class="o_row" name="product_depth"
                                 invisible="product_variant_count &gt; 1 and not is_product_variant">
                                <field name="product_depth" string="Depth" class="oe_inline"/>
                                <field name="product_depth_uom_name"/>
                            </div>
                        </group>
                        <group string="Description">
                            <field name="website_description" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Shipping">
                            <group>
                                <field name="nube_free_shipping"/>
                            </group>
                            <group>
                                <field name="nube_requires_shipping"/>
                            </group>
                        </group>
                        <group name="product_image_ids" string="Extra Images" col="4" invisible="is_product_variant or not id">
                            <field name="product_image_ids" colspan="2" mode="kanban"
                                   class="o_website_sale_image_list" context="{'default_name': name}"
                                   options="{'create_text':'Add image'}" nolabel="1"/>
                        </group>

                    </page>
                </notebook>

                <header position="inside">
                    <button string="Sync Cost" type="object"
                            name="action_sync_cost"
                            invisible="not company_id or product_variant_count &gt; 1 and not is_product_variant"
                            confirm="This action will sync the product cost in the store. Do you want to continue?"/>
                    <button name="action_migrate_images" string="Migrate Images"
                            type="object" class="btn-secondary"
                            invisible="not image_1920 or is_product_variant"
                            groups="solt_tiendanube.group_migrate_image"/>
                </header>

            </field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="nube_product_variant_easy_edit_view_inherit" model="ir.ui.view">
            <field name="name">nube.product.product.view.form.easy.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page name="integration_nube_page_easy" string="Tiendanube Integration">
                            <group>
                                <group string="Dimensions"
                                       invisible="type not in ['consu', 'combo']">
                                    <label for="product_height"/>
                                    <div class="o_row" name="product_height">
                                        <field name="product_height" class="oe_inline"/>
                                        <span><field name="product_height_uom_name"/></span>
                                    </div>
                                    <label for="product_width"/>
                                    <div class="o_row" name="product_width">
                                        <field name="product_width" string="Width" class="oe_inline"/>
                                        <span><field name="product_width_uom_name"/></span>
                                    </div>
                                    <label for="product_depth"/>
                                    <div class="o_row" name="product_depth">
                                        <field name="product_depth" string="Depth" class="oe_inline"/>
                                        <span><field name="product_depth_uom_name"/></span>
                                    </div>
                                </group>
                                <group string="Other Information">
                                    <field name="promotional_price"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
                <xpath expr="//button[@name='action_open_label_layout']" position="after">
                    <button string="Sync Cost" type="object"
                            name="action_sync_cost"
                            invisible="not company_id or product_variant_count &gt; 1 and not is_product_variant"
                            confirm="This action will sync the product cost in the store. Do you want to continue?"/>
                </xpath>
            </field>
        </record>

        <record id="model_variant_action_sync_cost" model="ir.actions.server">
            <field name="name">Sync Cost</field>
            <field name="model_id" ref="product.model_product_product"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_sync_cost()</field>
        </record>

        <!-- Inherit Form View to Modify it -->
        <record id="categ_domain_product_template_only_form_view_categies_inherit" model="ir.ui.view">
            <field name="name">categ.domain.product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product_template_only_form_view_categies_inherit"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='categ_ids']" position="after">
                    <field name="categ_ids_domain" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='categ_ids']" position="attributes">
                    <attribute name="domain">categ_ids_domain</attribute>
                </xpath>

            </field>
        </record>

        <!-- Acción de servidor para productos seleccionados -->
        <record id="action_server_migrate_product_images" model="ir.actions.server">
            <field name="name">Migrate Images to Product Image</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups_id" eval="[(4, ref('solt_tiendanube.group_migrate_image'))]"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_migrate_images()
            </field>
        </record>
    </data>
</odoo>

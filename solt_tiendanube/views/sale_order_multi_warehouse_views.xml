<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_sale_stock_inherit_multi_warehouse" model="ir.ui.view">
            <field name="name">multi.warehouse.sale.order.view.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale_shipping']//field[@name='warehouse_id']" position="after">
                    <field name="can_use_sale_multi_stock" invisible="1"/>
                    <field name="warehouse_ids" invisible="not can_use_sale_multi_stock" options="{'no_create': True}"
                           widget="many2many_tags" required="can_use_sale_multi_stock"
                           force_save="1" readonly="state == 'sale'"/>
                </xpath>
                <xpath expr="//group[@name='sale_shipping']//field[@name='warehouse_id'][2]" position="attributes">
                    <attribute name="invisible">can_use_sale_multi_stock</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='analytic_distribution']" position="before">
                    <field name="warehouse_ids" column_invisible="True"/>
                    <field name="warehouse_id_domain" column_invisible="True"/>
                    <field name="product_type" column_invisible="True"/>
                    <field name="product_is_storable" column_invisible="True"/>
                    <field name="multi_warehouse_id" optional="hide" domain="warehouse_id_domain" required="parent.can_use_sale_multi_stock and product_is_storable"
                           options="{'no_create': True}" column_invisible="not parent.can_use_sale_multi_stock"
                           readonly="0" invisible="not product_is_storable" force_save="1"/>
                </xpath>

                <xpath expr="//field[@name='order_line']/list/field[@name='analytic_distribution']" position="before">
                    <field name="commitment_date" optional="hide" required="parent.can_use_sale_multi_stock and product_is_storable"
                           column_invisible="not parent.can_use_sale_multi_stock"
                           />
                </xpath>
            </field>
        </record>
    </data>
</odoo>


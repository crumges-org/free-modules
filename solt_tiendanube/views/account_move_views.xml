<odoo>
    <data>
        <record id="nube_account_move_form_inherit" model="ir.ui.view">
            <field name="name">nube.account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="integration_page" string="Tiendanube Integration"
                    invisible="move_type != 'out_invoice'">
                        <group>
                            <field name="payment_method_id" readonly="1" force_save="1"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>

<odoo>
    <data>
      <!-- Inherit Form View to Modify it -->
      <record id="nube_product_category_form_inherit" model="ir.ui.view">
          <field name="name">nube.product.category.form.inherit</field>
          <field name="model">product.category</field>
          <field name="inherit_id" ref="product.product_category_form_view"/>
          <field name="arch" type="xml">
              <xpath expr="//sheet" position="inside">
                  <notebook>
                      <page name="integration_page" string="Tiendanube Integration">
                          <group string="SEO">
                                <field name="nube_seo_title"/>
                                <field name="nube_seo_description"/>
                            </group>
                          <group string="Google Shopping">
                              <field name="nube_google_shopping_category" nolabel="1" colspan="2"/>
                          </group>

                          <group string="Description">
                              <field name="nube_description" nolabel="1" colspan="2"/>
                          </group>
                      </page>
                  </notebook>
              </xpath>
          </field>
      </record>
    </data>
</odoo>

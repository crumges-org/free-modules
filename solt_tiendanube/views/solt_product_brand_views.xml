<odoo>
    <data>
        <!--   solt.product.brand views and actions   -->
        <record id="action_open_related_brand_products" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,form,list</field>
            <field name="domain">[('product_brand_id', '=', active_id)]</field>
        </record>

        <record id="product_brand_search_view" model="ir.ui.view">
            <field name="name">solt.product.brand.search.form</field>
            <field name="model">solt.product.brand</field>
            <field name="arch" type="xml">
                <search string="Product Brand">
                    <field name="name"/>
                    <field name="product_ids" string="Product" filter_domain="[('product_ids', 'ilike', self)]"/>
                    <separator/>
                    <group expand="1" string="Group By">
                    <filter string="Company" name="company_group" context="{'group_by':'company_id'}"/>
                </group>
                </search>
            </field>
        </record>

        <record id="view_product_brand_tree" model="ir.ui.view">
            <field name="name">solt.product.brand.list</field>
            <field name="model">solt.product.brand</field>
            <field name="arch" type="xml">
                <list string="Product Brand">
                    <field name="name"/>
                    <field name="description" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="view_product_brand_form" model="ir.ui.view">
            <field name="name">solt.product.brand.form</field>
            <field name="model">solt.product.brand</field>
            <field name="arch" type="xml">
                <form string="Product Brand">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button
                                    name="%(action_open_related_brand_products)d"
                                    type="action"
                                    class="oe_stat_button"
                                    icon="fa-th-list"
                                    context="{'default_product_brand_id': id}"
                            >
                                <field
                                        name="products_count"
                                        widget="statinfo"
                                        string="Products"
                                />
                            </button>
                        </div>
                        <field name="company_id" invisible="1"/>
                        <field name="image_1920" widget="image" class="oe_avatar"
                               options="{'preview_image': 'image_128'}"/>
                        <div class="oe_title">
                            <label for="name" string="Name"/>
                            <h1>
                                <div class="d-flex">
                                <field name="name" placeholder="e.g. Lenovo"/>
                            </div>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"
                                        options="{'no_create': True}"/>
                            </group>
                        </group>
                        <field name="description" string="Description"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_product_brand_kanban" model="ir.ui.view">
            <field name="name">solt.product.brand.kanban</field>
            <field name="model">solt.product.brand</field>
            <field name="arch" type="xml">
                <kanban string="Product Brand">
                    <field name="id"/>
                    <field name="image_128"/>
                    <field name="products_count"/>
                    <field name="description"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img
                                            t-att-src="kanban_image('solt.product.brand', 'image_128', record.id.raw_value)"
                                            alt="Marca" class="o_image_64_contain"
                                    />
                                </div>
                                <div class="oe_kanban_details">
                                    <h4>
                                        <field name="name"/>
                                    </h4>
                                    <div>
                                        <a
                                                name="%(action_open_related_brand_products)d"
                                                type="action"
                                        >
                                            <t t-esc="record.products_count.value"/>
                                            Products
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_product_brand">
            <field name="name">Brand</field>
            <field name="res_model">solt.product.brand</field>
            <field name="view_mode">kanban,form,list</field>
        </record>

        <!-- product.template -->
        <record id="view_product_template_search_brand_inherit" model="ir.ui.view">
            <field name="name">product.template.search.brand.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_search_view"/>
            <field name="arch" type="xml">
                <field name="categ_id" position="after">
                    <field name="product_brand_id"/>
                </field>
                <filter name="categ_id" position="after">
                    <filter string="Brand" name="groupby_brand" context="{'group_by' : 'product_brand_id'}"
                    />
                </filter>

            </field>
        </record>

        <record id="view_product_template_tree_brand_inherit" model="ir.ui.view">
            <field name="name">product.template.brand.list.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_tree_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="product_brand_id" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="view_product_template_kanban_brand_inherit" model="ir.ui.view">
            <field name="name">product.tempalte.brand.kanban.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_properties']" position="before">
                    <br t-if="record.product_brand_id"/>
                    <span name="product_brand" t-if="record.product_brand_id">
                        Brand: <field name="product_brand_id"/>
                    </span>
                </xpath>
            </field>
        </record>

        <record id="product_template_form_brand_inherit" model="ir.ui.view">
            <field name="name">product.template.brand.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <group name="group_general" position="inside">
                    <field name="product_brand_id" placeholder="Brand" options="{'no_create': False}"/>
                </group>
            </field>
        </record>

        <!-- product.product -->
        <record id="view_product_product_kanban_brand_inherit" model="ir.ui.view">
            <field name="name">product.product.brand.kanban.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//main[hasclass('col-10', 'pe-2')]" position="inside">
                    <br t-if="record.product_brand_id"/>
                    <span t-if="record.product_brand_id">
                        Brand: <field name="product_brand_id"/>
                    </span>
                </xpath>
            </field>
        </record>
        <record id="view_product_product_tree_brand_inherit" model="ir.ui.view">
            <field name="name">product.product.brand.list.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="product_brand_id" optional="hide"/>
                </field>
            </field>
        </record>

    </data>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Multi - Company Rules -->
    <record id="solt_register_webhook_comp_rule" model="ir.rule">
        <field name="name">Register Webhooks multi-company</field>
        <field name="model_id" ref="model_solt_register_webhook"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="solt_warehouse_sync_mapping_comp_rule" model="ir.rule">
        <field name="name">Warehouse Sync Mapper multi-company</field>
        <field name="model_id" ref="model_solt_warehouse_sync_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="product_multicompany_brand_rule" model="ir.rule">
        <field name="name">Regla: Marca de producto multiempresa</field>
        <field name="model_id" ref="model_solt_product_brand"/>
        <field name="domain_force"> ['|', ('company_id', 'parent_of', company_ids), ('company_id', '=', False)]</field>
    </record>

</odoo>

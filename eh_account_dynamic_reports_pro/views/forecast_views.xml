<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_eh_report_forecast_tree" model="ir.ui.view">
        <field name="name">eh.report.forecast.list</field>
        <field name="model">eh.report.forecast</field>
        <field name="arch" type="xml">
            <tree string="Forecast Scenarios" sample="1">
                <field name="name"/>
                <field name="base_report_id"/>
                <field name="scenario_label"/>
                <field name="growth_method"/>
                <field name="monthly_growth_pct"/>
                <field name="horizon_months"/>
                <field name="last_run"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_report_forecast_form" model="ir.ui.view">
        <field name="name">eh.report.forecast.form</field>
        <field name="model">eh.report.forecast</field>
        <field name="arch" type="xml">
            <form string="Forecast Scenario">
                <field name="company_id" invisible="1"/><header>
                    <button name="action_project_now" type="object" string="Run Projection" class="btn-primary"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" placeholder="2026 Optimistic Case"/>
                    </h1>
                    <group>
                        <group string="Base Period">
                            <field name="base_report_id" domain="[('handler_model', 'in', ['eh.account.dynamic.report.handler.profit_and_loss', 'eh.account.dynamic.report.handler.balance_sheet', 'eh.account.dynamic.report.handler.cash_flow', 'eh.account.dynamic.report.handler.executive_summary', 'eh.account.dynamic.report.handler.builder']), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                            <field name="base_date_from"/>
                            <field name="base_date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Projection">
                            <field name="scenario_label"/>
                            <field name="horizon_months"/>
                            <field name="growth_method"/>
                            <field name="monthly_growth_pct" invisible="growth_method != 'compound'"/>
                            <field name="last_run" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_report_forecast_search" model="ir.ui.view">
        <field name="name">eh.report.forecast.search</field>
        <field name="model">eh.report.forecast</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="base_report_id"/>
                <field name="scenario_label"/>
                <filter name="filter_method_flat" string="Flat Growth" domain="[('growth_method', '=', 'flat')]"/>
                <filter name="filter_method_compound" string="Compound Growth" domain="[('growth_method', '=', 'compound')]"/>
                <group>
                    <filter name="group_base_report" string="Base Report" context="{'group_by': 'base_report_id'}"/>
                    <filter name="group_growth_method" string="Growth Method" context="{'group_by': 'growth_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eh_report_forecast_result_form" model="ir.ui.view">
        <field name="name">eh.report.forecast.result.form</field>
        <field name="model">eh.report.forecast.result</field>
        <field name="arch" type="xml">
            <form string="Forecast Result" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="forecast_id"/>
                        <field name="summary" nolabel="1"/>
                        <field name="filename" invisible="1"/>
                        <field name="file_data" filename="filename"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_eh_report_forecast" model="ir.actions.act_window">
        <field name="name">Forecast Scenarios</field>
        <field name="res_model">eh.report.forecast</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_eh_report_forecast_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No forecast scenarios yet.</p>
            <p>A forecast uses one complete calendar month from a bounded aggregate report, then projects future calendar months. Growth applies only to current monetary values; historical comparisons, percentages, ratios, day counts, and other measures remain unchanged.</p>
        </field>
    </record>

</odoo>
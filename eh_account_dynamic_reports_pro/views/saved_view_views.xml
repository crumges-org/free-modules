<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_eh_report_saved_view_tree" model="ir.ui.view">
        <field name="name">eh.account.report.saved_view.pro.list</field>
        <field name="model">eh.account.report.saved_view</field>
        <field name="arch" type="xml">
            <tree string="Saved Views" default_order="pinned desc, sequence, name" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="pinned" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="report_code"/>
                <field name="user_id"/>
                <field name="shared" widget="boolean_toggle"/>
                <field name="use_count"/>
                <field name="last_used_at"/>
            </tree>
        </field>
    </record>

    <record id="view_eh_report_saved_view_form" model="ir.ui.view">
        <field name="name">eh.account.report.saved_view.pro.form</field>
        <field name="model">eh.account.report.saved_view</field>
        <field name="arch" type="xml">
            <form string="Saved View">
                <field name="company_id" invisible="1"/><sheet>
                    <h1>
                        <field name="name" placeholder="Saved view name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="report_code"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="pinned"/>
                            <field name="shared"/>
                            <field name="sequence"/>
                            <field name="use_count" readonly="1"/>
                            <field name="last_used_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Period">
                            <group>
                                <field name="period_preset"/>
                                <field name="period_date_from" invisible="period_preset != 'custom'" required="period_preset == 'custom'"/>
                                <field name="period_date_to" invisible="period_preset != 'custom'" required="period_preset == 'custom'"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Optional description"/>
                        </page>
                        <page string="Advanced Options">
                            <field name="options_json" widget="text"/>
                            <p class="text-muted">
                                Validated JSON for advanced dimensions and filters. Period fields override only its date block.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_report_saved_view_search" model="ir.ui.view">
        <field name="name">eh.account.report.saved_view.pro.search</field>
        <field name="model">eh.account.report.saved_view</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="report_code"/>
                <field name="user_id"/>
                <filter name="filter_pinned" string="Pinned" domain="[('pinned', '=', True)]"/>
                <filter name="filter_shared" string="Shared" domain="[('shared', '=', True)]"/>
                <group>
                    <filter name="group_report" string="Report" context="{'group_by': 'report_code'}"/>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_report_saved_view" model="ir.actions.act_window">
        <field name="name">Saved Views</field>
        <field name="res_model">eh.account.report.saved_view</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_eh_report_saved_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No saved views yet.</p>
            <p>Save a filter set inside the report viewer to capture date ranges, company scope, and toggles. Pin frequently used views or share them with your team.</p>
        </field>
    </record>

</odoo>
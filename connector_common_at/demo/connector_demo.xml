<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Demo Connector Instance -->
        <record id="demo_connector_instance" model="connector.instance">
            <field name="name">Demo WooCommerce Instance</field>
            <field name="platform_type">woocommerce</field>
            <field name="api_url">https://demo.woocommerce.com</field>
            <field name="api_key">demo_key</field>
            <field name="is_active">True</field>
            <field name="sync_enabled">True</field>
        </record>

        <!-- Demo Background Job -->
        <record id="demo_background_job" model="connector.background.processor">
            <field name="name">Demo Sync Job</field>
            <field name="job_type">sync_products</field>
            <field name="instance_id" ref="demo_connector_instance"/>
            <field name="method_name">_demo_sync_method</field>
            <field name="priority">normal</field>
            <field name="state">done</field>
            <field name="progress">100.0</field>
        </record>

        <!-- Demo Connector Log -->
        <record id="demo_connector_log" model="connector.log">
            <field name="instance_id" ref="demo_connector_instance"/>
            <field name="level">info</field>
            <field name="message">Demo log entry</field>
            <field name="operation">general</field>
        </record>
    </odoo>

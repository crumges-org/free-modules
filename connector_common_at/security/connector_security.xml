<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Connector Common Security Groups -->
    <!-- Odoo 19: category_id and comment removed from res.groups -->
        <record id="group_connector_user" model="res.groups">
            <field name="name">Connector User</field>
        </record>

        <record id="group_connector_manager" model="res.groups">
            <field name="name">Connector Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_connector_user'))]"/>
        </record>

        <record id="group_connector_admin" model="res.groups">
            <field name="name">Connector Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_connector_manager'))]"/>
        </record>

        <!-- Connector Instance Security Rules -->
        <record id="connector_instance_rule_user" model="ir.rule">
            <field name="name">Connector Instance: User Access</field>
            <field name="model_id" ref="model_connector_instance"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_connector_user'))]"/>
        </record>

        <record id="connector_instance_rule_manager" model="ir.rule">
            <field name="name">Connector Instance: Manager Access</field>
            <field name="model_id" ref="model_connector_instance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_connector_manager'))]"/>
        </record>

        <!-- Background Processor Security Rules -->
        <record id="background_processor_rule_user" model="ir.rule">
            <field name="name">Background Processor: User Access</field>
            <field name="model_id" ref="model_connector_background_processor"/>
            <field name="domain_force">[('instance_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_connector_user'))]"/>
        </record>

        <record id="background_processor_rule_manager" model="ir.rule">
            <field name="name">Background Processor: Manager Access</field>
            <field name="model_id" ref="model_connector_background_processor"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_connector_manager'))]"/>
        </record>

        <!-- Connector Queue Security Rules -->
        <record id="connector_queue_rule_user" model="ir.rule">
            <field name="name">Connector Queue: User Access</field>
            <field name="model_id" ref="model_connector_queue"/>
            <field name="domain_force">[('instance_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_connector_user'))]"/>
        </record>

        <record id="connector_queue_rule_manager" model="ir.rule">
            <field name="name">Connector Queue: Manager Access</field>
            <field name="model_id" ref="model_connector_queue"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_connector_manager'))]"/>
        </record>

        <!-- Connector Log Security Rules -->
        <record id="connector_log_rule_user" model="ir.rule">
            <field name="name">Connector Log: User Access</field>
            <field name="model_id" ref="model_connector_log"/>
            <field name="domain_force">[('instance_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_connector_user'))]"/>
        </record>

        <record id="connector_log_rule_manager" model="ir.rule">
            <field name="name">Connector Log: Manager Access</field>
            <field name="model_id" ref="model_connector_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_connector_manager'))]"/>
        </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Connector Platform Views -->
        <record id="view_connector_platform_tree" model="ir.ui.view">
            <field name="name">connector.platform.list</field>
            <field name="model">connector.platform</field>
            <field name="arch" type="xml">
                <list string="Connector Platforms">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="version"/>
                    <field name="api_type"/>
                    <field name="api_version"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="view_connector_platform_form" model="ir.ui.view">
            <field name="name">connector.platform.form</field>
            <field name="model">connector.platform</field>
            <field name="arch" type="xml">
                <form string="Connector Platform">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Platform Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="code"/>
                                <field name="version"/>
                                <field name="description"/>
                                <field name="is_active"/>
                            </group>
                            <group string="API Information">
                                <field name="api_type"/>
                                <field name="api_version"/>
                                <field name="api_base_url"/>
                                <field name="api_rate_limit"/>
                            </group>
                        </group>
                        <group>
                            <group string="Platform Status">
                                <field name="is_beta"/>
                                <field name="is_deprecated"/>
                            </group>
                            <group string="Documentation">
                                <field name="website"/>
                                <field name="api_documentation"/>
                                <field name="developer_portal"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Connector Platform Action -->
        <record id="action_connector_platform" model="ir.actions.act_window">
            <field name="name">Connector Platforms</field>
            <field name="res_model">connector.platform</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No connector platforms found
                </p>
                <p>
                    Connector platforms define the eCommerce platforms that can be integrated.
                </p>
            </field>
        </record>
    </odoo>

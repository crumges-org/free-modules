<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Connector Mapping Views -->
        <record id="view_connector_mapping_tree" model="ir.ui.view">
            <field name="name">connector.mapping.list</field>
            <field name="model">connector.mapping</field>
            <field name="arch" type="xml">
                <list string="Data Mappings">
                    <field name="name"/>
                    <field name="model_name"/>
                    <field name="direction"/>
                    <field name="field_type"/>
                    <field name="is_active"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record id="view_connector_mapping_form" model="ir.ui.view">
            <field name="name">connector.mapping.form</field>
            <field name="model">connector.mapping</field>
            <field name="arch" type="xml">
                <form string="Data Mapping">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Mapping Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Mapping Information">
                                <field name="model_name"/>
                                <field name="direction"/>
                                <field name="field_type"/>
                                <field name="is_active"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Field Mapping">
                                <field name="odoo_field"/>
                                <field name="external_field"/>
                                <field name="transformation_rule"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Advanced Settings" name="advanced">
                                <group>
                                    <field name="is_required"/>
                                    <field name="default_value"/>
                                    <field name="validation_rule"/>
                                    <field name="conditional_expression"/>
                                </group>
                                <group>
                                    <field name="pre_processing"/>
                                    <field name="post_processing"/>
                                    <field name="is_active"/>
                                    <field name="cache_duration"/>
                                </group>
                            </page>
                            <page string="Statistics" name="stats">
                                <group>
                                    <field name="usage_count"/>
                                    <field name="last_used"/>
                                    <field name="success_count"/>
                                    <field name="error_count"/>
                                    <field name="success_rate"/>
                                    <field name="is_valid"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Connector Mapping Action -->
        <record id="action_connector_mapping" model="ir.actions.act_window">
            <field name="name">Data Mappings</field>
            <field name="res_model">connector.mapping</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No data mappings found
                </p>
                <p>
                    Create data mappings to transform data between different systems.
                </p>
            </field>
        </record>
    </odoo>

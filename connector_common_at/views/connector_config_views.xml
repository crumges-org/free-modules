<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Connector Config Views -->
        <record id="view_connector_config_tree" model="ir.ui.view">
            <field name="name">connector.config.list</field>
            <field name="model">connector.config</field>
            <field name="arch" type="xml">
                <list string="Connector Configurations">
                    <field name="name"/>
                    <field name="config_key"/>
                    <field name="config_type"/>
                    <field name="value_type"/>
                    <field name="is_active"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record id="view_connector_config_form" model="ir.ui.view">
            <field name="name">connector.config.form</field>
            <field name="model">connector.config</field>
            <field name="arch" type="xml">
                <form string="Connector Configuration">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Configuration Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="instance_id"/>
                                <field name="config_type"/>
                                <field name="config_key"/>
                                <field name="is_active"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Configuration Value">
                                <field name="value_type"/>
                                <field name="config_value"/>
                                <field name="default_value"/>
                                <field name="is_required"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="validation_rule"/>
                            <field name="selection_options"/>
                            <field name="group_name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Connector Config Action -->
        <record id="action_connector_config" model="ir.actions.act_window">
            <field name="name">Connector Configurations</field>
            <field name="res_model">connector.config</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No connector configurations found
                </p>
                <p>
                    Create configurations to customize connector behavior for different platforms.
                </p>
            </field>
        </record>
    </odoo>

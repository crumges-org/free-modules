<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Connector Log Views -->
        <record id="view_connector_log_tree" model="ir.ui.view">
            <field name="name">connector.log.list</field>
            <field name="model">connector.log</field>
            <field name="arch" type="xml">
                <list string="Connector Logs" decoration-info="level == 'info'" decoration-warning="level == 'warning'" decoration-danger="level == 'error'">
                    <field name="create_date"/>
                    <field name="level"/>
                    <field name="message"/>
                    <field name="instance_id"/>
                    <field name="operation"/>
                </list>
            </field>
        </record>

        <record id="view_connector_log_form" model="ir.ui.view">
            <field name="name">connector.log.form</field>
            <field name="model">connector.log</field>
            <field name="arch" type="xml">
                <form string="Connector Log">
                    <sheet>
                        <group>
                            <group string="Log Information">
                                <field name="create_date"/>
                                <field name="level"/>
                                <field name="instance_id"/>
                                <field name="operation"/>
                            </group>
                            <group string="Message">
                                <field name="message"/>
                                <field name="data"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Connector Log Action -->
        <record id="action_connector_log" model="ir.actions.act_window">
            <field name="name">Connector Logs</field>
            <field name="res_model">connector.log</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_info': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No logs found
                </p>
                <p>
                    Logs will appear here as connector operations are performed.
                </p>
            </field>
        </record>
    </odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Connector Instance Views -->
        <record id="view_connector_instance_tree" model="ir.ui.view">
            <field name="name">connector.instance.list</field>
            <field name="model">connector.instance</field>
            <field name="arch" type="xml">
                <list string="Connector Instances" decoration-success="is_active == True" decoration-danger="is_active == False">
                    <field name="name"/>
                    <field name="platform_type"/>
                    <field name="is_active"/>
                    <field name="sync_enabled"/>
                    <field name="created_date"/>
                </list>
            </field>
        </record>

        <record id="view_connector_instance_form" model="ir.ui.view">
            <field name="name">connector.instance.form</field>
            <field name="model">connector.instance</field>
            <field name="arch" type="xml">
                <form string="Connector Instance">
                    <header>
                        <button name="action_test_connection" string="Test Connection" type="object" class="oe_highlight"/>
                        <button name="action_sync_now" string="Sync Now" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Instance Name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Basic Information">
                                <field name="platform_type"/>
                                <field name="is_active"/>
                                <field name="is_test_mode"/>
                                <field name="sync_enabled"/>
                            </group>
                            <group string="Configuration">
                                <field name="api_url"/>
                                <field name="api_key"/>
                                <field name="api_secret"/>
                                <field name="access_token"/>
                            </group>
                        </group>
                        <group>
                            <group string="Performance Settings">
                                <field name="batch_size"/>
                                <field name="sync_interval"/>
                                <field name="retry_attempts"/>
                            </group>
                            <group string="Status">
                                <field name="last_sync_date"/>
                                <field name="last_connection_test"/>
                                <field name="created_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Logs" name="logs">
                                <field name="log_ids" readonly="1"/>
                            </page>
                            <page string="Queue" name="queue">
                                <field name="queue_ids" readonly="1"/>
                            </page>
                            <page string="Mappings" name="mappings">
                                <field name="mapping_ids"/>
                            </page>
                            <page string="Configurations" name="configs">
                                <field name="config_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Connector Instance Action -->
        <record id="action_connector_instance" model="ir.actions.act_window">
            <field name="name">Connector Instances</field>
            <field name="res_model">connector.instance</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No connector instances found
                </p>
                <p>
                    Create your first connector instance to start integrating with eCommerce platforms.
                </p>
            </field>
        </record>
    </odoo>

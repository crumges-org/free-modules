<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Default Connector Platforms -->
        <record id="platform_woocommerce" model="connector.platform">
            <field name="name">WooCommerce</field>
            <field name="code">woocommerce</field>
            <field name="version">3.0+</field>
            <field name="description">WooCommerce WordPress eCommerce platform</field>
            <field name="api_type">rest</field>
            <field name="api_version">v3</field>
            <field name="is_active">True</field>
        </record>

        <record id="platform_shopify" model="connector.platform">
            <field name="name">Shopify</field>
            <field name="code">shopify</field>
            <field name="version">2023-01+</field>
            <field name="description">Shopify eCommerce platform</field>
            <field name="api_type">rest</field>
            <field name="api_version">2023-01</field>
            <field name="is_active">True</field>
        </record>

        <record id="platform_magento" model="connector.platform">
            <field name="name">Magento</field>
            <field name="code">magento</field>
            <field name="version">2.4+</field>
            <field name="description">Magento eCommerce platform</field>
            <field name="api_type">rest</field>
            <field name="api_version">v1</field>
            <field name="is_active">True</field>
        </record>

        <record id="platform_prestashop" model="connector.platform">
            <field name="name">PrestaShop</field>
            <field name="code">prestashop</field>
            <field name="version">1.7+</field>
            <field name="description">PrestaShop eCommerce platform</field>
            <field name="api_type">rest</field>
            <field name="api_version">v1</field>
            <field name="is_active">True</field>
        </record>

        <record id="platform_bigcommerce" model="connector.platform">
            <field name="name">BigCommerce</field>
            <field name="code">bigcommerce</field>
            <field name="version">v3+</field>
            <field name="description">BigCommerce eCommerce platform</field>
            <field name="api_type">rest</field>
            <field name="api_version">v3</field>
            <field name="is_active">True</field>
        </record>

        <!-- Default Job Scheduler -->
        <record id="default_job_scheduler" model="connector.job.scheduler">
            <field name="name">Default Background Job Scheduler</field>
            <field name="active">True</field>
            <field name="interval_minutes">5</field>
        </record>

        <!-- Cron: process pending background jobs every 5 minutes -->
        <record id="ir_cron_process_pending_jobs" model="ir.cron">
            <field name="name">Connector: Process Pending Background Jobs</field>
            <field name="model_id" ref="model_connector_background_processor"/>
            <field name="state">code</field>
            <field name="code">model.process_pending_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </odoo>

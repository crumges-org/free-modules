<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form_inherit_openweathermap" model="ir.ui.view">
            <field name="name">res.users.view.form.inherit.openweathermap</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Weather Settings" name="weather_oauth" groups="odoo_openweathermap_integration.group_show_weather_forecast">
                        <group>
                            <field name="show_weather_notification"/>
                            <field name="weather_temp_scale_type" required="show_weather_notification"/>
                            <field name="weather_location_type"/>
                            <div class="alert alert-warning" role="alert" invisible="weather_location_type != 'timezone' or (weather_location_type == 'timezone' and tz)">
                                <i class="fa fa-exclamation-triangle"/> User has not Timezone. Please set your timezone from <b>Preferences</b> tab.
                            </div>
                            <field name="weather_city" invisible="weather_location_type != 'manual'" required="weather_location_type == 'manual'"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="view_users_form_simple_modif_inherit_openweathermap" model="ir.ui.view">
            <field name="name">res.users.view.form.simple.modif.inherit.openweathermap</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Weather Settings" name="weather_oauth" groups="odoo_openweathermap_integration.group_show_weather_forecast">
                        <group>
                            <field name="show_weather_notification"/>
                            <field name="weather_temp_scale_type" required="show_weather_notification"/>
                            <field name="weather_location_type"/>
                            <div class="alert alert-warning" role="alert" invisible="weather_location_type != 'timezone' or (weather_location_type == 'timezone' and tz)">
                                <i class="fa fa-exclamation-triangle"/> User has not Timezone. Please set your timezone from <b>Preferences</b> tab.
                            </div>
                            <field name="weather_city" invisible="weather_location_type != 'manual'" required="weather_location_type == 'manual'"/>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>

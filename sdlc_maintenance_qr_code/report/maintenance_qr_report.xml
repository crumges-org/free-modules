<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Paper format: A4, zero margins -->
    <record id="paperformat_qr_labels" model="report.paperformat">
        <field name="name">QR Label Paper Format</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <!-- Report action -->
    <record id="action_report_maintenance_equipment_qr" model="ir.actions.report">
        <field name="name">Equipment QR Labels</field>
        <field name="model">maintenance.qr.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sdlc_maintenance_qr_code.report_maintenance_equipment_qr</field>
        <field name="report_file">sdlc_maintenance_qr_code.report_maintenance_equipment_qr</field>
        <field name="paperformat_id" ref="paperformat_qr_labels"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Wizard form view -->
    <record id="view_maintenance_qr_print_wizard_form" model="ir.ui.view">
        <field name="name">maintenance.qr.print.wizard.form</field>
        <field name="model">maintenance.qr.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Equipment QR Labels">
                <group>
                    <field name="equipment_ids" widget="many2many_tags"/>
                    <field name="copies"/>
                    <field name="size" widget="radio"/>
                    <field name="custom_columns"
                           invisible="size != 'custom'"/>
                    <field name="custom_rows"
                           invisible="size != 'custom'"/>
                    <field name="header_color" widget="color"/>
                </group>
                <footer>
                    <button name="action_print"
                            string="Print Labels"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard action -->
    <record id="action_maintenance_qr_print_wizard" model="ir.actions.act_window">
        <field name="name">Print Equipment QR Labels</field>
        <field name="res_model">maintenance.qr.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sbl_portal_my_details_inherit" inherit_id="sensible_dynamic_portal.sbl_portal_my_details">
        <xpath expr="//div[@t-if='not records']" position="after">
            <t t-if="sbl_dynamic_portal.sbl_kpis_ids">
                <div class="row" id="sbl_kpis">
                    <t t-foreach="sbl_dynamic_portal.sbl_kpis_ids" t-as="line">
                        <div class="col-md-2">
                            <a t-att-href="request.httprequest.path + '?' + keep_query('*', kpi=line.id)">
                                <div class="card text-white mb-3"
                                     id="sbl_kpi_card"
                                     t-att-data-res_id="line.id"
                                     t-att-data-res_model="line._name"
                                     t-att-data-sbl_dynamic_portal_id="sbl_dynamic_portal.id"
                                     t-att-data-sbl_dynamic_portal_model="sbl_dynamic_portal._name"
                                     t-attf-style="max-width: 10rem;background-color:{{line.sbl_color}}">
                                    <div class="card-body text-center">
                                        <img class="o_image_64_max"
                                             t-attf-src="/web/image/#{line._name}/#{line.id}/image_128"
                                             alt="Card image"/>
                                    </div>
                                    <div class="card-footer">
                                        <t t-out="line.name"/>
                                        (<t t-out="line.sbl_record_count"/>)
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

    <template id="my_dashboard_link" name="Link to frontend portal" inherit_id="portal.user_dropdown">
        <xpath expr="//*[@id='o_logout_divider']" position="before">
            <a href="/my/dashboard" role="menuitem" class="dropdown-item ps-3">
                <i class="fa fa-fw fa-id-card-o me-1 small text-primary text-primary-emphasis"/> My Dashboard
            </a>
        </xpath>
    </template>

    <template id="sbl_portal_breadcrumbs" name="Portal Breadcrumbs">
        <ol t-if="page_name != 'home'" class="o_portal_submenu breadcrumb mb-0 flex-grow-1 px-0">
            <li class="breadcrumb-item ms-1"><a href="/my/dashboard" aria-label="Home" title="Home"><i class="fa fa-home"/></a></li>
            <li t-if="page_name == sbl_dynamic_portal.sbl_model_id.name"
                t-attf-class="breadcrumb-item #{'active ' if not record else ''}">
                <a t-if="record"
                    t-attf-href="/my/dashboard/#{sbl_dynamic_portal.id}">
                    <t t-out="sbl_dynamic_portal.sbl_model_id.name"/>
                </a>
                <t t-else="">
                    <t t-out="sbl_dynamic_portal.sbl_model_id.name"/>
                </t>
            </li>
            <li t-if="record and page_name == sbl_dynamic_portal.sbl_model_id.name"
                class="breadcrumb-item active">
                <t t-out="record.name"/>
            </li>
        </ol>
    </template>

    <template id="sbl_portal_layout" name="Portal Layout">
        <t t-call="portal.frontend_layout">
            <t t-set="is_portal" t-value="True"/>

            <div t-if="not no_breadcrumbs and not my_details and not breadcrumbs_searchbar" class="o_portal container mt-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <t t-call="sensible_dynamic_portal_dashboard.sbl_portal_breadcrumbs"/>
                </div>
            </div>
            <div id="wrap" class='o_portal_wrap'>
                <div class="container pt-3 pb-5">
                    <t t-out="0"/>
                </div>
            </div>
        </t>
    </template>

    <template id="sbl_portal_my_dashboard" name="My Portal Dashboard">
        <t t-call="sensible_dynamic_portal_dashboard.sbl_portal_layout">
            <div class="row" id="sbl_dashboard">
                <t t-if="not records">
                    <div>
                        <h3>
                            Data not found
                        </h3>
                    </div>
                </t>
                <t t-foreach="records" t-as="rec">
                    <div class="col-md-2">
                        <a t-attf-href="/my/dashboard/#{rec.id}">
                            <div class="card text-white mb-3"
                                 id="sbl_kpi_card"
                                 t-att-data-res_id="rec.id"
                                 t-att-data-res_model="rec._name"
                                 t-attf-style="max-width: 10rem;background-color:{{rec.sbl_color}}">
                                <div class="card-body text-center">
                                    <img class="o_image_64_max"
                                         t-attf-src="/web/image/#{rec._name}/#{rec.id}/image_128"
                                         alt="Card image"/>
                                </div>
                                <div class="card-footer">
                                    <t t-out="rec.name"/>
                                </div>
                            </div>
                        </a>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="sbl_portal_my_dashboard_detail" name="My Dashboard Detail">
        <t t-call="sensible_dynamic_portal_dashboard.sbl_portal_layout">
            <div class="row" id="sbl_dashboard">
                <h2 t-out="sbl_dynamic_portal.sbl_model_id.name"/>
                <t t-foreach="sbl_dynamic_portal.sbl_dashboard_kpis_ids" t-as="line">
                    <div class="col-md-2">
                        <a t-attf-href="/my/dashboard/#{sbl_dynamic_portal.id}/#{line.id}">
                            <div class="card text-white mb-3"
                                 id="sbl_kpi_card"
                                 t-att-data-res_id="line.id"
                                 t-att-data-res_model="line._name"
                                 t-attf-style="max-width: 10rem;background-color:{{line.sbl_color}}">
                                <div class="card-body text-center">
                                    <img class="o_image_64_max"
                                         t-attf-src="/web/image/#{line._name}/#{line.id}/image_128"
                                         alt="Card image"/>
                                </div>
                                <div class="card-footer">
                                    <t t-out="line.name"/>
                                </div>
                            </div>
                        </a>
                    </div>
                </t>
            </div>
            <div id="sc_dashboard_charts">
                <div class="row mb-3">
                    <div class="col-12 text-end">
                        <select id="sc_chart_selector" class="form-select w-auto d-inline-block">
                            <option value="pie" selected="selected">Pie</option>
                            <option value="bar">Bar</option>
                            <option value="line">Line</option>
                            <option value="radar">Radar</option>
                            <option value="doughnut">Doughnut</option>
                            <option value="all">All</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-6" id="sbl_portal_dashboard_pie_chart" t-att-data-record_id="sbl_dynamic_portal.id">
                        <canvas id="sbl_pie_chart_canvas" width="400" height="400"></canvas>
                    </div>
                    <div class="col-6" id="sbl_portal_dashboard_radar_chart" t-att-data-record_id="sbl_dynamic_portal.id">
                        <canvas id="sbl_radar_chart_canvas" width="400" height="400"></canvas>
                    </div>

                    <div class="col-6" id="sbl_portal_dashboard_line_chart" t-att-data-record_id="sbl_dynamic_portal.id">
                        <canvas id="sbl_line_chart_canvas" width="600" height="300"></canvas>
                    </div>
                    <div class="col-6" id="sbl_portal_dashboard_doughnut_chart" t-att-data-record_id="sbl_dynamic_portal.id">
                        <canvas id="sbl_doughnut_chart_canvas" width="400" height="400"></canvas>
                    </div>

                    <div class="col-6 mt64" id="sbl_portal_dashboard_bar_chart" t-att-data-record_id="sbl_dynamic_portal.id">
                        <canvas id="sbl_bar_chart_canvas" width="400" height="400"></canvas>
                    </div>
                </div>

            </div>
        </t>
    </template>

    <template id="sbl_portal_my_dashboard_record_detail" name="My Dashboard Detail">
        <t t-call="sensible_dynamic_portal_dashboard.sbl_portal_layout">
            <t t-call="portal.portal_searchbar">
                <t t-set="title">
                    <t t-out="sbl_dynamic_portal.name"/>
                </t>
            </t>
            <div t-if="not records" class="alert alert-warning" role="alert">
                There are currently no records.
            </div>
            <t t-if="records" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <t t-foreach="sbl_dynamic_portal.sbl_field_line" t-as="line">
                            <th>
                                <t t-out="line.sbl_field_id.field_description"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <t t-foreach="records" t-as="record">
                    <tr>
                        <td t-foreach="sbl_dynamic_portal.sbl_field_line" t-as="line">
                            <t t-if="sbl_dynamic_portal.sbl_report_id">
                                <a t-attf-href="/my/#{sbl_dynamic_portal.id}/#{sbl_dynamic_portal.sbl_model_id.model}/#{record.id}">
                                    <t t-call="sensible_dynamic_portal.sbl_portal_my_detail_row"/>
                                </a>
                            </t>
                            <t t-else="">
                                <t t-call="sensible_dynamic_portal.sbl_portal_my_detail_row"/>
                            </t>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>
</odoo>
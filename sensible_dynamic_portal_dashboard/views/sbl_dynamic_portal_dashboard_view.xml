<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sbl_dynamic_portal_dashboard_form_view" model="ir.ui.view">
        <field name="name">sbl.dynamic.portal.dashboard.form</field>
        <field name="model">sbl.dynamic.portal.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sbl_model_id"/>
                            <field name="sbl_model_name"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="sbl_color" widget="color"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="kpis" string="KPIs">
                            <field name="sbl_kpis_ids" context="{'default_sbl_model_name': sbl_model_name}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="sbl_model_name" column_invisible="1"/>
                                    <field name="sbl_domain" widget="domain"
                                           options="{'foldable': True, 'model': 'sbl_model_name', 'in_dialog': True}"/>
                                    <field name="sbl_color" widget="color"/>
                                    <field name="image_1920" widget="image" class="oe_avatar"
                                           options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="sbl_model_name" invisible="1"/>
                                                <field name="sbl_domain" widget="domain"
                                                       options="{'foldable': True, 'model': 'sbl_model_name', 'in_dialog': True}"/>
                                            </group>
                                            <group>
                                                <field name="image_1920" widget="image" class="oe_avatar" no_label="1"
                                                       options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sbl_dynamic_portal_dashboard_tree_view" model="ir.ui.view">
        <field name="name">sbl.dynamic.portal.dashboard.tree</field>
        <field name="model">sbl.dynamic.portal.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sbl_model_id"/>
            </list>
        </field>
    </record>

    <record id="sbl_dynamic_portal_dashboard_search_view" model="ir.ui.view">
        <field name="name">sbl.dynamic.portal.dashboard.search</field>
        <field name="model">sbl.dynamic.portal.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sbl_model_id"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="sbl_dynamic_portal_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dynamic Portal Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sbl.dynamic.portal.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
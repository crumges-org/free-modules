<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sbl_dynamic_portal_form_inherit" model="ir.ui.view">
        <field name="name">sbl.dynamic.portal.form</field>
        <field name="model">sbl.dynamic.portal</field>
        <field name="inherit_id" ref="sensible_dynamic_portal.sbl_dynamic_portal_form_view"/>
        <field name="priority" eval="8"/>
        <field name="arch" type="xml">
            <field name="sbl_sortby_ids" position="after">
                <field name="sbl_color" widget="color"/>
            </field>
            <page name="fields" position="after">
                <page name="kpis" string="KPIs">
                    <field name="sbl_kpis_ids" context="{'default_sbl_model_name': sbl_model_name}">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="sbl_model_name" column_invisible="1"/>
                            <field name="sbl_domain" widget="domain"
                                   options="{'foldable': True, 'model': 'sbl_model_name', 'in_dialog': True}"/>
                            <field name="sbl_record_count" column_invisible="1"/>
                            <field name="sbl_color" widget="color"/>
                            <field name="image_1920" widget="image" class="oe_avatar"
                                   options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name"/>
                                        <field name="sbl_model_name" invisible="1"/>
                                        <field name="sbl_domain" widget="domain"
                                               options="{'foldable': True, 'model': 'sbl_model_name', 'in_dialog': True}"/>
                                    </group>
                                    <group>
                                        <field name="image_1920" widget="image" class="oe_avatar" no_label="1"
                                               options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                                        <field name="sbl_color" widget="color"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
                <page name="Dashboard kpis" string="Dashboard">
                    <field name="sbl_dashboard_kpis_ids" context="{'default_sbl_model_name': sbl_model_name}">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="sbl_model_name" column_invisible="1"/>
                            <field name="sbl_domain" widget="domain"
                                   options="{'foldable': True, 'model': 'sbl_model_name', 'in_dialog': True}"/>
                            <field name="sbl_record_count" column_invisible="1"/>
                            <field name="sbl_color" widget="color"/>
                            <field name="sbl_chart_color" widget="color"/>
                            <field name="image_1920" widget="image" class="oe_avatar"
                                   options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name"/>
                                        <field name="sbl_model_name" invisible="1"/>
                                        <field name="sbl_domain" widget="domain"
                                               options="{'foldable': True, 'model': 'sbl_model_name', 'in_dialog': True}"/>
                                    </group>
                                    <group>
                                        <field name="image_1920" widget="image" class="oe_avatar" no_label="1"
                                               options="{'convert_to_webp': True, 'preview_image': 'image_128'}"/>
                                        <field name="sbl_color" widget="color"/>
                                        <field name="sbl_chart_color" widget="color" required="True"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
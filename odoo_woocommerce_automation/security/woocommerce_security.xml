<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- WooCommerce User Group -->
        <record id="group_woocommerce_user" model="res.groups">
            <field name="name">WooCommerce User</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">Users can view and manage WooCommerce configurations and perform basic synchronization tasks.</field>
        </record>
        
        <!-- WooCommerce Manager Group -->
        <record id="group_woocommerce_manager" model="res.groups">
            <field name="name">WooCommerce Manager</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">Managers can configure WooCommerce settings, manage all synchronizations, and view reports.</field>
            <field name="implied_ids" eval="[(4, ref('group_woocommerce_user'))]"/>
        </record>
        
        <!-- WooCommerce Administrator Group -->
        <record id="group_woocommerce_administrator" model="res.groups">
            <field name="name">WooCommerce Administrator</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">Administrators have full access to all WooCommerce features including system configuration and advanced settings.</field>
            <field name="implied_ids" eval="[(4, ref('group_woocommerce_manager'))]"/>
        </record>
        
    </data>
</odoo> 
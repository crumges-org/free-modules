<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WooCommerce Mapping Wizard Form View -->
        <record id="view_woocommerce_mapping_wizard_form" model="ir.ui.view">
            <field name="name">woocommerce.mapping.wizard.form</field>
            <field name="model">woocommerce.mapping.wizard</field>
            <field name="arch" type="xml">
                <form string="WooCommerce Mapping">
                    <header>
                        <button name="action_create_mapping" 
                                type="object" 
                                string="Create Mapping" 
                                class="btn-primary"
                                icon="fa-link"
                                invisible="status == 'running'"/>
                        <field name="status" widget="badge" 
                               decoration-success="status == 'completed'"
                               decoration-danger="status == 'error'"
                               decoration-warning="status == 'running'"
                               decoration-info="status == 'draft'"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>WooCommerce Mapping Configuration</h1>
                        </div>
                        
                        <group>
                            <group string="Configuration">
                                <field name="configuration_id" required="1"/>
                                <field name="mapping_type"/>
                            </group>
                        </group>
                        
                        <!-- Product Category Mapping -->
                        <div invisible="mapping_type != 'product_categories'">
                            <group string="Product Category Mapping">
                                <field name="odoo_category_id"/>
                                <field name="woocommerce_category_id"/>
                                <field name="woocommerce_category_name"/>
                            </group>
                        </div>
                        
                        <!-- Order Status Mapping -->
                        <div invisible="mapping_type != 'order_statuses'">
                            <group string="Order Status Mapping">
                                <field name="odoo_state"/>
                                <field name="woocommerce_status"/>
                            </group>
                        </div>
                        
                        <!-- Payment Method Mapping -->
                        <div invisible="mapping_type != 'payment_methods'">
                            <group string="Payment Method Mapping">
                                <field name="odoo_payment_method"/>
                                <field name="woocommerce_payment_method"/>
                            </group>
                        </div>
                        
                        <!-- Shipping Method Mapping -->
                        <div invisible="mapping_type != 'shipping_methods'">
                            <group string="Shipping Method Mapping">
                                <field name="odoo_shipping_method"/>
                                <field name="woocommerce_shipping_method"/>
                            </group>
                        </div>
                        
                        <!-- Customer Group Mapping -->
                        <div invisible="mapping_type != 'customer_groups'">
                            <group string="Customer Group Mapping">
                                <field name="odoo_partner_category_id"/>
                                <field name="woocommerce_customer_group"/>
                            </group>
                        </div>
                        
                        <!-- Product Attribute Mapping -->
                        <div invisible="mapping_type != 'product_attributes'">
                            <group string="Product Attribute Mapping">
                                <field name="odoo_attribute_id"/>
                                <field name="woocommerce_attribute_name"/>
                            </group>
                        </div>
                        
                        <div invisible="status not in ['completed', 'error']" class="mt-3">
                            <field name="mapping_results" readonly="1"/>
                        </div>
                    </sheet>
                    
                    <footer>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- WooCommerce Mapping Wizard Action -->
        <record id="action_woocommerce_mapping_wizard" model="ir.actions.act_window">
            <field name="name">WooCommerce Mapping</field>
            <field name="res_model">woocommerce.mapping.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>
        
    </data>
</odoo> 
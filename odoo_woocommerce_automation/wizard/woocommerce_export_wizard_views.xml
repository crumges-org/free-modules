<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WooCommerce Export Wizard Form View -->
        <record id="view_woocommerce_export_wizard_form" model="ir.ui.view">
            <field name="name">woocommerce.export.wizard.form</field>
            <field name="model">woocommerce.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Export to WooCommerce">
                    <header>
                        <button name="action_start_export" 
                                type="object" 
                                string="Start Export" 
                                class="btn-primary"
                                icon="fa-upload"
                                invisible="status == 'running'"/>
                        <field name="status" widget="badge" 
                               decoration-success="status == 'completed'"
                               decoration-danger="status == 'error'"
                               decoration-warning="status == 'running'"
                               decoration-info="status == 'draft'"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>Export to WooCommerce</h1>
                        </div>
                        
                        <group>
                            <group string="Configuration">
                                <field name="configuration_id" required="1"/>
                                <field name="export_limit"/>
                            </group>
                            
                            <group string="Export Options">
                                <field name="export_products"/>
                                <field name="export_orders"/>
                                <field name="export_customers"/>
                                <field name="export_inventory"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Product Export Settings">
                                <field name="include_images"/>
                                <field name="include_variants"/>
                            </group>
                            
                            <group string="Export Settings">
                                <field name="update_existing"/>
                                <field name="create_missing"/>
                            </group>
                        </group>
                        
                        <div invisible="status != 'running'" class="mt-3">
                            <field name="progress" widget="progressbar"/>
                            <field name="result_message" readonly="1"/>
                        </div>
                        
                        <div invisible="status not in ['completed', 'error']" class="mt-3">
                            <field name="result_message" readonly="1"/>
                        </div>
                    </sheet>
                    
                    <footer>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- WooCommerce Export Wizard Action -->
        <record id="action_woocommerce_export_wizard" model="ir.actions.act_window">
            <field name="name">Export to WooCommerce</field>
            <field name="res_model">woocommerce.export.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>
        
    </data>
</odoo> 
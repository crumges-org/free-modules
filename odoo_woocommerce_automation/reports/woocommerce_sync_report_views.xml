<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WooCommerce Sync Report Action -->
        <record id="action_woocommerce_sync_report" model="ir.actions.act_window">
            <field name="name">WooCommerce Sync Report</field>
            <field name="res_model">woocommerce.sync.log</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sync reports found!
                </p>
                <p>
                    Sync reports will appear here after synchronization operations.
                </p>
            </field>
        </record>
        
    </data>
</odoo> 
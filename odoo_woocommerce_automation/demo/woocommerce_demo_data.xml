<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo WooCommerce Configuration -->
        <record id="demo_woocommerce_configuration" model="woocommerce.configuration">
            <field name="name">Demo WooCommerce Store</field>
            <field name="active">True</field>
            <field name="woocommerce_url">https://demo-store.woocommerce.com/</field>
            <field name="consumer_key">demo_consumer_key_12345</field>
            <field name="consumer_secret">demo_consumer_secret_67890</field>
            <field name="api_version">wc/v3</field>
            <field name="timeout">30</field>
            <field name="sync_products">True</field>
            <field name="sync_orders">True</field>
            <field name="sync_customers">True</field>
            <field name="sync_inventory">True</field>
            <field name="auto_sync_products">False</field>
            <field name="auto_sync_orders">False</field>
            <field name="auto_sync_customers">False</field>
            <field name="sync_frequency">1hour</field>
            <field name="connection_status">connected</field>
            <field name="last_connection_test" eval="DateTime.now()"/>
            <field name="total_products_synced">25</field>
            <field name="total_orders_synced">150</field>
            <field name="total_customers_synced">75</field>
            <field name="notes">Demo configuration for testing purposes</field>
        </record>
        
        <!-- Demo Sync Logs -->
        <record id="demo_sync_log_1" model="woocommerce.sync.log">
            <field name="configuration_id" ref="demo_woocommerce_configuration"/>
            <field name="sync_type">product</field>
            <field name="operation">import</field>
            <field name="status">success</field>
            <field name="records_processed">25</field>
            <field name="records_created">20</field>
            <field name="records_updated">5</field>
            <field name="records_failed">0</field>
            <field name="start_time" eval="DateTime.now()"/>
            <field name="end_time" eval="DateTime.now()"/>
            <field name="duration">45.5</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>
        
        <record id="demo_sync_log_2" model="woocommerce.sync.log">
            <field name="configuration_id" ref="demo_woocommerce_configuration"/>
            <field name="sync_type">order</field>
            <field name="operation">import</field>
            <field name="status">success</field>
            <field name="records_processed">50</field>
            <field name="records_created">45</field>
            <field name="records_updated">5</field>
            <field name="records_failed">0</field>
            <field name="start_time" eval="DateTime.now()"/>
            <field name="end_time" eval="DateTime.now()"/>
            <field name="duration">120.3</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>
        
        <record id="demo_sync_log_3" model="woocommerce.sync.log">
            <field name="configuration_id" ref="demo_woocommerce_configuration"/>
            <field name="sync_type">customer</field>
            <field name="operation">import</field>
            <field name="status">success</field>
            <field name="records_processed">30</field>
            <field name="records_created">25</field>
            <field name="records_updated">5</field>
            <field name="records_failed">0</field>
            <field name="start_time" eval="DateTime.now()"/>
            <field name="end_time" eval="DateTime.now()"/>
            <field name="duration">75.8</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>
        
        <record id="demo_sync_log_4" model="woocommerce.sync.log">
            <field name="configuration_id" ref="demo_woocommerce_configuration"/>
            <field name="sync_type">product</field>
            <field name="operation">export</field>
            <field name="status">error</field>
            <field name="records_processed">10</field>
            <field name="records_created">0</field>
            <field name="records_updated">0</field>
            <field name="records_failed">10</field>
            <field name="start_time" eval="DateTime.now()"/>
            <field name="end_time" eval="DateTime.now()"/>
            <field name="duration">15.2</field>
            <field name="error_message">API rate limit exceeded</field>
            <field name="error_details">WooCommerce API returned 429 Too Many Requests error</field>
            <field name="user_id" ref="base.user_admin"/>
        </record>
        
    </data>
</odoo> 
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- WooCommerce Product Sync Cron -->
        <record id="ir_cron_woocommerce_product_sync" model="ir.cron">
            <field name="name">WooCommerce: Sync Products</field>
            <field name="model_id" ref="model_woocommerce_configuration"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_products()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- WooCommerce Order Sync Cron -->
        <record id="ir_cron_woocommerce_order_sync" model="ir.cron">
            <field name="name">WooCommerce: Sync Orders</field>
            <field name="model_id" ref="model_woocommerce_configuration"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_orders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- WooCommerce Customer Sync Cron -->
        <record id="ir_cron_woocommerce_customer_sync" model="ir.cron">
            <field name="name">WooCommerce: Sync Customers</field>
            <field name="model_id" ref="model_woocommerce_configuration"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_customers()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- WooCommerce Inventory Sync Cron -->
        <record id="ir_cron_woocommerce_inventory_sync" model="ir.cron">
            <field name="name">WooCommerce: Sync Inventory</field>
            <field name="model_id" ref="model_woocommerce_configuration"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_inventory()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- WooCommerce Connection Test Cron -->
        <record id="ir_cron_woocommerce_connection_test" model="ir.cron">
            <field name="name">WooCommerce: Test Connection</field>
            <field name="model_id" ref="model_woocommerce_configuration"/>
            <field name="state">code</field>
            <field name="code">model._cron_test_connection()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <!-- WooCommerce Cleanup Old Logs Cron -->
        <record id="ir_cron_woocommerce_cleanup_logs" model="ir.cron">
            <field name="name">WooCommerce: Cleanup Old Logs</field>
            <field name="model_id" ref="model_woocommerce_sync_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
    </data>
</odoo> 
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Configuration -->
        <record id="default_woocommerce_configuration" model="woocommerce.configuration">
            <field name="name">Default WooCommerce Configuration</field>
            <field name="active">False</field>
            <field name="woocommerce_url">https://yourstore.com/</field>
            <field name="consumer_key">your_consumer_key_here</field>
            <field name="consumer_secret">your_consumer_secret_here</field>
            <field name="api_version">wc/v3</field>
            <field name="timeout">30</field>
            <field name="sync_products">True</field>
            <field name="sync_orders">True</field>
            <field name="sync_customers">True</field>
            <field name="sync_inventory">True</field>
            <field name="auto_sync_products">False</field>
            <field name="auto_sync_orders">False</field>
            <field name="auto_sync_customers">False</field>
            <field name="sync_frequency">1hour</field>
            <field name="notes">Default configuration - please update with your actual WooCommerce store details</field>
        </record>
        
    </data>
</odoo> 
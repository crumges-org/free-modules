<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WooCommerce Sync Log Form View -->
        <record id="view_woocommerce_sync_log_form" model="ir.ui.view">
            <field name="name">woocommerce.sync.log.form</field>
            <field name="model">woocommerce.sync.log</field>
            <field name="arch" type="xml">
                <form string="Sync Log" create="false" edit="false">
                    <header>
                        <button name="action_retry_sync" 
                                type="object" 
                                string="Retry Sync" 
                                class="btn btn-primary"
                                icon="fa-refresh"
                                invisible="status != 'error'"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" class="form-control-lg"/>
                            </h1>
                        </div>
                        
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-primary text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-info-circle me-2"></i>Sync Information
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="configuration_id" class="form-label">Configuration:</label>
                                            <field name="configuration_id" class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="sync_type" class="form-label">Sync Type:</label>
                                            <field name="sync_type" class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="operation" class="form-label">Operation:</label>
                                            <field name="operation" class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="status" class="form-label">Status:</label>
                                            <field name="status" widget="badge" 
                                                   decoration-success="status == 'success'"
                                                   decoration-danger="status == 'error'"
                                                   decoration-warning="status == 'warning'"
                                                   decoration-info="status == 'in_progress'"
                                                   class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="user_id" class="form-label">User:</label>
                                            <field name="user_id" class="form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-6">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-info text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-clock me-2"></i>Timing Information
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="start_time" class="form-label">Start Time:</label>
                                            <field name="start_time" class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="end_time" class="form-label">End Time:</label>
                                            <field name="end_time" class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="duration" class="form-label">Duration:</label>
                                            <field name="duration" widget="float_time" class="form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-success text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-chart-bar me-2"></i>Records Processed
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3 mb-3">
                                                <div class="text-center">
                                                    <div class="stat-number text-primary">
                                                        <field name="records_processed"/>
                                                    </div>
                                                    <div class="stat-label text-muted">Processed</div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="text-center">
                                                    <div class="stat-number text-success">
                                                        <field name="records_created"/>
                                                    </div>
                                                    <div class="stat-label text-muted">Created</div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="text-center">
                                                    <div class="stat-number text-info">
                                                        <field name="records_updated"/>
                                                    </div>
                                                    <div class="stat-label text-muted">Updated</div>
                                                </div>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <div class="text-center">
                                                    <div class="stat-number text-danger">
                                                        <field name="records_failed"/>
                                                    </div>
                                                    <div class="stat-label text-muted">Failed</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-3" invisible="status != 'error'">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm border-danger">
                                    <div class="card-header bg-gradient-danger text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-exclamation-triangle me-2"></i>Error Information
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="error_message" class="form-label">Error Message:</label>
                                            <field name="error_message" readonly="1" class="form-control"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="error_details" class="form-label">Error Details:</label>
                                            <field name="error_details" readonly="1" class="form-control"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-warning text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-link me-2"></i>Related Records
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4 mb-3">
                                                <label for="product_ids" class="form-label">Products:</label>
                                                <field name="product_ids" readonly="1" class="form-control"/>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <label for="order_ids" class="form-label">Orders:</label>
                                                <field name="order_ids" readonly="1" class="form-control"/>
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                <label for="customer_ids" class="form-label">Customers:</label>
                                                <field name="customer_ids" readonly="1" class="form-control"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- WooCommerce Sync Log Tree View -->
        <record id="view_woocommerce_sync_log_list" model="ir.ui.view">
            <field name="name">woocommerce.sync.log.list</field>
            <field name="model">woocommerce.sync.log</field>
            <field name="arch" type="xml">
                <list string="Sync Logs" create="false" edit="false">
                    <field name="name"/>
                    <field name="configuration_id"/>
                    <field name="sync_type"/>
                    <field name="operation"/>
                    <field name="status" widget="badge" 
                           decoration-success="status == 'success'"
                           decoration-danger="status == 'error'"
                           decoration-warning="status == 'warning'"
                           decoration-info="status == 'in_progress'"/>
                    <field name="records_processed"/>
                    <field name="records_created"/>
                    <field name="records_updated"/>
                    <field name="records_failed"/>
                    <field name="duration" widget="float_time"/>
                    <field name="start_time"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>
        
        <!-- WooCommerce Sync Log Search View -->
        <record id="view_woocommerce_sync_log_search" model="ir.ui.view">
            <field name="name">woocommerce.sync.log.search</field>
            <field name="model">woocommerce.sync.log</field>
            <field name="arch" type="xml">
                <search string="Search Sync Logs">
                    <field name="name"/>
                    <field name="configuration_id"/>
                    <field name="sync_type"/>
                    <field name="operation"/>
                    <field name="status"/>
                    <field name="user_id"/>
                    
                    <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                    <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                    <filter string="Warning" name="warning" domain="[('status', '=', 'warning')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                    
                    <filter string="Products" name="products" domain="[('sync_type', '=', 'product')]"/>
                    <filter string="Orders" name="orders" domain="[('sync_type', '=', 'order')]"/>
                    <filter string="Customers" name="customers" domain="[('sync_type', '=', 'customer')]"/>
                    <filter string="Inventory" name="inventory" domain="[('sync_type', '=', 'inventory')]"/>
                    
                    <filter string="Import" name="import" domain="[('operation', '=', 'import')]"/>
                    <filter string="Export" name="export" domain="[('operation', '=', 'export')]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Sync Type" name="group_sync_type" context="{'group_by': 'sync_type'}"/>
                        <filter string="Operation" name="group_operation" context="{'group_by': 'operation'}"/>
                        <filter string="Configuration" name="group_configuration" context="{'group_by': 'configuration_id'}"/>
                        <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'start_time:day'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- WooCommerce Sync Log Action -->
        <record id="action_woocommerce_sync_log" model="ir.actions.act_window">
            <field name="name">Sync Logs</field>
            <field name="res_model">woocommerce.sync.log</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_error': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No sync logs found!
                </p>
                <p>
                    Sync logs will appear here after synchronization operations.
                </p>
            </field>
        </record>
        
    </data>
</odoo> 
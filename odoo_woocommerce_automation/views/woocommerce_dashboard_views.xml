<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WooCommerce Dashboard Form View -->
        <record id="view_woocommerce_dashboard_form" model="ir.ui.view">
            <field name="name">woocommerce.dashboard.form</field>
            <field name="model">woocommerce.dashboard</field>
            <field name="arch" type="xml">
                <form string="WooCommerce Dashboard" create="false" edit="false">
                    <sheet class="o_woo_scope">
                        <!-- No Configuration Warning -->
                        <div class="row mb-4" attrs="{'invisible': [('configuration_id', '!=', False)]}">
                            <div class="col-12">
                                <div class="alert alert-warning text-center" role="status">
                                    <h4 class="alert-heading">
                                        <i class="fa fa-exclamation-triangle me-2" title="No configuration"></i>No WooCommerce Configuration Found
                                    </h4>
                                    <p class="mb-3">
                                        You need to create a WooCommerce configuration before you can use the dashboard features.
                                    </p>
                                    <button name="action_open_configuration" 
                                            type="object" 
                                            class="btn btn-primary btn-lg">
                                        <i class="fa fa-cog me-2" title="Create configuration"></i>Create Configuration
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="oe_title text-center mb-4">
                            <h1 class="display-4 text-primary">
                                <i class="fa fa-shopping-cart me-3" title="WooCommerce"></i>WooCommerce Automation Dashboard
                            </h1>
                            <p class="lead text-muted">Monitor and manage your WooCommerce integration</p>
                        </div>
                        
                        <!-- Connection Status Card -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-primary text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-plug me-2" title="Connection status"></i>Connection Status
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-3 text-center">
                                                <div class="connection-status-indicator">
                                                    <div class="status-badge connected" attrs="{'invisible': [('connection_status','!=','connected')]}">
                                                        <i class="fa fa-check-circle fa-3x text-success" title="Connected"></i>
                                                        <h4 class="mt-2 text-success">Connected</h4>
                                                    </div>
                                                    <div class="status-badge error" attrs="{'invisible': [('connection_status','!=','error')]}">
                                                        <i class="fa fa-times-circle fa-3x text-danger" title="Error"></i>
                                                        <h4 class="mt-2 text-danger">Error</h4>
                                                    </div>
                                                    <div class="status-badge disconnected" attrs="{'invisible': [('connection_status','!=','disconnected')]}">
                                                        <i class="fa fa-exclamation-triangle fa-3x text-warning" title="Disconnected"></i>
                                                        <h4 class="mt-2 text-warning">Disconnected</h4>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-9">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <p class="text-muted mb-1">Last Connection Test:</p>
                                                        <p class="h6"><field name="last_connection_test"/></p>
                                                    </div>
                                                    <div class="col-md-6" attrs="{'invisible': [('connection_status','!=','error')]}">
                                                        <p class="text-muted mb-1">Error Message:</p>
                                                        <field name="connection_error_message" readonly="1" class="form-control"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Sync Statistics Cards -->
                        <div class="row mb-4">
                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-primary text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-box fa-2x" title="Products"></i>
                                        </div>
                                        <h2 class="text-primary mb-1"><field name="total_products_synced"/></h2>
                                        <p class="text-muted mb-2">Products Synced</p>
                                        <small class="text-muted">
                                            <i class="fa fa-clock me-1" title="Last products sync"></i>Last: <field name="last_product_sync"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-success text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-shopping-bag fa-2x" title="Orders"></i>
                                        </div>
                                        <h2 class="text-success mb-1"><field name="total_orders_synced"/></h2>
                                        <p class="text-muted mb-2">Orders Synced</p>
                                        <small class="text-muted">
                                            <i class="fa fa-clock me-1" title="Last orders sync"></i>Last: <field name="last_order_sync"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-info text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-users fa-2x" title="Customers"></i>
                                        </div>
                                        <h2 class="text-info mb-1"><field name="total_customers_synced"/></h2>
                                        <p class="text-muted mb-2">Customers Synced</p>
                                        <small class="text-muted">
                                            <i class="fa fa-clock me-1" title="Last customers sync"></i>Last: <field name="last_customer_sync"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-warning text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-exclamation-triangle fa-2x" title="Sync errors"></i>
                                        </div>
                                        <h2 class="text-warning mb-1"><field name="total_sync_errors"/></h2>
                                        <p class="text-muted mb-2">Sync Errors</p>
                                        <small class="text-muted">Last 24 hours</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Extended KPIs -->
                        <div class="row mb-4">
                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-secondary text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-tasks fa-2x" title="Pending queues"></i>
                                        </div>
                                        <h2 class="text-secondary mb-1"><field name="total_queues_pending"/></h2>
                                        <p class="text-muted mb-2">Pending Queue Lines</p>
                                        <button name="action_open_queues"
                                                type="object"
                                                class="btn btn-outline-secondary btn-sm mt-1">
                                            View Queues
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-danger text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-bug fa-2x" title="Failed queues"></i>
                                        </div>
                                        <h2 class="text-danger mb-1"><field name="total_queues_failed"/></h2>
                                        <p class="text-muted mb-2">Failed Queue Lines</p>
                                        <button name="action_open_queues"
                                                type="object"
                                                class="btn btn-outline-danger btn-sm mt-1">
                                            Review Failures
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-dark text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-bell fa-2x" title="Webhooks"></i>
                                        </div>
                                        <h2 class="text-dark mb-1"><field name="total_active_webhooks"/></h2>
                                        <p class="text-muted mb-2">Active Webhooks</p>
                                        <button name="action_open_webhooks"
                                                type="object"
                                                class="btn btn-outline-dark btn-sm mt-1">
                                            Manage Webhooks
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6 mb-3">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <div class="stat-icon bg-primary text-white rounded-circle mx-auto mb-3">
                                            <i class="fa fa-ticket fa-2x" title="Coupons"></i>
                                        </div>
                                        <h2 class="text-primary mb-1"><field name="total_coupons"/></h2>
                                        <p class="text-muted mb-2">Coupons</p>
                                        <button name="action_open_coupons"
                                                type="object"
                                                class="btn btn-outline-primary btn-sm mt-1">
                                            View Coupons
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Quick Actions -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-success text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-bolt me-2" title="Quick actions"></i>Quick Actions
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_import_wizard" 
                                                        type="object" 
                                                        class="btn btn-outline-primary btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Import Products">
                                                    <i class="fa fa-download fa-2x mb-2" title="Import products"></i>
                                                    <span>Import Products</span>
                                                </button>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_export_wizard" 
                                                        type="object" 
                                                        class="btn btn-outline-success btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Export Products">
                                                    <i class="fa fa-upload fa-2x mb-2" title="Export products"></i>
                                                    <span>Export Products</span>
                                                </button>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_mapping_wizard" 
                                                        type="object" 
                                                        class="btn btn-outline-info btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Mapping Wizard">
                                                    <i class="fa fa-refresh fa-2x mb-2" title="Mapping wizard"></i>
                                                    <span>Mapping Wizard</span>
                                                </button>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_configuration" 
                                                        type="object" 
                                                        class="btn btn-outline-warning btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Settings">
                                                    <i class="fa fa-cog fa-2x mb-2" title="Settings"></i>
                                                    <span>Settings</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_queues"
                                                        type="object"
                                                        class="btn btn-outline-secondary btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Queues">
                                                    <i class="fa fa-tasks fa-2x mb-2" title="Queues"></i>
                                                    <span>Queues</span>
                                                </button>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_webhooks"
                                                        type="object"
                                                        class="btn btn-outline-dark btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Webhooks">
                                                    <i class="fa fa-bell fa-2x mb-2" title="Webhooks"></i>
                                                    <span>Webhooks</span>
                                                </button>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_coupons"
                                                        type="object"
                                                        class="btn btn-outline-primary btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Coupons">
                                                    <i class="fa fa-ticket fa-2x mb-2" title="Coupons"></i>
                                                    <span>Coupons</span>
                                                </button>
                                            </div>
                                            <div class="col-md-3 mb-3">
                                                <button name="action_open_process_history"
                                                        type="object"
                                                        class="btn btn-outline-info btn-lg w-100 h-100 d-flex flex-column align-items-center justify-content-center"
                                                        string="Process History">
                                                    <i class="fa fa-list-ul fa-2x mb-2" title="Process history"></i>
                                                    <span>Process History</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Recent Activity -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-gradient-info text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fa fa-history me-2" title="Recent activity"></i>Recent Activity
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="timeline">
                                            <div class="timeline-item">
                                                <div class="timeline-marker bg-success"></div>
                                                <div class="timeline-content">
                                                    <h6 class="timeline-title">Product Sync Completed</h6>
                                                    <p class="timeline-text">Successfully synced 25 products from WooCommerce</p>
                                                    <small class="text-muted">2 hours ago</small>
                                                </div>
                                            </div>
                                            <div class="timeline-item">
                                                <div class="timeline-marker bg-info"></div>
                                                <div class="timeline-content">
                                                    <h6 class="timeline-title">Order Import</h6>
                                                    <p class="timeline-text">Imported 15 new orders from WooCommerce</p>
                                                    <small class="text-muted">4 hours ago</small>
                                                </div>
                                            </div>
                                            <div class="timeline-item">
                                                <div class="timeline-marker bg-warning"></div>
                                                <div class="timeline-content">
                                                    <h6 class="timeline-title">Connection Test</h6>
                                                    <p class="timeline-text">Connection test completed successfully</p>
                                                    <small class="text-muted">6 hours ago</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- WooCommerce Dashboard Action -->
        <record id="action_woocommerce_dashboard" model="ir.actions.act_window">
            <field name="name">WooCommerce Dashboard</field>
            <field name="res_model">woocommerce.dashboard</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Welcome to WooCommerce Automation Dashboard!
                </p>
                <p>
                    Create a WooCommerce configuration to start synchronizing data.
                </p>
            </field>
        </record>
        
    </data>
</odoo>

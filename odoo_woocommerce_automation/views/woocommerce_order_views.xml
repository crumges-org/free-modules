<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- WooCommerce Order Action -->
        <record id="action_woocommerce_order" model="ir.actions.act_window">
            <field name="name">WooCommerce Orders</field>
            <field name="res_model">woocommerce.order</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No WooCommerce orders found!
                </p>
                <p>
                    WooCommerce orders will appear here after synchronization.
                </p>
            </field>
        </record>
        
    </data>
</odoo> 
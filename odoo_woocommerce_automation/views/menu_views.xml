<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Main WooCommerce Menu -->
        <menuitem id="menu_woocommerce_root"
                  name="WooCommerce"
                  web_icon="odoo_woocommerce_automation,static/description/icon.png"
                  sequence="50"
                  groups="group_woocommerce_user"/>
        
        <!-- Dashboard Menu -->
        <menuitem id="menu_woocommerce_dashboard"
                  name="Dashboard"
                  parent="menu_woocommerce_root"
                  action="action_woocommerce_dashboard"
                  sequence="10"
                  groups="group_woocommerce_user"/>
        
        <!-- Synchronization Menu -->
        <menuitem id="menu_woocommerce_sync"
                  name="Synchronization"
                  parent="menu_woocommerce_root"
                  sequence="20"
                  groups="group_woocommerce_user"/>
        
        <!-- Tools Menu -->
        <menuitem id="menu_woocommerce_tools"
                  name="Tools"
                  parent="menu_woocommerce_root"
                  sequence="30"
                  groups="group_woocommerce_manager"/>
        
        <menuitem id="menu_woocommerce_tools_import"
                  name="Import Wizard"
                  parent="menu_woocommerce_tools"
                  action="action_woocommerce_import_wizard"
                  sequence="10"
                  groups="group_woocommerce_manager"/>
        
        <menuitem id="menu_woocommerce_tools_export"
                  name="Export Wizard"
                  parent="menu_woocommerce_tools"
                  action="action_woocommerce_export_wizard"
                  sequence="20"
                  groups="group_woocommerce_manager"/>
        
        <menuitem id="menu_woocommerce_tools_mapping"
                  name="Mapping Wizard"
                  parent="menu_woocommerce_tools"
                  action="action_woocommerce_mapping_wizard"
                  sequence="30"
                  groups="group_woocommerce_manager"/>
        
        <menuitem id="menu_woocommerce_tools_test_connection"
                  name="Test Connection"
                  parent="menu_woocommerce_tools"
                  action="action_woocommerce_test_connection_wizard"
                  sequence="40"
                  groups="group_woocommerce_manager"/>
        
        <!-- Reports Menu -->
        <menuitem id="menu_woocommerce_reports"
                  name="Reports"
                  parent="menu_woocommerce_root"
                  sequence="40"
                  groups="group_woocommerce_user"/>
        
        <menuitem id="menu_woocommerce_reports_sync_log"
                  name="Sync Logs"
                  parent="menu_woocommerce_reports"
                  action="action_woocommerce_sync_log"
                  sequence="10"
                  groups="group_woocommerce_user"/>
        
        <menuitem id="menu_woocommerce_reports_sync_report"
                  name="Sync Report"
                  parent="menu_woocommerce_reports"
                  action="action_woocommerce_sync_report"
                  sequence="20"
                  groups="group_woocommerce_user"/>
        
        <!-- Configuration Menu (at the end) -->
        <menuitem id="menu_woocommerce_configuration"
                  name="Configuration"
                  parent="menu_woocommerce_root"
                  sequence="50"
                  groups="group_woocommerce_manager"/>
        
        <menuitem id="menu_woocommerce_configuration_list"
                  name="Configurations"
                  parent="menu_woocommerce_configuration"
                  action="action_woocommerce_configuration"
                  sequence="10"
                  groups="group_woocommerce_manager"/>
        
    </data>
</odoo> 
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer Feedback Sequence -->
        <record id="seq_customer_feedback" model="ir.sequence">
            <field name="name">Customer Feedback</field>
            <field name="code">advanced.customer.feedback</field>
            <field name="prefix">FB</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sample Feedback Categories -->
        <record id="feedback_category_general" model="feedback.category">
            <field name="name">General</field>
            <field name="sequence">10</field>
            <field name="description">General feedback and suggestions</field>
            <field name="is_active">True</field>
            <field name="color">1</field>
        </record>

        <record id="feedback_category_product" model="feedback.category">
            <field name="name">Product</field>
            <field name="sequence">20</field>
            <field name="description">Product-related feedback and suggestions</field>
            <field name="is_active">True</field>
            <field name="color">2</field>
        </record>

        <record id="feedback_category_service" model="feedback.category">
            <field name="name">Service</field>
            <field name="sequence">30</field>
            <field name="description">Service quality and support feedback</field>
            <field name="is_active">True</field>
            <field name="color">3</field>
        </record>

        <record id="feedback_category_website" model="feedback.category">
            <field name="name">Website</field>
            <field name="sequence">40</field>
            <field name="description">Website usability and feature requests</field>
            <field name="is_active">True</field>
            <field name="color">4</field>
        </record>

        <record id="feedback_category_bug" model="feedback.category">
            <field name="name">Bug Report</field>
            <field name="sequence">50</field>
            <field name="description">Bug reports and technical issues</field>
            <field name="is_active">True</field>
            <field name="color">5</field>
        </record>

        <!-- Sample Feedback Templates -->
        <record id="feedback_template_general" model="feedback.template">
            <field name="name">General Feedback Template</field>
            <field name="category_id" ref="feedback_category_general"/>
            <field name="title">General Feedback</field>
            <field name="description">Template for collecting general feedback from customers</field>
            <field name="is_active">True</field>
        </record>

        <record id="feedback_template_product" model="feedback.template">
            <field name="name">Product Feedback Template</field>
            <field name="category_id" ref="feedback_category_product"/>
            <field name="title">Product Feedback</field>
            <field name="description">Template for collecting product-specific feedback</field>
            <field name="is_active">True</field>
        </record>

        <record id="feedback_template_service" model="feedback.template">
            <field name="name">Service Feedback Template</field>
            <field name="category_id" ref="feedback_category_service"/>
            <field name="title">Service Feedback</field>
            <field name="description">Template for collecting service quality feedback</field>
            <field name="is_active">True</field>
        </record>

        <!-- Sample Template Fields -->
        <record id="feedback_template_field_name" model="feedback.template.field">
            <field name="template_id" ref="feedback_template_general"/>
            <field name="name">Customer Name</field>
            <field name="field_type">text</field>
            <field name="required">True</field>
            <field name="sequence">10</field>
            <field name="help_text">Please enter your full name</field>
        </record>

        <record id="feedback_template_field_email" model="feedback.template.field">
            <field name="template_id" ref="feedback_template_general"/>
            <field name="name">Email Address</field>
            <field name="field_type">email</field>
            <field name="required">True</field>
            <field name="sequence">20</field>
            <field name="help_text">Please enter your email address</field>
        </record>

        <record id="feedback_template_field_rating" model="feedback.template.field">
            <field name="template_id" ref="feedback_template_general"/>
            <field name="name">Overall Rating</field>
            <field name="field_type">select</field>
            <field name="required">True</field>
            <field name="sequence">30</field>
            <field name="help_text">Please rate your overall experience</field>
            <field name="selection_options">Excellent
Good
Average
Poor
Very Poor</field>
        </record>

        <record id="feedback_template_field_comments" model="feedback.template.field">
            <field name="template_id" ref="feedback_template_general"/>
            <field name="name">Comments</field>
            <field name="field_type">textarea</field>
            <field name="required">False</field>
            <field name="sequence">40</field>
            <field name="help_text">Please share your detailed feedback</field>
        </record>

        <!-- Sample Feedback Tags -->
        <record id="feedback_tag_urgent" model="feedback.tag">
            <field name="name">Urgent</field>
            <field name="sequence">10</field>
            <field name="description">High priority feedback requiring immediate attention</field>
            <field name="color">1</field>
            <field name="active">True</field>
        </record>

        <record id="feedback_tag_feature_request" model="feedback.tag">
            <field name="name">Feature Request</field>
            <field name="sequence">20</field>
            <field name="description">Requests for new features or functionality</field>
            <field name="color">2</field>
            <field name="active">True</field>
        </record>

        <record id="feedback_tag_bug" model="feedback.tag">
            <field name="name">Bug</field>
            <field name="sequence">30</field>
            <field name="description">Bug reports and technical issues</field>
            <field name="color">3</field>
            <field name="active">True</field>
        </record>

        <record id="feedback_tag_improvement" model="feedback.tag">
            <field name="name">Improvement</field>
            <field name="sequence">40</field>
            <field name="description">Suggestions for improving existing features</field>
            <field name="color">4</field>
            <field name="active">True</field>
        </record>

        <record id="feedback_tag_compliment" model="feedback.tag">
            <field name="name">Compliment</field>
            <field name="sequence">50</field>
            <field name="description">Positive feedback and compliments</field>
            <field name="color">5</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>

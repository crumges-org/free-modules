<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer Feedback Group -->
        <record id="group_customer_feedback_user" model="res.groups">
            <field name="name">Advanced Customer Feedback User</field>
            <field name="category_id" ref="base.module_category_customer_relationship_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_customer_feedback_manager" model="res.groups">
            <field name="name">Advanced Customer Feedback Manager</field>
            <field name="category_id" ref="base.module_category_customer_relationship_management"/>
            <field name="implied_ids" eval="[(4, ref('group_customer_feedback_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_customer_feedback_user" model="ir.rule">
            <field name="name">Advanced Customer Feedback User: Own Feedbacks</field>
            <field name="model_id" ref="model_advanced_customer_feedback"/>
            <field name="domain_force">[('assigned_to_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_customer_feedback_user'))]"/>
        </record>

        <record id="rule_customer_feedback_manager" model="ir.rule">
            <field name="name">Advanced Customer Feedback Manager: All Feedbacks</field>
            <field name="model_id" ref="model_advanced_customer_feedback"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_customer_feedback_manager'))]"/>
        </record>

        <record id="rule_feedback_category_user" model="ir.rule">
            <field name="name">Advanced Feedback Category User: Read Only</field>
            <field name="model_id" ref="model_feedback_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_customer_feedback_user'))]"/>
        </record>

        <record id="rule_feedback_category_manager" model="ir.rule">
            <field name="name">Advanced Feedback Category Manager: Full Access</field>
            <field name="model_id" ref="model_feedback_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_customer_feedback_manager'))]"/>
        </record>

        <record id="rule_feedback_template_user" model="ir.rule">
            <field name="name">Advanced Feedback Template User: Read Only</field>
            <field name="model_id" ref="model_feedback_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_customer_feedback_user'))]"/>
        </record>

        <record id="rule_feedback_template_manager" model="ir.rule">
            <field name="name">Advanced Feedback Template Manager: Full Access</field>
            <field name="model_id" ref="model_feedback_template"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_customer_feedback_manager'))]"/>
        </record>
    </data>
</odoo>

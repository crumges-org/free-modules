<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Feedback Tag Tree View -->
        <record id="view_feedback_tag_tree" model="ir.ui.view">
            <field name="name">feedback.tag.tree</field>
            <field name="model">feedback.tag</field>
            <field name="arch" type="xml">
                <tree string="Feedback Tags">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="feedback_count"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- Feedback Tag Form View -->
        <record id="view_feedback_tag_form" model="ir.ui.view">
            <field name="name">feedback.tag.form</field>
            <field name="model">feedback.tag</field>
            <field name="arch" type="xml">
                <form string="Feedback Tag">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="color" widget="color_picker"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="active"/>
                                <field name="feedback_count"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Feedback Tag Search View -->
        <record id="view_feedback_tag_search" model="ir.ui.view">
            <field name="name">feedback.tag.search</field>
            <field name="model">feedback.tag</field>
            <field name="arch" type="xml">
                <search string="Search Feedback Tags">
                    <field name="name"/>
                    <field name="description"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Color" name="color" context="{'group_by': 'color'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Feedback Tag Action -->
        <record id="action_feedback_tag" model="ir.actions.act_window">
            <field name="name">Feedback Tags</field>
            <field name="res_model">feedback.tag</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first feedback tag!
                </p>
                <p>
                    Tags help organize and categorize feedback for better management.
                </p>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Feedback Template Field Tree View -->
        <record id="view_feedback_template_field_tree" model="ir.ui.view">
            <field name="name">feedback.template.field.tree</field>
            <field name="model">feedback.template.field</field>
            <field name="arch" type="xml">
                <tree string="Template Fields">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="field_type"/>
                    <field name="required"/>
                    <field name="help_text"/>
                </tree>
            </field>
        </record>

        <!-- Feedback Template Field Form View -->
        <record id="view_feedback_template_field_form" model="ir.ui.view">
            <field name="name">feedback.template.field.form</field>
            <field name="model">feedback.template.field</field>
            <field name="arch" type="xml">
                <form string="Template Field">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="field_type"/>
                                <field name="required"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="template_id"/>
                                <field name="default_value"/>
                                <field name="validation_regex"/>
                            </group>
                        </group>
                        <group>
                            <field name="help_text" nolabel="1"/>
                        </group>
                        <group invisible="field_type not in ['select', 'radio']">
                            <field name="selection_options" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Feedback Template Field Search View -->
        <record id="view_feedback_template_field_search" model="ir.ui.view">
            <field name="name">feedback.template.field.search</field>
            <field name="model">feedback.template.field</field>
            <field name="arch" type="xml">
                <search string="Search Template Fields">
                    <field name="name"/>
                    <field name="field_type"/>
                    <field name="template_id"/>
                    <filter string="Required Fields" name="required" domain="[('required', '=', True)]"/>
                    <filter string="Selection Fields" name="selection" domain="[('field_type', 'in', ['select', 'radio'])]"/>
                    <group expand="0" string="Group By">
                        <filter string="Field Type" name="field_type" context="{'group_by': 'field_type'}"/>
                        <filter string="Template" name="template" context="{'group_by': 'template_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Feedback Template Field Action -->
        <record id="action_feedback_template_field" model="ir.actions.act_window">
            <field name="name">Template Fields</field>
            <field name="res_model">feedback.template.field</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first template field!
                </p>
                <p>
                    Template fields define the structure of feedback forms.
                </p>
            </field>
        </record>
    </data>
</odoo>

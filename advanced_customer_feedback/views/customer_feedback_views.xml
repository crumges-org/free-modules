<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Customer Feedback Tree View -->
        <record id="view_customer_feedback_tree" model="ir.ui.view">
            <field name="name">customer.feedback.tree</field>
            <field name="model">advanced.customer.feedback</field>
            <field name="arch" type="xml">
                <tree string="Customer Feedbacks" decoration-info="state == 'new'" decoration-success="state == 'resolved'" decoration-danger="state == 'rejected'">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="category_id"/>
                    <field name="customer_id"/>
                    <field name="customer_email"/>
                    <field name="priority" widget="priority"/>
                    <field name="feedback_type"/>
                    <field name="state"/>
                    <field name="assigned_to_id"/>
                    <field name="create_date"/>
                    <field name="days_open"/>
                </tree>
            </field>
        </record>

        <!-- Customer Feedback Form View -->
        <record id="view_customer_feedback_form" model="ir.ui.view">
            <field name="name">customer.feedback.form</field>
            <field name="model">advanced.customer.feedback</field>
            <field name="arch" type="xml">
                <form string="Customer Feedback">
                    <header>
                        <button name="action_assign_to_me" string="Assign to Me" type="object" class="oe_highlight" invisible="state != 'new'" groups="advanced_customer_feedback.group_customer_feedback_manager"/>
                        <button name="action_start_progress" string="Start Working" type="object" class="oe_highlight" invisible="state not in ('new', 'in_progress')"/>
                        <button name="action_resolve" string="Resolve" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                        <button name="action_reject" string="Reject" type="object" invisible="state not in ('new', 'in_progress')"/>
                        <button name="action_reopen" string="Reopen" type="object" invisible="state not in ('resolved', 'closed', 'rejected')"/>
                        <field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="title" placeholder="Feedback Title"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="category_id"/>
                                <field name="feedback_type"/>
                                <field name="priority" widget="priority"/>
                                <field name="source"/>
                            </group>
                            <group>
                                <field name="assigned_to_id"/>
                                <field name="create_date"/>
                                <field name="days_open"/>
                                <field name="satisfaction_rating" widget="rating"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Customer Information">
                                <group>
                                    <field name="customer_id"/>
                                    <field name="customer_email"/>
                                    <field name="customer_phone"/>
                                </group>
                            </page>
                            <page string="Related Records">
                                <group>
                                    <field name="sale_order_id"/>
                                    <field name="product_id"/>
                                    <field name="project_id"/>
                                </group>
                            </page>
                            <page string="Tags">
                                <field name="tags" widget="many2many_tags"/>
                            </page>
                            <page string="Attachments">
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </page>
                            <page string="Notes">
                                <field name="internal_notes" nolabel="1"/>
                            </page>
                            <page string="Resolution" invisible="state != 'resolved'">
                                <field name="resolution_notes" nolabel="1"/>
                                <field name="resolved_date"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Customer Feedback Search View -->
        <record id="view_customer_feedback_search" model="ir.ui.view">
            <field name="name">customer.feedback.search</field>
            <field name="model">advanced.customer.feedback</field>
            <field name="arch" type="xml">
                <search string="Search Customer Feedbacks">
                    <field name="name"/>
                    <field name="title"/>
                    <field name="customer_id"/>
                    <field name="customer_email"/>
                    <field name="category_id"/>
                    <field name="assigned_to_id"/>
                    <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
                    <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                    <filter string="High Priority" name="high_priority" domain="[('priority', '=', '2')]"/>
                    <filter string="Critical Priority" name="critical_priority" domain="[('priority', '=', '3')]"/>
                    <filter string="My Feedbacks" name="my_feedbacks" domain="[('assigned_to_id', '=', uid)]"/>
                    <filter string="Open Feedbacks" name="open_feedbacks" domain="[('state', 'in', ('new', 'in_progress'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="state" context="{'group_by': 'state'}"/>
                        <filter string="Category" name="category" context="{'group_by': 'category_id'}"/>
                        <filter string="Priority" name="priority" context="{'group_by': 'priority'}"/>
                        <filter string="Assigned To" name="assigned_to" context="{'group_by': 'assigned_to_id'}"/>
                        <filter string="Source" name="source" context="{'group_by': 'source'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Customer Feedback Action -->
        <record id="action_customer_feedback" model="ir.actions.act_window">
            <field name="name">Customer Feedbacks</field>
            <field name="res_model">advanced.customer.feedback</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_new': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No customer feedback found!
                </p>
                <p>
                    Customer feedback will appear here when submitted through the portal.
                </p>
            </field>
        </record>

        <!-- Customer Feedback Kanban View -->
        <record id="view_customer_feedback_kanban" model="ir.ui.view">
            <field name="name">customer.feedback.kanban</field>
            <field name="model">advanced.customer.feedback</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="title"/>
                    <field name="category_id"/>
                    <field name="customer_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <field name="assigned_to_id"/>
                    <field name="create_date"/>
                    <field name="days_open"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="title"/>
                                            </strong>
                                        </div>
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="customer_id"/>
                                        <br/>
                                        <field name="category_id"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="assigned_to_id"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="days_open"/> days
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>
</odoo>

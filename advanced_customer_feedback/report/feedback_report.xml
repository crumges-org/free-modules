<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Customer Feedback Report Template -->
        <template id="report_customer_feedback_analysis" name="Customer Feedback Analysis">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2>Customer Feedback Analysis Report</h2>
                            <div class="row mt32 mb32">
                                <div class="col-6">
                                    <strong>Report Date:</strong>
                                    <span t-field="context_timestamp(datetime.datetime.now())"/>
                                </div>
                                <div class="col-6">
                                    <strong>Generated By:</strong>
                                    <span t-field="user.name"/>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-12">
                                    <h3>Feedback Statistics</h3>
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <h4><span t-field="o.total_feedbacks"/></h4>
                                                    <p>Total Feedbacks</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <h4><span t-field="o.average_satisfaction_rating"/></h4>
                                                    <p>Average Rating</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <h4><span t-field="o.resolution_rate"/>%</h4>
                                                    <p>Resolution Rate</p>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <h4><span t-field="o.most_common_category"/></h4>
                                                    <p>Most Common Category</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row mt32">
                                <div class="col-12">
                                    <h3>Report Information</h3>
                                    <p><strong>Report Period:</strong> <span t-field="o.date_from"/> to <span t-field="o.date_to"/></p>
                                    <p><strong>Generated:</strong> <span t-field="context_timestamp(datetime.datetime.now())"/></p>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Customer Feedback Report Action -->
        <record id="action_report_customer_feedback_analysis" model="ir.actions.report">
            <field name="name">Customer Feedback Analysis</field>
            <field name="model">advanced.customer.feedback.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">advanced_customer_feedback.report_customer_feedback_analysis</field>
            <field name="report_file">advanced_customer_feedback.report_customer_feedback_analysis</field>
            <field name="print_report_name">'Customer Feedback Analysis - %s' % (object.name)</field>
        </record>
    </data>
</odoo>

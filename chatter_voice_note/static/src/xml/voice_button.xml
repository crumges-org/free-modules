<t t-inherit="mail.Chatter" t-inherit-mode="extension">
    <xpath expr="//button[contains(@class, 'o-mail-Chatter-sendMessage btn text-nowrap me-1')]" position="after">

        <button
            t-on-click="toggleVoiceRecording"
            t-att-class="{ 'my-2': !props.compactHeight,
                            'btn-success': voiceState.recording,
                            'btn-danger': !voiceState.recording}"
            class="o-mail-Chatter-sendMessage btn text-nowrap me-1 btn-primary my-2"
        >
            <t t-if="!voiceState.recording">
                🎤 Record
            </t>
            <t t-else="">
                ⏹ Stop (<t t-esc="voiceState.seconds"/>s)
            </t>
        </button>

    </xpath>
</t>
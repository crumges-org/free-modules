<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_pre_receipt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.pre.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                    <setting help="Enable printing of POS order receipt before payment validation">
                    <field name="pos_enable_pre_receipt"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_elearning_video.VideoDialog" owl="1">
        <Dialog title="title" size="'md'" contentClass="'o_video_dialog_content'">
            <div class="o_video_dialog">
                <div class="form-group">
                    <div style="margin-bottom: 10px; display: flex;">
                        <span class="record-dot" style="font-size: 24px; color: red; font-weight: bold;">●</span>
                        <span class="record-timer" style="font-size: 24px; color: red; font-weight: bold; margin-left: 6px;">00:00</span>
                    </div>
                    <div class="videos" style="display: flex; justify-content: flex-start; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;">
                        <video class="gum" autoplay="true" muted="true" playsinline="true" style="width: 49%;"></video>
                        <video class="note-video-input" playsinline="true" controls="true" style="width: 49%; background: #222;"></video>
                    </div>
                    <div>
                        <button t-on-click="onStartRecording" class="note-record-btn btn btn-primary">Start</button>
                        <button t-on-click="onStopRecording" class="note-record-stop-btn btn btn-primary" disabled="disabled" style="margin-left: 5px;">Stop</button>
                        <button t-on-click="onPlayVideo" class="note-video-play btn btn-primary" disabled="disabled" style="margin-left: 5px;">Play</button>
                        <button t-on-click="onDownloadVideo" class="note-video-download btn btn-primary" disabled="disabled" style="margin-left: 5px;">Download</button>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.save()">Add</button>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
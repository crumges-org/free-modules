<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kw_crm_stage_history_view_tree" model="ir.ui.view">
        <field name="name">kw.crm.stage.history.tree</field>
        <field name="model">kw.crm.stage.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="lead_id"/>
                <field name="stage_from_id"/>
                <field name="stage_to_id"/>
                <field name="date_in"/>
                <field name="date_in_by_id"/>
                <field name="date_out"/>
                <field name="date_out_by_id"/>
                <field name="day_diff"/>
                <field name="time_diff"/>
                <field name="total_time_diff"/>
            </list>
        </field>
    </record>

    <record id="kw_crm_stage_history_view_form" model="ir.ui.view">
        <field name="name">kw.crm.stage.history.form</field>
        <field name="model">kw.crm.stage.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="stage_from_id"/>
                            <field name="stage_to_id"/>
                        </group>
                        <group>
                            <field name="date_in"/>
                            <field name="date_in_by_id"/>
                            <field name="date_out"/>
                            <field name="date_out_by_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="day_diff"/>
                            <field name="time_diff"/>
                            <field name="total_time_diff"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kw_crm_stage_history_view_search" model="ir.ui.view">
        <field name="name">kw.crm.stage.history.search</field>
        <field name="model">kw.crm.stage.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_id"/>
                <field name="stage_from_id"/>
                <field name="stage_to_id"/>
                <field name="date_in_by_id"/>
                <group expand="0" string="Group By">
                    <filter string="Lead/Opportunity"
                            name="group_by_lead"
                            context="{'group_by': 'lead_id'}"/>
                    <filter string="Stage From"
                            name="group_by_stage_from"
                            context="{'group_by': 'stage_from_id'}"/>
                    <filter string="Stage To"
                            name="group_by_stage_to"
                            context="{'group_by': 'stage_to_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kw_crm_stage_history_view_pivot" model="ir.ui.view">
        <field name="name">kw.crm.stage.history.pivot</field>
        <field name="model">kw.crm.stage.history</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="stage_to_id" type="row"/>
                <field name="day_diff" type="measure"/>
                <field name="time_diff" type="measure"/>
                <field name="total_time_diff" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="kw_crm_stage_history_action" model="ir.actions.act_window">
        <field name="name">Stage Change Analysis</field>
        <field name="res_model">kw.crm.stage.history</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <menuitem id="kw_crm_stage_history_menu"
              name="Stage Change Analysis"
              action="kw_crm_stage_history_action"
              parent="crm.crm_menu_root"
              sequence="5"/>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_inherit_kw_stage_history"
            model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.kw.stage.history</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stage Change History"
                      name="kw_stage_change_history"
                      groups="kw_crm_stage_history.group_crm_stage_history_viewer">
                    <field name="kw_stage_history_ids" readonly="1">
                        <list>
                            <field name="stage_from_id"/>
                            <field name="stage_to_id"/>
                            <field name="date_in"/>
                            <field name="date_in_by_id"/>
                            <field name="date_out"/>
                            <field name="date_out_by_id"/>
                            <field name="day_diff"/>
                            <field name="time_diff"/>
                            <field name="total_time_diff"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>

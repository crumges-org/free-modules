<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Form Submission Report Action -->
        <record id="action_form_submission_report" model="ir.actions.report">
            <field name="name">Form Submission Report</field>
            <field name="model">dynamic.form.submission</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">dynamic_custom_odoo_form_builde.form_submission_report</field>
            <field name="report_file">dynamic_custom_odoo_form_builde.form_submission_report</field>
            <field name="print_report_name">'Form Submission - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_dynamic_form_submission"/>
            <field name="binding_type">report</field>
        </record>
        
        <!-- Form Submission Report Template -->
        <template id="form_submission_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="dynamic_custom_odoo_form_builde.form_submission_report_document"/>
                </t>
            </t>
        </template>
        
        <!-- Form Submission Report Document -->
        <template id="form_submission_report_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <h2 class="text-center mb-4">Form Submission Report</h2>
                                
                                <!-- Submission Details -->
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h4>Submission Information</h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p><strong>Submission ID:</strong> <span t-field="o.name"/></p>
                                                <p><strong>Form:</strong> <span t-field="o.form_id.name"/></p>
                                                <p><strong>Status:</strong> 
                                                    <span t-field="o.state" t-options="{'widget': 'badge'}"/>
                                                </p>
                                                <p><strong>Created:</strong> <span t-field="o.create_date"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p><strong>IP Address:</strong> <span t-field="o.ip_address"/></p>
                                                <p><strong>User Agent:</strong> <span t-field="o.user_agent"/></p>
                                                <p><strong>Referrer:</strong> <span t-field="o.referrer"/></p>
                                                <p><strong>Processed:</strong> <span t-field="o.processed_date"/></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Form Data -->
                                <div class="card mb-4">
                                    <div class="card-header">
                                        <h4>Form Data</h4>
                                    </div>
                                    <div class="card-body">
                                        <div t-if="o.parsed_data" t-field="o.parsed_data" t-options="{'widget': 'html'}"/>
                                        <div t-else="" class="text-muted">No form data available</div>
                                    </div>
                                </div>
                                
                                <!-- Target Record Information -->
                                <div t-if="o.target_record_id" class="card mb-4">
                                    <div class="card-header">
                                        <h4>Target Record</h4>
                                    </div>
                                    <div class="card-body">
                                        <p><strong>Model:</strong> <span t-field="o.target_model"/></p>
                                        <p><strong>Record ID:</strong> <span t-field="o.target_record_id"/></p>
                                        <p><strong>Record Name:</strong> <span t-field="o.target_record_name"/></p>
                                    </div>
                                </div>
                                
                                <!-- Processing Information -->
                                <div t-if="o.processing_error" class="card mb-4">
                                    <div class="card-header bg-danger text-white">
                                        <h4>Processing Error</h4>
                                    </div>
                                    <div class="card-body">
                                        <div t-field="o.processing_error" t-options="{'widget': 'html'}"/>
                                    </div>
                                </div>
                                
                                <!-- Attachments -->
                                <div t-if="o.attachment_ids" class="card mb-4">
                                    <div class="card-header">
                                        <h4>Attachments</h4>
                                    </div>
                                    <div class="card-body">
                                        <ul class="list-unstyled">
                                            <li t-foreach="o.attachment_ids" t-as="attachment">
                                                <i class="fa fa-paperclip"></i>
                                                <span t-field="attachment.name"/>
                                                <small class="text-muted">
                                                    (<span t-field="attachment.file_size"/> bytes)
                                                </small>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <!-- Footer -->
                                <div class="text-center mt-4">
                                    <small class="text-muted">
                                        Report generated on <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
        
    </data>
</odoo>

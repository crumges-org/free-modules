<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Form Action (defined first for reference in views) -->
        <record id="action_dynamic_form" model="ir.actions.act_window">
            <field name="name">Dynamic Forms</field>
            <field name="res_model">dynamic.form</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_published': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first dynamic form!
                </p>
                <p>
                    Create dynamic forms that can be embedded in any external website.
                    Build forms with drag &amp; drop interface and collect data directly in Odoo.
                </p>
            </field>
        </record>
        
        <!-- Form Tree View -->
        <record id="view_dynamic_form_tree" model="ir.ui.view">
            <field name="name">dynamic.form.tree</field>
            <field name="model">dynamic.form</field>
            <field name="arch" type="xml">
                <list string="Dynamic Forms" 
                      decoration-info="status == 'ready'" 
                      decoration-success="status == 'published'" 
                      decoration-muted="status == 'draft' or not is_published"
                      sample="1"
                      create="1"
                      delete="1"
                      default_order="create_date desc"
                      class="o_list_view_dynamic_forms">
                    <field name="name" string="Form Name"/>
                    <field name="status" string="Status" 
                           decoration-success="status == 'published'" 
                           decoration-info="status == 'ready'" 
                           decoration-muted="status == 'draft'"/>
                    <field name="target_model_id" string="Target Model"/>
                    <field name="is_published" string="Published" widget="boolean_toggle"/>
                    <field name="active_field_count" string="Fields" sum="Total Fields"/>
                    <field name="mapping_count" string="Mappings" sum="Total Mappings"/>
                    <field name="view_count" string="Views" sum="Total Views"/>
                    <field name="submission_count" string="Submissions" sum="Total Submissions"/>
                    <field name="conversion_rate" string="Conversion %" widget="percentage" optional="hide"/>
                    <field name="last_submission_date" string="Last Submission" widget="datetime" optional="hide"/>
                    <field name="create_date" string="Created On" widget="datetime" optional="hide"/>
                </list>
            </field>
        </record>
        
        <!-- Form Kanban View -->
        <record id="view_dynamic_form_kanban" model="ir.ui.view">
            <field name="name">dynamic.form.kanban</field>
            <field name="model">dynamic.form</field>
            <field name="arch" type="xml">
                <kanban string="Dynamic Forms" class="o_kanban_small_column dynamic-forms-addon" 
                        default_group_by="target_model_id" 
                        record_drop="false">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="target_model_id"/>
                    <field name="embed_type"/>
                    <field name="layout"/>
                    <field name="position"/>
                    <field name="status"/>
                    <field name="view_count"/>
                    <field name="submission_count"/>
                    <field name="conversion_rate"/>
                    <field name="is_published"/>
                    <field name="create_date"/>
                    <field name="field_count"/>
                    <field name="active_field_count"/>
                    <field name="mapping_count"/>
                    <field name="last_submission_date"/>
                    <field name="field_ids"/>
                    <field name="submission_ids"/>
                    <field name="enable_email_notifications"/>
                    <field name="is_ready"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click dynamic-form-kanban-card">
                                <!-- Header with icon, title, status and toggle -->
                                <div class="o_kanban_record_top">
                                    <div class="kanban-header-left">
                                        <div class="kanban-icon-wrapper">
                                            <i class="fa fa-file-text-o kanban-icon" title="Dynamic Form"></i>
                                        </div>
                                        <div class="o_kanban_record_headings">
                                            <div class="o_kanban_record_title">
                                                <strong><field name="name"/></strong>
                                                <div class="o_kanban_record_subtitle">
                                                    <span class="status-dot" 
                                                          t-attf-class="status-dot status-#{record.status.raw_value}"></span>
                                                    <field name="status" 
                                                           decoration-success="status == 'published'" 
                                                           decoration-info="status == 'ready'" 
                                                           decoration-muted="status == 'draft'"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <field name="is_published" widget="boolean_toggle" 
                                               options="{'terminology': 'published'}"/>
                                    </div>
                                </div>
                                
                                <!-- Content Section -->
                                <div class="oe_kanban_content">
                                    <!-- Description -->
                                    <div class="o_kanban_record_body" t-if="record.description.raw_value">
                                        <field name="description" class="text-muted"/>
                                    </div>
                                    
                                    <!-- Form Configuration Tags -->
                                    <div class="o_kanban_record_bottom config-tags">
                                        <div class="oe_kanban_bottom_left">
                                            <!-- Target Model -->
                                            <div class="config-tag">
                                                <i class="fa fa-database" title="Target Model"></i>
                                                <field name="target_model_id"/>
                                            </div>
                                            
                                            <!-- Embed Type -->
                                            <div class="config-tag">
                                                <i class="fa fa-code" title="Embed Type"></i>
                                                <span t-esc="record.embed_type.raw_value"/>
                                            </div>
                                            
                                            <!-- Layout -->
                                            <div class="config-tag">
                                                <i class="fa fa-th-large" title="Layout"></i>
                                                <span t-esc="record.layout.raw_value"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Statistics in Two Columns -->
                                    <div class="o_kanban_record_bottom stats-section">
                                        <div class="stats-column stats-left">
                                            <!-- Active Fields -->
                                            <div class="stat-item">
                                                <i class="fa fa-list text-primary"></i>
                                                <span class="stat-value">
                                                    <field name="active_field_count"/> Fields
                                                </span>
                                            </div>
                                            
                                            <!-- Views -->
                                            <div class="stat-item">
                                                <i class="fa fa-eye text-info"></i>
                                                <span class="stat-value">
                                                    <field name="view_count"/> Views
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <div class="stats-column stats-right">
                                            <!-- Mappings -->
                                            <div class="stat-item">
                                                <i class="fa fa-link text-info"></i>
                                                <span class="stat-value">
                                                    <field name="mapping_count"/> Mappings
                                                </span>
                                            </div>
                                            
                                            <!-- Submissions -->
                                            <div class="stat-item">
                                                <i class="fa fa-check text-success"></i>
                                                <span class="stat-value">
                                                    <field name="submission_count"/> Check
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Quick Actions -->
                                    <div class="o_kanban_record_bottom actions-section">
                                        <div class="oe_kanban_bottom_right">
                                            <button name="action_preview" type="object" 
                                                    class="btn-icon btn-preview" 
                                                    invisible="not is_published"
                                                    title="Preview Form">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                            <button name="action_publish" type="object" 
                                                    class="btn-icon btn-publish" 
                                                    invisible="is_published"
                                                    title="Publish Form">
                                                <i class="fa fa-globe"></i>
                                            </button>
                                            <button name="action_duplicate" type="object" 
                                                    class="btn-icon btn-duplicate"
                                                    title="Duplicate Form">
                                                <i class="fa fa-copy"></i>
                                            </button>
                                            <button name="refresh_urls" type="object" 
                                                    class="btn-icon btn-refresh"
                                                    title="Refresh URLs">
                                                <i class="fa fa-refresh"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Form Form View -->
        <record id="view_dynamic_form_form" model="ir.ui.view">
            <field name="name">dynamic.form.form</field>
            <field name="model">dynamic.form</field>
            <field name="arch" type="xml">
                <form string="Dynamic Form" class="dynamic-forms-addon">
                    <header>
                        <button name="action_preview" type="object" string="Preview" 
                                class="btn-primary" invisible="not is_published" 
                                icon="fa-eye"/>
                        <button name="action_publish" type="object" string="Publish" 
                                class="btn-success" invisible="is_published or not is_ready"
                                icon="fa-globe"/>
                        <button name="action_unpublish" type="object" string="Unpublish" 
                                class="btn-warning" invisible="not is_published"
                                icon="fa-ban"/>
                        <button name="action_duplicate" type="object" string="Duplicate" 
                                class="btn-secondary" icon="fa-copy"/>
                        <button name="refresh_urls" type="object" string="Refresh URLs" 
                                class="btn-info" icon="fa-refresh"/>
                        <button name="action_view_submissions" type="object" string="View Submissions" 
                                class="btn-default" icon="fa-list"/>

                        <!-- Hidden fields used in modifiers -->
                        <field name="status" widget="statusbar" statusbar_visible="draft,ready,published"/>
                        <field name="is_ready" invisible="1"/>
                    </header>

                    <sheet>
                        <field name="is_published" widget="boolean_toggle"/>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_submissions" type="object" 
                                    class="oe_stat_button" icon="fa-list" 
                                    context="{'search_default_form_id': id}">
                                <field name="submission_count" widget="statinfo" string="Submissions"/>
                            </button>
                            <button name="%(action_dynamic_form)d" type="action" 
                                    class="oe_stat_button" icon="fa-list-alt"
                                    context="{'search_default_form_id': id}">
                                <field name="field_count" widget="statinfo" string="Fields"/>
                            </button>
                            <button name="%(action_dynamic_form)d" type="action" 
                                    class="oe_stat_button" icon="fa-link"
                                    context="{'search_default_form_id': id}">
                                <field name="mapping_count" widget="statinfo" string="Mappings"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Form Name"/>
                            </h1>
                        </div>
                        
                        <!-- Status Badge -->
                        <div class="alert alert-info" role="alert" invisible="status == 'published'">
                            <strong>Status:</strong> 
                            <span class="badge badge-secondary" invisible="status != 'draft'">Draft</span>
                            <span class="badge badge-success" invisible="status != 'ready'">Ready to Publish</span>
                            <span class="badge badge-primary" invisible="status != 'published'">Published</span>
                            <span class="text-warning" invisible="is_ready or status == 'published'">
                                - Form needs fields and target model to be ready
                            </span>
                        </div>
                        
                        <group>
                            <group string="Basic Information">
                                <field name="description" placeholder="Describe your form..."/>
                                <field name="target_model_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group string="Analytics &amp; Statistics">
                                <field name="view_count" readonly="1"/>
                                <field name="submission_count" readonly="1"/>
                                <field name="conversion_rate" widget="percentage" readonly="1"/>
                                <field name="last_submission_date" readonly="1"/>
                                <field name="active_field_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <group>
                            <group string="Embedding">
                                <field name="embed_type"/>
                                <field name="public_url" readonly="1" widget="url"/>
                                <field name="token" readonly="1"/>
                            </group>
                            <group string="Appearance">
                                <field name="layout"/>
                                <field name="header_layout"/>
                                <field name="primary_color" widget="color"/>
                                <field name="secondary_color" widget="color"/>
                                <field name="background_style"/>
                                <field name="theme" invisible="1"/>
                                <field name="position" invisible="1"/>
                                <field name="background_color" widget="color" 
                                       invisible="background_style != 'solid'"
                                       placeholder="#ffffff or rgba(255,255,255,1)"/>
                                <field name="background_gradient" 
                                       invisible="background_style not in ['gradient', 'pattern']"
                                       placeholder="linear-gradient(135deg, #667eea 0%, #764ba2 100%)"/>
                                <field name="background_image_url" 
                                       invisible="background_style != 'image'"
                                       placeholder="https://example.com/image.jpg"/>
                                <field name="background_image" 
                                       invisible="background_style != 'image'"
                                       widget="image"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <!-- Embed Code Section -->
                            <page string="Embed Code" name="embed_code">
                                <div class="alert alert-info" role="alert">
                                    <strong>How to Embed:</strong> Copy the embed code below and paste it into your website's HTML.
                                </div>
                                <group>
                                    <group string="Embed Code">
                                        <field name="embed_code" readonly="1" widget="text" 
                                               placeholder="Embed code will be generated automatically"/>
                                    </group>
                                </group>
                                
                                <div class="alert alert-success" role="alert" style="margin-top: 16px;">
                                    <strong>Demo HTML Examples:</strong>
                                    <div style="margin-top: 12px; font-family: monospace; font-size: 12px; background: #f8f9fa; padding: 12px; border-radius: 4px; overflow-x: auto;">
                                        <div style="margin-bottom: 16px;">
                                            <strong style="color: #28a745;">Example 1: Basic Embed (Appends to body)</strong>
                                            <pre style="margin: 8px 0; white-space: pre-wrap; word-wrap: break-word;"><code>&lt;script src="YOUR_FORM_URL.js"&gt;&lt;/script&gt;</code></pre>
                                        </div>
                                        
                                        <div style="margin-bottom: 16px;">
                                            <strong style="color: #28a745;">Example 2: Embed in Specific Container (Recommended)</strong>
                                            <pre style="margin: 8px 0; white-space: pre-wrap; word-wrap: break-word;"><code>&lt;div id="my-form-container"&gt;&lt;/div&gt;
&lt;script src="YOUR_FORM_URL.js" 
        data-container-id="my-form-container"&gt;&lt;/script&gt;</code></pre>
                                        </div>
                                        
                                        <div style="margin-bottom: 16px;">
                                            <strong style="color: #28a745;">Example 3: Using Query Parameter</strong>
                                            <pre style="margin: 8px 0; white-space: pre-wrap; word-wrap: break-word;"><code>&lt;div id="contact-form"&gt;&lt;/div&gt;
&lt;script src="YOUR_FORM_URL.js?container=contact-form"&gt;&lt;/script&gt;</code></pre>
                                        </div>
                                        
                                        <div style="margin-bottom: 16px;">
                                            <strong style="color: #28a745;">Example 4: Using data-target Attribute</strong>
                                            <pre style="margin: 8px 0; white-space: pre-wrap; word-wrap: break-word;"><code>&lt;div id="newsletter-form"&gt;&lt;/div&gt;
&lt;script src="YOUR_FORM_URL.js" 
        data-target="newsletter-form"&gt;&lt;/script&gt;</code></pre>
                                        </div>
                                        
                                        <div style="margin-bottom: 0;">
                                            <strong style="color: #28a745;">Example 5: Complete HTML Page</strong>
                                            <pre style="margin: 8px 0; white-space: pre-wrap; word-wrap: break-word;"><code>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
    &lt;title&gt;Contact Form&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;h1&gt;Contact Us&lt;/h1&gt;
    &lt;div id="contact-form-container"&gt;&lt;/div&gt;
    &lt;script src="YOUR_FORM_URL.js" 
            data-container-id="contact-form-container"&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
                                        </div>
                                    </div>
                                    <div style="margin-top: 12px; font-size: 13px;">
                                        <strong>Note:</strong> Replace <code>YOUR_FORM_URL</code> with your actual form URL from the "Public URL" field above. 
                                        If the URL is not yet available, publish your form first. 
                                        The form will automatically append to the specified container element.
                                    </div>
                                </div>
                                
                                <group>
                                    <field name="logo" widget="image" string="Form Logo"/>
                                </group>
                            </page>
                            
                            <!-- Form Settings Section -->
                            <page string="Form Settings" name="form_settings">
                                <group>
                                    <group string="Display Options">
                                        <field name="show_progress_bar"/>
                                        <field name="hide_header"/>
                                        <field name="show_submit_button"/>
                                        <field name="submit_button_text"/>
                                    </group>
                                    <group string="Custom Styling">
                                        <field name="custom_css" widget="textarea" 
                                               placeholder="/* Add your custom CSS here */"
                                               options="{'rows': 10}"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Messages Section -->
                            <page string="User Messages" name="messages">
                                <group>
                                    <group string="Success Message">
                                        <field name="success_message" placeholder="Thank you! Your submission has been received."/>
                                    </group>
                                    <group string="Error Message">
                                        <field name="error_message" placeholder="An error occurred. Please try again."/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Security Section -->
                            <page string="Security &amp; Access" name="security">
                                <div class="alert alert-warning" role="alert">
                                    <strong>Security Settings:</strong> Configure security features to protect your form from spam and abuse.
                                </div>
                                <group>
                                    <group string="reCAPTCHA Protection">
                                        <field name="enable_captcha"/>
                                        <field name="captcha_site_key" invisible="not enable_captcha" 
                                               placeholder="Your reCAPTCHA Site Key"/>
                                        <field name="captcha_secret_key" invisible="not enable_captcha" 
                                               password="True" placeholder="Your reCAPTCHA Secret Key"/>
                                    </group>
                                    <group string="Rate Limiting &amp; Tokens">
                                        <field name="rate_limit" 
                                               help="Maximum number of submissions allowed per IP address per hour"/>
                                        <field name="token" readonly="1" 
                                               help="Public token for form access"/>
                                        <field name="security_token" readonly="1" 
                                               help="Enhanced security token for form validation"/>
                                        <button name="generate_new_security_token" 
                                                type="object" 
                                                string="Regenerate Security Token" 
                                                class="btn-warning"
                                                help="Generate a new security token (old token will stop working)"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- Email Notifications Section -->
                            <page string="Email Notifications" name="email_notifications">
                                <group>
                                    <group>
                                        <field name="enable_email_notifications"/>
                                        <field name="admin_email" invisible="not enable_email_notifications"/>
                                        <field name="send_confirmation_email" invisible="not enable_email_notifications"/>
                                        <field name="user_email_field_id" invisible="not send_confirmation_email"/>
                                        <field name="confirmation_email_template_id" invisible="not send_confirmation_email"/>
                                        <field name="notification_email_template_id" invisible="not enable_email_notifications"/>
                                    </group>
                                </group>
                                <field name="email_notification_ids" invisible="not enable_email_notifications">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="trigger_type"/>
                                        <field name="email_type"/>
                                        <field name="trigger_field_id"/>
                                        <field name="trigger_value"/>
                                        <field name="recipient_field_id"/>
                                        <field name="email_template_id"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                            
                            <!-- Fields Section -->
                            <page string="Form Fields" name="fields">
                                <div class="alert alert-info" role="alert">
                                    <strong>Note:</strong> For Dropdown, Radio, and Checkbox fields, you need to configure options. 
                                    Click on the field row to edit and use the "Options" tab, or use the "Configure Options" button below.
                                </div>
                                <field name="field_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="label"/>
                                        <field name="field_type"/>
                                        <field name="options_count" invisible="field_type not in ['select', 'radio', 'checkbox']"/>
                                        <field name="options_preview" invisible="field_type not in ['select', 'radio', 'checkbox']"/>
                                        <field name="required"/>
                                        <field name="width"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                                <div class="mt-3">
                                    <button type="object" name="action_configure_options" 
                                            class="btn btn-primary" 
                                            string="Configure Options for Fields"
                                            help="Configure options for dropdown, radio, and checkbox fields">
                                        <i class="fa fa-cog"/> Configure Options
                                    </button>
                                </div>
                            </page>
                            
                            <!-- Field Mappings Section -->
                            <page string="Field Mappings" name="field_mappings">
                                <group>
                                    <field name="target_model_id" readonly="1"/>
                                </group>
                                <field name="field_mapping_ids" context="{'default_form_id': id, 'form_id': id, 'parent_form_id': id}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="form_id" invisible="1" default_focus="1"/>
                                        <field name="form_field_id" domain="[('form_id', '=', parent.id), ('active', '=', True)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                        <field name="model_field" widget="selection" options="{'no_create': True}"/>
                                        <field name="model_field_label" readonly="1"/>
                                        <field name="field_type_compatibility" readonly="1"/>
                                        <field name="label_field"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                                <div class="alert alert-info" role="alert">
                                    <strong>Field Mapping Instructions:</strong>
                                    <ul>
                                        <li>Map form fields to target model fields</li>
                                        <li><strong>Field Type Compatibility:</strong> Only compatible field types can be mapped together</li>
                                        <li>✓ indicates compatible field types, ✗ indicates incompatible types</li>
                                        <li>Only one field can be used as the <strong>Label Field</strong> (marked with ✓)</li>
                                        <li>The label field's value will be used as the record name in the target model</li>
                                        <li>Form fields are automatically filtered to show only fields from this form</li>
                                    </ul>
                                </div>
                                <div class="mt-3">
                                    <button type="object" name="action_validate_field_mappings" 
                                            class="btn btn-info" 
                                            string="Validate Field Mappings"
                                            help="Check all field mappings for type compatibility">
                                        <i class="fa fa-check-circle"/> Validate Mappings
                                    </button>
                                </div>
                            </page>
                            
                            <!-- Submissions Section -->
                            <page string="Submissions" name="submissions">
                                <field name="submission_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="state"/>
                                        <field name="target_record_name"/>
                                        <field name="create_date"/>
                                        <field name="ip_address"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
<!--                    <div class="oe_chatter">-->
<!--                        <field name="message_follower_ids"/>-->
<!--                        <field name="activity_ids"/>-->
<!--                        <field name="message_ids"/>-->
<!--                    </div>-->
                </form>
            </field>
        </record>
        
        <!-- Form Search View -->
        <record id="view_dynamic_form_search" model="ir.ui.view">
            <field name="name">dynamic.form.search</field>
            <field name="model">dynamic.form</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="target_model_id"/>
                    <field name="embed_type"/>
                    <field name="layout"/>
                    <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                    <filter string="Draft" name="draft" domain="[('is_published', '=', False)]"/>
                    <filter string="Ready to Publish" name="ready" domain="[('is_ready', '=', True), ('is_published', '=', False)]"/>
                    <separator/>
                    <filter string="Has Submissions" name="has_submissions" domain="[('submission_count', '>', 0)]"/>
                    <filter string="No Submissions" name="no_submissions" domain="[('submission_count', '=', 0)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Model" name="group_model" context="{'group_by': 'target_model_id'}"/>
                        <filter string="Embed Type" name="group_embed_type" context="{'group_by': 'embed_type'}"/>
                        <filter string="Theme" name="group_theme" context="{'group_by': 'theme'}"/>
                        <filter string="Published" name="group_published" context="{'group_by': 'is_published'}"/>
                    </group>
                </search>
            </field>
        </record>
        
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Field Condition Tree View -->
        <record id="view_dynamic_form_field_condition_tree" model="ir.ui.view">
            <field name="name">dynamic.form.field.condition.tree</field>
            <field name="model">dynamic.form.field.condition</field>
            <field name="arch" type="xml">
                <list string="Field Conditions" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="condition_field_name"/>
                    <field name="condition_field_type"/>
                    <field name="operator"/>
                    <field name="value"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <!-- Field Condition Form View -->
        <record id="view_dynamic_form_field_condition_form" model="ir.ui.view">
            <field name="name">dynamic.form.field.condition.form</field>
            <field name="model">dynamic.form.field.condition</field>
            <field name="arch" type="xml">
                <form string="Field Condition">
                    <sheet>
                        <group>
                            <group>
                                <field name="field_id"/>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="condition_field_id"/>
                                <field name="condition_field_name" readonly="1"/>
                                <field name="condition_field_type" readonly="1"/>
                                <field name="operator"/>
                                <field name="value" placeholder="Enter the value to compare against. For checkboxes, use 'true' or 'false'"/>
                            </group>
                        </group>
                        
                        <div class="alert alert-info" role="alert">
                            <strong>Condition Value Guidelines:</strong>
                            <ul>
                                <li><strong>Text/Email/Textarea:</strong> Enter the exact text to match</li>
                                <li><strong>Number:</strong> Enter a numeric value</li>
                                <li><strong>Dropdown/Radio:</strong> Enter one of the option values exactly</li>
                                <li><strong>Checkbox:</strong> Use 'true' for checked, 'false' for unchecked</li>
                                <li><strong>Date:</strong> Use YYYY-MM-DD format</li>
                                <li><strong>File:</strong> Use 'true' if file is selected, 'false' if not</li>
                            </ul>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Field Condition Search View -->
        <record id="view_dynamic_form_field_condition_search" model="ir.ui.view">
            <field name="name">dynamic.form.field.condition.search</field>
            <field name="model">dynamic.form.field.condition</field>
            <field name="arch" type="xml">
                <search string="Search Field Conditions">
                    <field name="name"/>
                    <field name="condition_field_name"/>
                    <field name="field_id"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Field" name="group_field" context="{'group_by': 'field_id'}"/>
                        <filter string="Operator" name="group_operator" context="{'group_by': 'operator'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Field Condition Action -->
        <record id="action_dynamic_form_field_condition" model="ir.actions.act_window">
            <field name="name">Field Conditions</field>
            <field name="res_model">dynamic.form.field.condition</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first field condition!
                </p>
                <p>
                    Add conditions to control when fields are shown or hidden.
                    Use multiple conditions with AND/OR logic for complex scenarios.
                </p>
            </field>
        </record>
        
    </data>
</odoo>

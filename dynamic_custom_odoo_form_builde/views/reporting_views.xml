<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Analytics Graph View (defined before action) -->
        <record id="view_dynamic_form_analytics_graph" model="ir.ui.view">
            <field name="name">dynamic.form.analytics.graph</field>
            <field name="model">dynamic.form</field>
            <field name="arch" type="xml">
                <graph string="Form Analytics" type="bar" stacked="True">
                    <field name="name" type="row"/>
                    <field name="view_count" type="measure"/>
                    <field name="submission_count" type="measure"/>
                </graph>
            </field>
        </record>
        
        <!-- Analytics Pivot View -->
        <record id="view_dynamic_form_analytics_pivot" model="ir.ui.view">
            <field name="name">dynamic.form.analytics.pivot</field>
            <field name="model">dynamic.form</field>
            <field name="arch" type="xml">
                <pivot string="Form Analytics">
                    <field name="target_model_id" type="row"/>
                    <field name="status" type="col"/>
                    <field name="view_count" type="measure"/>
                    <field name="submission_count" type="measure"/>
                    <field name="conversion_rate" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- Analytics Dashboard Action -->
        <record id="action_dynamic_forms_analytics" model="ir.actions.act_window">
            <field name="name">Analytics Dashboard</field>
            <field name="res_model">dynamic.form</field>
            <field name="view_mode">graph,pivot,list,form</field>
            <field name="view_id" ref="view_dynamic_form_analytics_graph"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    View comprehensive analytics for your dynamic forms!
                </p>
                <p>
                    Analyze form performance, track submissions, monitor conversion rates, and export data for detailed analysis.
                </p>
            </field>
        </record>
        
        <!-- Submission Statistics Graph View (defined before action) -->
        <record id="view_dynamic_form_submission_statistics_graph" model="ir.ui.view">
            <field name="name">dynamic.form.submission.statistics.graph</field>
            <field name="model">dynamic.form.submission</field>
            <field name="arch" type="xml">
                <graph string="Submission Statistics" type="line">
                    <field name="create_date" interval="day" type="row"/>
                    <field name="state" type="col"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>
        
        <!-- Submission Statistics Pivot View -->
        <record id="view_dynamic_form_submission_statistics_pivot" model="ir.ui.view">
            <field name="name">dynamic.form.submission.statistics.pivot</field>
            <field name="model">dynamic.form.submission</field>
            <field name="arch" type="xml">
                <pivot string="Submission Statistics">
                    <field name="form_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="create_date" interval="day" type="col"/>
                    <field name="id" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- Submission Statistics Action -->
        <record id="action_dynamic_forms_submission_statistics" model="ir.actions.act_window">
            <field name="name">Submission Statistics</field>
            <field name="res_model">dynamic.form.submission</field>
            <field name="view_mode">graph,pivot,list,form</field>
            <field name="view_id" ref="view_dynamic_form_submission_statistics_graph"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Analyze submission statistics!
                </p>
                <p>
                    View detailed submission analytics, track trends, filter by form, status, and date range.
                </p>
            </field>
        </record>
        
    </data>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Sequence for form fields -->
        <record id="seq_dynamic_form_field" model="ir.sequence">
            <field name="name">Dynamic Form Field</field>
            <field name="code">dynamic.form.field</field>
            <field name="prefix">FLD</field>
            <field name="padding">3</field>
        </record>
        
        <!-- Sequence for form submissions -->
        <record id="seq_dynamic_form_submission" model="ir.sequence">
            <field name="name">Dynamic Form Submission</field>
            <field name="code">dynamic.form.submission</field>
            <field name="prefix">SUB</field>
            <field name="padding">5</field>
        </record>
        
    </data>
</odoo>

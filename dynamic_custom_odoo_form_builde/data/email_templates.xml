<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Admin Notification Template -->
        <record id="email_template_admin_notification" model="mail.template">
            <field name="name">Dynamic Form - Admin Notification</field>
            <field name="model_id" ref="model_dynamic_form_submission"/>
            <field name="subject">New Form Submission: {{ object.form_name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.form_id.admin_email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>A new submission has been received for the form <strong>{{ object.form_name }}</strong>.</p>
                    
                    <h3>Submission Details:</h3>
                    <ul>
                        <li><strong>Submission ID:</strong> {{ object.name }}</li>
                        <li><strong>Form:</strong> {{ object.form_name }}</li>
                        <li><strong>Submitted:</strong> {{ object.create_date }}</li>
                        <li><strong>IP Address:</strong> {{ object.ip_address or 'Not available' }}</li>
                    </ul>
                    
                    <h3>Form Data:</h3>
                    {{ object.get_formatted_data_html() }}
                    
                    <p>You can view the full submission details in Odoo.</p>
                    
                    <p>Best regards,<br/>{{ user.name }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Default User Confirmation Template -->
        <record id="email_template_user_confirmation" model="mail.template">
            <field name="name">Dynamic Form - User Confirmation</field>
            <field name="model_id" ref="model_dynamic_form_submission"/>
            <field name="subject">Thank you for your submission - {{ object.form_name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear {{ object.get_field_value('name') or 'Valued Customer' }},</p>
                    
                    <p>Thank you for submitting the form <strong>{{ object.form_name }}</strong>. We have received your information and will process it shortly.</p>
                    
                    <h3>Your Submission Summary:</h3>
                    {{ object.get_formatted_data_html() }}
                    
                    <p>If you have any questions, please don't hesitate to contact us.</p>
                    
                    <p>Best regards,<br/>{{ user.company_id.name or 'Our Team' }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Contact Form Notification Template -->
        <record id="email_template_contact_form" model="mail.template">
            <field name="name">Contact Form - Admin Notification</field>
            <field name="model_id" ref="model_dynamic_form_submission"/>
            <field name="subject">New Contact Form Submission from {{ object.get_field_value('name') or 'Unknown' }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.form_id.admin_email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>A new contact form submission has been received.</p>
                    
                    <h3>Contact Information:</h3>
                    <ul>
                        <li><strong>Name:</strong> {{ object.get_field_value('name') or 'Not provided' }}</li>
                        <li><strong>Email:</strong> {{ object.get_field_value('email') or 'Not provided' }}</li>
                        <li><strong>Phone:</strong> {{ object.get_field_value('phone') or 'Not provided' }}</li>
                        <li><strong>Subject:</strong> {{ object.get_field_value('subject') or 'Not provided' }}</li>
                    </ul>
                    
                    <h3>Message:</h3>
                    <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #007bff; margin: 10px 0;">
                        {{ object.get_field_value('message') or 'No message provided' }}
                    </div>
                    
                    <p><strong>Submitted:</strong> {{ object.create_date }}</p>
                    <p><strong>IP Address:</strong> {{ object.ip_address or 'Not available' }}</p>
                    
                    <p>Please respond to this inquiry as soon as possible.</p>
                    
                    <p>Best regards,<br/>{{ user.name }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Job Application Template -->
        <record id="email_template_job_application" model="mail.template">
            <field name="name">Job Application - Admin Notification</field>
            <field name="model_id" ref="model_dynamic_form_submission"/>
            <field name="subject">New Job Application: {{ object.get_field_value('position') or 'Unknown Position' }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.form_id.admin_email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>A new job application has been submitted.</p>
                    
                    <h3>Applicant Information:</h3>
                    <ul>
                        <li><strong>Name:</strong> {{ object.get_field_value('full_name') or 'Not provided' }}</li>
                        <li><strong>Email:</strong> {{ object.get_field_value('email') or 'Not provided' }}</li>
                        <li><strong>Phone:</strong> {{ object.get_field_value('phone') or 'Not provided' }}</li>
                        <li><strong>Position:</strong> {{ object.get_field_value('position') or 'Not provided' }}</li>
                        <li><strong>Experience:</strong> {{ object.get_field_value('experience') or 'Not provided' }} years</li>
                    </ul>
                    
                    <h3>Cover Letter:</h3>
                    <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #28a745; margin: 10px 0;">
                        {{ object.get_field_value('cover_letter') or 'No cover letter provided' }}
                    </div>
                    
                    <p><strong>Submitted:</strong> {{ object.create_date }}</p>
                    
                    <p>Please review this application and schedule an interview if appropriate.</p>
                    
                    <p>Best regards,<br/>{{ user.name }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Event Registration Template -->
        <record id="email_template_event_registration" model="mail.template">
            <field name="name">Event Registration - Admin Notification</field>
            <field name="model_id" ref="model_dynamic_form_submission"/>
            <field name="subject">New Event Registration: {{ object.get_field_value('event_name') or 'Unknown Event' }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.form_id.admin_email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>A new event registration has been received.</p>
                    
                    <h3>Registration Details:</h3>
                    <ul>
                        <li><strong>Event:</strong> {{ object.get_field_value('event_name') or 'Not provided' }}</li>
                        <li><strong>Attendee Name:</strong> {{ object.get_field_value('attendee_name') or 'Not provided' }}</li>
                        <li><strong>Email:</strong> {{ object.get_field_value('email') or 'Not provided' }}</li>
                        <li><strong>Phone:</strong> {{ object.get_field_value('phone') or 'Not provided' }}</li>
                        <li><strong>Number of Guests:</strong> {{ object.get_field_value('guests') or '1' }}</li>
                        <li><strong>Dietary Requirements:</strong> {{ object.get_field_value('dietary_requirements') or 'None' }}</li>
                    </ul>
                    
                    <p><strong>Registration Date:</strong> {{ object.create_date }}</p>
                    
                    <p>Please confirm this registration and send the attendee a confirmation email.</p>
                    
                    <p>Best regards,<br/>{{ user.name }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
        
        <!-- Feedback Form Template -->
        <record id="email_template_feedback_form" model="mail.template">
            <field name="name">Feedback Form - Admin Notification</field>
            <field name="model_id" ref="model_dynamic_form_submission"/>
            <field name="subject">New Feedback: {{ object.get_field_value('rating') or 'Unknown Rating' }} Stars</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="partner_to">{{ object.form_id.admin_email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello,</p>
                    <p>New feedback has been submitted.</p>
                    
                    <h3>Feedback Details:</h3>
                    <ul>
                        <li><strong>Customer Name:</strong> {{ object.get_field_value('customer_name') or 'Anonymous' }}</li>
                        <li><strong>Email:</strong> {{ object.get_field_value('email') or 'Not provided' }}</li>
                        <li><strong>Rating:</strong> {{ object.get_field_value('rating') or 'Not provided' }} stars</li>
                        <li><strong>Category:</strong> {{ object.get_field_value('category') or 'Not provided' }}</li>
                    </ul>
                    
                    <h3>Feedback:</h3>
                    <div style="background-color: #f8f9fa; padding: 15px; border-left: 4px solid #ffc107; margin: 10px 0;">
                        {{ object.get_field_value('feedback') or 'No feedback provided' }}
                    </div>
                    
                    <p><strong>Submitted:</strong> {{ object.create_date }}</p>
                    
                    <p>Please review this feedback and take appropriate action if needed.</p>
                    
                    <p>Best regards,<br/>{{ user.name }}</p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
        
    </data>
</odoo>

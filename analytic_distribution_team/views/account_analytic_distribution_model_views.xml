<odoo>

    <!-- Form view: add team_id alongside the standard criteria -->
    <record id="view_analytic_distribution_model_form_team" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.form.team</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_categ_id']" position="after">
                <field name="team_id"
                       options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- List view: same criterion, optional column -->
    <record id="view_analytic_distribution_model_list_team" model="ir.ui.view">
        <field name="name">account.analytic.distribution.model.list.team</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id" ref="analytic.account_analytic_distribution_model_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_categ_id']" position="after">
                <field name="team_id"
                       optional="show"
                       options="{'no_open': True, 'no_create': True, 'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>

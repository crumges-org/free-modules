<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Terms and Conditions -->
    <record id="view_wb_terms_condition_tree" model="ir.ui.view">
        <field name="name">wb.terms.condition.tree</field>
        <field name="model">wb.terms.condition</field>
        <field name="arch" type="xml">
            <list string="Terms and Conditions">
                <field name="name"/>
                <field name="company_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View for Terms and Conditions -->
    <record id="view_wb_terms_condition_form" model="ir.ui.view">
        <field name="name">wb.terms.condition.form</field>
        <field name="model">wb.terms.condition</field>
        <field name="arch" type="xml">
            <form string="Terms and Conditions">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="term_type" invisible="1"/>
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="tnc_con" widget="html"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action for Terms and Conditions -->
    <record id="action_wb_terms_condition_so" model="ir.actions.act_window">
        <field name="name">Sale Terms and Conditions</field>
        <field name="res_model">wb.terms.condition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_term_type': 'sale'}</field>
        <field name="domain">[('term_type', '=', 'sale')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your custom sales terms and conditions here.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="term_conditions_sale_config_menu"
              name="Sale Terms And Conditions"
              parent="sale.menu_sale_config"
              groups="wb_terms_and_conditions.group_so_tnc"
              action="action_wb_terms_condition_so"/>

    <record id="action_wb_terms_condition_po" model="ir.actions.act_window">
        <field name="name">Purchase Terms and Conditions</field>
        <field name="res_model">wb.terms.condition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_term_type': 'purchase'}</field>
        <field name="domain">[('term_type', '=', 'purchase')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your custom purchase terms and conditions here.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="term_conditions_po_config_menu"
              name="Purchase Terms And Conditions"
              parent="purchase.menu_purchase_config"
              groups="wb_terms_and_conditions.group_po_tnc"
              action="action_wb_terms_condition_po"/>
</odoo>

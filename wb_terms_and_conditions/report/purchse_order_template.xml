<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_purchaseorder_document_custom_tnc"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div>
                <t t-if="o.terms_and_conditions_id and o.show_in_report == 'yes' ">
                    <strong>Terms Details:</strong>
                    <span t-field="o.terms_and_conditions_detail"/>
                </t>
            </div>
        </xpath>
    </template>
    <template id="report_purchaseorder_document_request_tnc"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div>
                <t t-if="o.terms_and_conditions_id and o.show_in_report == 'yes' ">
                    <strong>Terms Details:</strong>
                    <span t-field="o.terms_and_conditions_detail"/>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
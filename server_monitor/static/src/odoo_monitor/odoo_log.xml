<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="server_monitor.OdooLog">
        <div class="o_server_monitor_odoo">
            <t t-if="state.error">
                <div class="o_server_monitor_alert">
                    <span class="o_server_monitor_alert_text" t-esc="state.error.message" />
                    <div class="o_server_monitor_alert_actions">
                        <button
                            type="button"
                            class="o_server_monitor_alert_action"
                            t-on-click="() => this.fetchLogs()"
                            t-att-disabled="state.isFetching"
                        >
                            Retry now
                        </button>
                        <t t-if="state.isFetching">
                            <span class="o_server_monitor_alert_status">Retrying...</span>
                        </t>
                    </div>
                </div>
            </t>

            <div class="o_server_monitor_odoo_header">
                <div>
                    <div class="o_server_monitor_odoo_title">Server Log</div>
                    <div class="o_server_monitor_odoo_meta">
                        <span class="o_server_monitor_odoo_meta_label">Database:</span>
                        <span t-esc="state.dbName || '--'" />
                    </div>
                    <div class="o_server_monitor_odoo_meta">
                        <span class="o_server_monitor_odoo_meta_label">Last updated:</span>
                        <span t-esc="state.lastUpdated || '--'" />
                    </div>
                </div>
                <div class="o_server_monitor_odoo_controls">
                    <label class="o_server_monitor_odoo_label">
                        Lines
                        <input
                            class="o_server_monitor_odoo_input"
                            type="number"
                            min="20"
                            max="2000"
                            step="10"
                            t-att-value="state.logLinesInput"
                            t-on-input="onLogLinesInput"
                            t-on-change="onLogLinesChange"
                        />
                    </label>
                    <label class="o_server_monitor_odoo_label">
                        Search
                        <input
                            class="o_server_monitor_odoo_input o_server_monitor_odoo_input--wide"
                            type="text"
                            placeholder="Filter logs"
                            t-att-value="state.logSearch"
                            t-on-input="onLogSearchInput"
                        />
                    </label>
                </div>
            </div>

            <div class="o_server_monitor_odoo_card o_server_monitor_odoo_card_table">
                <div class="o_server_monitor_odoo_card_title">Server log (tail)</div>
                <t t-if="!state.logs.available">
                    <div class="o_server_monitor_odoo_empty">Log file not available.</div>
                </t>
                <t t-if="state.logs.available">
                    <div class="o_server_monitor_odoo_log_meta">
                        <span>Path:</span>
                        <span t-esc="state.logs.path" />
                    </div>
                    <pre class="o_server_monitor_odoo_log" t-esc="state.logs.lines.join('\n')" />
                </t>
            </div>
        </div>
    </t>
</templates>

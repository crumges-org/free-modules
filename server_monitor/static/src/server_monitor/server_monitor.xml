<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="server_monitor.ServerMonitor">
        <div class="o_server_monitor">
            <div class="o_server_monitor_sidebar">
                <t t-foreach="metricItems" t-as="item" t-key="item.key || item_index">
                    <button
                        type="button"
                        class="o_server_monitor_item"
                        t-att-class="item.key === state.selectedKey ? 'is-active' : ''"
                        t-on-click="() => this.selectMetric(item.key)"
                    >
                        <div class="o_server_monitor_item_title">
                            <span class="o_server_monitor_item_label" t-esc="item.label" />
                            <t t-if="item.subLabel">
                                <span
                                    class="o_server_monitor_item_sublabel"
                                    t-esc="item.subLabel"
                                />
                            </t>
                        </div>
                        <div class="o_server_monitor_item_value" t-esc="item.value" />
                    </button>
                </t>
            </div>

            <div class="o_server_monitor_chart">
                <t t-if="state.error">
                    <div class="o_server_monitor_alert">
                        <span class="o_server_monitor_alert_text" t-esc="state.error.message" />
                        <div class="o_server_monitor_alert_actions">
                            <button
                                type="button"
                                class="o_server_monitor_alert_action"
                                t-on-click="() => this.fetchMetrics()"
                                t-att-disabled="state.isFetching"
                            >
                                Retry now
                            </button>
                            <t t-if="state.isFetching">
                                <span class="o_server_monitor_alert_status">Retrying...</span>
                            </t>
                        </div>
                    </div>
                </t>
                <div class="o_server_monitor_chart_header">
                    <div class="o_server_monitor_chart_heading">
                        <div class="o_server_monitor_chart_title" t-esc="selectedTitle" />
                        <div class="o_server_monitor_chart_meta">
                            <span class="o_server_monitor_chart_meta_label">Last updated:</span>
                            <span t-esc="state.lastUpdated || '--'" />
                        </div>
                    </div>
                    <div class="o_server_monitor_stats">
                        <t t-foreach="state.stats" t-as="stat" t-key="stat.label || stat_index">
                            <div class="o_server_monitor_stat">
                                <span class="o_server_monitor_stat_label" t-esc="stat.label" />
                                <span class="o_server_monitor_stat_value" t-esc="stat.value" />
                            </div>
                        </t>
                    </div>
                </div>
                <div class="o_server_monitor_chart_controls">
                    <div class="o_server_monitor_thresholds">
                        <span class="o_server_monitor_thresholds_label">Alerts</span>
                        <label class="o_server_monitor_threshold">
                            CPU %
                            <input
                                class="o_server_monitor_threshold_input"
                                type="number"
                                min="1"
                                max="100"
                                step="1"
                                t-att-value="state.alertInputs.cpuMax"
                                t-on-input="(ev) => this.onAlertInputChange('cpuMax', ev)"
                                t-on-change="(ev) => this.onAlertThresholdChange('cpuMax', ev)"
                            />
                        </label>
                        <label class="o_server_monitor_threshold">
                            RAM %
                            <input
                                class="o_server_monitor_threshold_input"
                                type="number"
                                min="1"
                                max="100"
                                step="1"
                                t-att-value="state.alertInputs.ramMax"
                                t-on-input="(ev) => this.onAlertInputChange('ramMax', ev)"
                                t-on-change="(ev) => this.onAlertThresholdChange('ramMax', ev)"
                            />
                        </label>
                        <label class="o_server_monitor_threshold">
                            Disk %
                            <input
                                class="o_server_monitor_threshold_input"
                                type="number"
                                min="1"
                                max="100"
                                step="1"
                                t-att-value="state.alertInputs.diskMax"
                                t-on-input="(ev) => this.onAlertInputChange('diskMax', ev)"
                                t-on-change="(ev) => this.onAlertThresholdChange('diskMax', ev)"
                            />
                        </label>
                    </div>
                    <t t-if="state.alerts.length">
                        <div class="o_server_monitor_alerts">
                            <t t-foreach="state.alerts" t-as="alert" t-key="(alert.label || 'alert') + '-' + alert_index">
                                <div class="o_server_monitor_alert_chip">
                                    <span class="o_server_monitor_alert_label" t-esc="alert.label" />
                                    <span class="o_server_monitor_alert_value" t-esc="alert.value" />
                                    <span class="o_server_monitor_alert_threshold" t-esc="'/' + alert.threshold" />
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
                <div class="o_server_monitor_chart_canvas">
                    <canvas t-ref="canvas" />
                </div>

                <div class="o_server_monitor_details">
                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">System</div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Uptime</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatUptime(state.system.uptime)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Boot time</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatTimestamp(state.system.bootTime)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Load avg</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatLoadAvg(state.loadAvg)" />
                        </div>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">Processes</div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Total</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatNumber(state.processes.total)" />
                        </div>
                        <div class="o_server_monitor_detail_subtitle">Top CPU</div>
                        <t t-if="!state.processes.top_cpu.length">
                            <div class="o_server_monitor_detail_note">Not available</div>
                        </t>
                        <t t-foreach="state.processes.top_cpu" t-as="proc" t-key="proc.pid || proc_index">
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label" t-esc="proc.name + ' (' + proc.pid + ')'" />
                                <span class="o_server_monitor_detail_value" t-esc="formatPercent(proc.cpu_percent)" />
                            </div>
                        </t>
                        <div class="o_server_monitor_detail_subtitle">Top Memory</div>
                        <t t-if="!state.processes.top_memory.length">
                            <div class="o_server_monitor_detail_note">Not available</div>
                        </t>
                        <t t-foreach="state.processes.top_memory" t-as="proc" t-key="'mem-' + (proc.pid || proc_index)">
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label" t-esc="proc.name + ' (' + proc.pid + ')'" />
                                <span class="o_server_monitor_detail_value" t-esc="formatPercent(proc.memory_percent)" />
                            </div>
                        </t>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">CPU</div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Frequency</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatCpuFreq(state.cpuFreq)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Context switches</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatNumber(state.cpuStats.ctx_switches)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Interrupts</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatNumber(state.cpuStats.interrupts)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Soft interrupts</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatNumber(state.cpuStats.soft_interrupts)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Syscalls</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatNumber(state.cpuStats.syscalls)" />
                        </div>
                        <div class="o_server_monitor_detail_subtitle">Per core</div>
                        <div class="o_server_monitor_detail_grid">
                            <t t-if="!state.cpuPerCore.length">
                                <div class="o_server_monitor_detail_note">Not available</div>
                            </t>
                            <t t-foreach="state.cpuPerCore" t-as="core" t-key="core_index">
                                <div class="o_server_monitor_detail_chip">
                                    <span t-esc="'Core ' + (coreIndex + 1)" />
                                    <span t-esc="formatPercent(core)" />
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">GPU</div>
                        <t t-if="!state.gpus.length">
                            <div class="o_server_monitor_detail_note">Not available</div>
                        </t>
                        <t t-foreach="state.gpus" t-as="gpu" t-key="gpu.id || gpu_index">
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label" t-esc="'GPU ' + (gpu.name || '')" />
                                <span class="o_server_monitor_detail_value" t-esc="gpu.vendor || 'gpu'" />
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">Utilization</span>
                                <span class="o_server_monitor_detail_value" t-esc="formatPercent(gpu.utilization)" />
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">Memory</span>
                                <span class="o_server_monitor_detail_value">
                                    <t t-esc="formatMaybeGB(gpu.memoryUsed)" />
                                    <t t-esc="' / ' + formatMaybeGB(gpu.memoryTotal)" />
                                    <t t-esc="' (' + formatPercent(gpu.memoryPercent) + ')'" />
                                </span>
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">Temperature</span>
                                <span class="o_server_monitor_detail_value" t-esc="formatTemperature(gpu.temperature)" />
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">Fan</span>
                                <span class="o_server_monitor_detail_value" t-esc="formatPercent(gpu.fanSpeed)" />
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">Power</span>
                                <span class="o_server_monitor_detail_value" t-esc="formatWatts(gpu.powerDraw)" />
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">Clock</span>
                                <span class="o_server_monitor_detail_value">
                                    <t t-esc="formatMHz(gpu.clockSm)" />
                                    <t t-esc="' / ' + formatMHz(gpu.clockMem)" />
                                </span>
                            </div>
                        </t>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">Memory</div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Available</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.memory.available)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Free</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.memory.free)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Cached</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.memory.cached)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Buffers</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.memory.buffers)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Shared</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.memory.shared)" />
                        </div>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">Swap</div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Used</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.swap.used)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Free</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatGB(state.swap.free)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Percent</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatPercent(state.swap.percent)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Swap in</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatMB(state.swap.sin)" />
                        </div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Swap out</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatMB(state.swap.sout)" />
                        </div>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">Disk IO</div>
                        <t t-if="!state.diskIo.length">
                            <div class="o_server_monitor_detail_note">Not available</div>
                        </t>
                        <t t-foreach="state.diskIo" t-as="disk" t-key="disk.name || disk_index">
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label" t-esc="disk.name" />
                                <span class="o_server_monitor_detail_value">
                                    <t t-esc="'R: ' + disk.readMbs.toFixed(2) + ' MB/s'" />
                                    <t t-esc="' / W: ' + disk.writeMbs.toFixed(2) + ' MB/s'" />
                                </span>
                            </div>
                        </t>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">Sensors</div>
                        <t t-if="state.sensors.temperatures.length">
                            <div class="o_server_monitor_detail_subtitle">Temperatures</div>
                            <t t-foreach="state.sensors.temperatures" t-as="temp" t-key="(temp.sensor || '') + (temp.label || '') + temp_index">
                                <div class="o_server_monitor_detail_item">
                                    <span class="o_server_monitor_detail_label" t-esc="temp.label" />
                                    <span class="o_server_monitor_detail_value" t-esc="formatTemperature(temp.current)" />
                                </div>
                            </t>
                        </t>
                        <t t-if="state.sensors.fans.length">
                            <div class="o_server_monitor_detail_subtitle">Fans</div>
                            <t t-foreach="state.sensors.fans" t-as="fan" t-key="(fan.sensor || '') + (fan.label || '') + fan_index">
                                <div class="o_server_monitor_detail_item">
                                    <span class="o_server_monitor_detail_label" t-esc="fan.label" />
                                    <span class="o_server_monitor_detail_value" t-esc="formatRpm(fan.current)" />
                                </div>
                            </t>
                        </t>
                        <div class="o_server_monitor_detail_subtitle">Battery</div>
                        <div class="o_server_monitor_detail_item">
                            <span class="o_server_monitor_detail_label">Status</span>
                            <span class="o_server_monitor_detail_value" t-esc="formatBattery(state.sensors.battery)" />
                        </div>
                        <t t-if="!state.sensors.temperatures.length and !state.sensors.fans.length and !state.sensors.battery">
                            <div class="o_server_monitor_detail_note">Not available</div>
                        </t>
                    </div>

                    <div class="o_server_monitor_detail_section">
                        <div class="o_server_monitor_detail_title">Network</div>
                        <t t-if="!state.networkAdapters.length">
                            <div class="o_server_monitor_detail_note">Not available</div>
                        </t>
                        <t t-foreach="state.networkAdapters" t-as="adapter" t-key="adapter.name || adapter_index">
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label" t-esc="adapter.name" />
                                <span class="o_server_monitor_detail_value">
                                    <t t-esc="'Speed ' + adapter.speed + ' Mbps / MTU ' + adapter.mtu + ' / ' + adapter.duplex" />
                                </span>
                            </div>
                            <div class="o_server_monitor_detail_item">
                                <span class="o_server_monitor_detail_label">IPs</span>
                                <span class="o_server_monitor_detail_value" t-esc="adapter.ips.length ? adapter.ips.join(', ') : '--'" />
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>

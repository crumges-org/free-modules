<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_city_district_view_list">
        <field name="name">res.city.district.list</field>
        <field name="model">res.city.district</field>
        <field name="arch" type="xml">
            <list editable="top" sample="1">
                <field name="zip_code"/>
                <field name="name"/>
                <field name="city_id"/>
                <field name="state_id"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_res_city_district">
        <field name="name">Districts</field>
        <field name="res_model">res.city.district</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face ">
                Add City's Districts
            </p>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_locality_view_list" model="ir.ui.view">
            <field name="name">res.locality.list</field>
            <field name="model">res.locality</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="state_id"/>
                    <field name="country_id"/>
                </list>
            </field>
        </record>

        <record id="res_locality_view_form" model="ir.ui.view">
            <field name="name">res.locality.form</field>
            <field name="model">res.locality</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h2>
                                <field name="name" placeholder="City Name"/>
                            </h2>
                        </div>
                        <group col="4">
                            <field name="code"/>
                            <field name="country_id"/>
                            <field name="state_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="res_locality_view_filter" model="ir.ui.view">
            <field name="name">res.locality.search</field>
            <field name="model">res.locality</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="state_id"/>
                    <field name="country_id"/>
                    <group expand="0" string="Group By...">
                        <filter name="state_id" string="State" context="{'group_by':'state_id'}"/>
                        <filter name="country_id" string="Country" context="{'group_by':'country_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_res_locality_view" model="ir.actions.act_window">
            <field name="name">Localities</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.locality</field>
            <field name="view_mode">list,form</field>
            <field name="help">
                Display and manage the list of all localities that can be assigned to
                your partner records.
            </field>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_axoline_layout" model="ir.module.category">
        <field name="name">Axoline Layout</field>
        <field name="description">Manage Axoline PDF Layout Editor.</field>
        <field name="sequence">95</field>
    </record>

    <record id="group_axoline_layout_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="category_id" ref="module_category_axoline_layout"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

<odoo>
    <data noupdate="1">
        <record id="group_private_contact" model="res.groups">
            <field name="name">Private Contact Access</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <record id="private_contact_rule" model="ir.rule">
        <field name="name">Private Contact Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[('is_private', '=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="private_contact_rule_allow" model="ir.rule">
        <field name="name">Private Contact Rule</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('private_contact.group_private_contact'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>

<odoo>
    <record id="view_partner_form_private" model="ir.ui.view">
        <field name="name">res.partner.form.private</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="is_private" groups="private_contact.group_private_contact"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_private_contact" model="ir.ui.view">
        <field name="name">res.partner.search.private.contact</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="before">
                <separator groups="private_contact.group_private_contact"/>
                <filter string="Private Contacts"
                        name="private"
                        domain="[('is_private', '=', True)]"
                        groups="private_contact.group_private_contact"/>
                <filter string="Non-Private Contacts"
                        name="public"
                        domain="[('is_private', '=', False)]"
                        groups="private_contact.group_private_contact"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="stage" name="Escenario del tema de acceso">
        <style t-out="theme['css']"/>
        <div t-attf-class="c_login_stage c_login_layout_#{theme['layout']} c_login_card_#{theme['card_mode']}
                           #{'c_login_has_image' if theme['image_url'] else ''}
                           #{'c_login_own_logo' if theme['use_own_logo'] else ''}
                           #{'' if theme['show_reset_password'] else 'c_login_hide_reset'}
                           #{'' if theme['show_signup'] else 'c_login_hide_signup'}
                           #{'' if theme['show_db_selector'] else 'c_login_hide_db'}
                           #{'' if theme['show_db_manager'] else 'c_login_hide_dbmanager'}">
            <div class="c_login_bg"/>
            <t t-if="theme['layout'] == 'aurora'">
                <span class="c_login_orb c_login_orb_a"/>
                <span class="c_login_orb c_login_orb_b"/>
                <span class="c_login_orb c_login_orb_c"/>
            </t>
            <aside t-if="theme['layout'] == 'split'" class="c_login_aside">
                <div class="c_login_aside_top">
                    <img t-if="theme['use_own_logo']" class="c_login_aside_logo" t-att-src="theme['logo_url']" alt="Logo"/>
                    <img t-else="" class="c_login_aside_logo" src="/web/binary/company_logo" alt="Logo"/>
                </div>
                <div class="c_login_aside_main">
                    <h1 t-if="theme['headline']" class="c_login_aside_headline" t-out="theme['headline']"/>
                    <p t-if="theme['tagline'] and is_login_page" class="c_login_aside_tagline" t-out="theme['tagline']"/>
                </div>
                <p t-if="theme['footer_note']" class="c_login_aside_note" t-out="theme['footer_note']"/>
            </aside>
        </div>
    </template>

    <template id="brand" name="Marca dentro del formulario de acceso">
        <div t-if="theme['layout'] != 'split'" class="c_login_brand">
            <img t-if="theme['use_own_logo']" class="c_login_brand_logo" t-att-src="theme['logo_url']" alt="Logo"/>
            <h1 t-if="theme['headline']" class="c_login_headline" t-out="theme['headline']"/>
            <p t-if="theme['tagline'] and is_login_page" class="c_login_tagline" t-out="theme['tagline']"/>
        </div>
    </template>

    <template id="login_layout" inherit_id="web.login_layout" name="Tema de la pantalla de acceso">
        <xpath expr="//div[hasclass('container')]" position="before">
            <t t-set="c_login_theme" t-value="request.env['c.login.theme'].sudo()._render_context()"/>
            <t t-set="is_login_page" t-value="request.httprequest.path == '/web/login'"/>
            <t t-if="c_login_theme" t-call="c_login_theme.stage">
                <t t-set="theme" t-value="c_login_theme"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('card-body')]/div[1]" position="after">
            <t t-if="c_login_theme" t-call="c_login_theme.brand">
                <t t-set="theme" t-value="c_login_theme"/>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('border-top')]" position="inside">
            <div t-if="c_login_theme and c_login_theme['footer_note'] and c_login_theme['layout'] != 'split'"
                 class="c_login_footnote" t-out="c_login_theme['footer_note']"/>
        </xpath>
    </template>

    <template id="preview_page" name="Vista previa de la pantalla de acceso">
        <html lang="es" style="height: 100%;">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Vista previa</title>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
            </head>
            <body class="o_home_menu_background c_login_preview">
                <t t-set="is_login_page" t-value="True"/>
                <t t-call="c_login_theme.stage"/>
                <div class="container py-5">
                    <div style="max-width: 300px;" class="card border-0 mx-auto bg-100 rounded-0 shadow-sm bg-white o_database_list">
                        <div class="card-body">
                            <div class="text-center pb-3 border-bottom mb-4">
                                <img alt="Logo" style="max-height:120px; max-width: 100%; width:auto"
                                     src="/web/binary/company_logo"/>
                            </div>
                            <t t-call="c_login_theme.brand"/>
                            <form role="form" class="oe_login_form" onsubmit="return false;">
                                <div class="mb-3">
                                    <label for="db" class="col-form-label">Base de datos</label>
                                    <div class="input-group">
                                        <input type="text" id="db" class="form-control" readonly="readonly" tabindex="-1" t-att-value="db"/>
                                        <a role="button" href="#" tabindex="-1" class="btn border border-start-0">Elegir <i class="fa fa-database"/></a>
                                    </div>
                                </div>
                                <div class="mb-3 field-login">
                                    <label for="login" class="form-label d-flex justify-content-between">Correo electrónico</label>
                                    <input type="text" id="login" class="form-control" placeholder="nombre@empresa.com" readonly="readonly" tabindex="-1"/>
                                </div>
                                <div class="o_caps_lock_warning">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <label for="password" class="form-label">Contraseña</label>
                                        <a class="btn btn-link btn-sm" href="/web/reset_password" tabindex="-1">Restablecer contraseña</a>
                                    </div>
                                    <div class="input-group mb-1">
                                        <input type="password" id="password" class="form-control" value="123456789" readonly="readonly" tabindex="-1"/>
                                        <button type="button" class="btn btn-sm border border-start-0 o_show_password" tabindex="-1">
                                            <i class="fa fa-eye"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="oe_login_buttons text-center d-grid mb-1 pt-3">
                                    <button type="button" class="btn btn-primary" tabindex="-1">Iniciar sesión</button>
                                    <a class="btn btn-link btn-sm mt-2" href="/web/signup" tabindex="-1">¿No tienes una cuenta?</a>
                                </div>
                            </form>
                            <div class="text-center small mt-4 pt-3 border-top">
                                <a class="border-end pe-2 me-1" href="/web/database/manager" tabindex="-1">Gestionar bases de datos</a>
                                <a href="#" tabindex="-1">Powered by <span>Odoo</span></a>
                                <div t-if="theme and theme['footer_note'] and theme['layout'] != 'split'"
                                     class="c_login_footnote" t-out="theme['footer_note']"/>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Git Source Repository Tree View -->
    <record id="view_git_source_repo_tree" model="ir.ui.view">
        <field name="name">git.source.repo.tree</field>
        <field name="model">git.source.repo</field>
        <field name="arch" type="xml">
            <list string="Git Repositories" decoration-muted="not is_active">
                <field name="name" />
                <field name="provider" />
                <field name="branch" />
                <field name="auth_type" />
                <field name="is_active" />
                <field name="workspace_count" />
                <field name="last_commit" />
            </list>
        </field>
    </record>

    <!-- Git Source Repository Form View -->
    <record id="view_git_source_repo_form" model="ir.ui.view">
        <field name="name">git.source.repo.form</field>
        <field name="model">git.source.repo</field>
        <field name="arch" type="xml">
            <form string="Git Repository">
                <header>
                    <button name="action_test_connect" string="Test Connect" type="object"
                        class="oe_highlight" groups="base.group_system" />
                    <button name="action_clone_now" string="Clone/Update Now" type="object"
                        class="btn-primary" groups="base.group_system" />
                    <field name="is_active" widget="boolean_toggle" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workspaces" type="object" class="oe_stat_button"
                            icon="fa-folder-open">
                            <field name="workspace_count" widget="statinfo" string="Workspaces" />
                        </button>
                    </div>
                    <group>
                        <group name="repository_info">
                            <field name="name" placeholder="e.g., Odoo Core 17.0" />
                            <field name="provider" />
                            <field name="repo_url" placeholder="https://github.com/odoo/odoo.git"
                                widget="url" />
                            <field name="branch" placeholder="main or 17.0" />
                        </group>
                        <group name="authentication">
                            <field name="auth_type" />
                            <field name="token_param"
                                placeholder="e.g., git_mgr.token.github"
                                invisible="auth_type != 'token'" />
                            <field name="ssh_private_key_param"
                                placeholder="e.g., git_mgr.ssh_key_path"
                                invisible="auth_type != 'ssh'" />
                        </group>
                    </group>
                    <group>
                        <field name="last_commit" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes or documentation..." />
                        </page>
                        <page string="Entity Links" name="entity_links">
                            <field name="entity_link_ids">
                                <list>
                                    <field name="entity_id" />
                                    <field name="sequence" />
                                    <field name="enabled" />
                                    <field name="last_update_status" />
                                    <field name="last_updated" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Git Source Repository Search View -->
    <record id="view_git_source_repo_search" model="ir.ui.view">
        <field name="name">git.source.repo.search</field>
        <field name="model">git.source.repo</field>
        <field name="arch" type="xml">
            <search string="Search Repositories">
                <field name="name" string="Repository" />
                <field name="repo_url" />
                <field name="branch" />
                <field name="provider" />
                <filter string="Active" name="active" domain="[('is_active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]" />
                <separator />
                <filter string="GitHub" name="github" domain="[('provider', '=', 'github')]" />
                <filter string="GitLab" name="gitlab" domain="[('provider', '=', 'gitlab')]" />
                <filter string="Bitbucket" name="bitbucket"
                    domain="[('provider', '=', 'bitbucket')]" />
                <group expand="0" string="Group By">
                    <filter string="Provider" name="group_provider"
                        context="{'group_by': 'provider'}" />
                    <filter string="Authentication Type" name="group_auth"
                        context="{'group_by': 'auth_type'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Git Source Repository Action -->
    <record id="action_git_source_repo" model="ir.actions.act_window">
        <field name="name">Repositories</field>
        <field name="res_model">git.source.repo</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Git Repository
            </p>
            <p>
                Add Git repositories (GitHub, GitLab, Bitbucket, or generic Git) to manage source
                code per entity.
            </p>
        </field>
    </record>

</odoo>
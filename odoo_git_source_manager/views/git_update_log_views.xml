<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Git Update Log Tree View -->
    <record id="view_git_update_log_tree" model="ir.ui.view">
        <field name="name">git.update.log.tree</field>
        <field name="model">git.update.log</field>
        <field name="arch" type="xml">
            <list string="Update Logs" decoration-success="result == 'success'"
                decoration-danger="result == 'failure'" create="false" edit="false">
                <field name="timestamp" />
                <field name="workspace_id" />
                <field name="entity_id" />
                <field name="repo_id" />
                <field name="action" />
                <field name="result" />
                <field name="commit_hash" />
                <field name="message" />
            </list>
        </field>
    </record>

    <!-- Git Update Log Form View -->
    <record id="view_git_update_log_form" model="ir.ui.view">
        <field name="name">git.update.log.form</field>
        <field name="model">git.update.log</field>
        <field name="arch" type="xml">
            <form string="Update Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group name="log_info">
                            <field name="timestamp" />
                            <field name="workspace_id" />
                            <field name="entity_id" />
                            <field name="repo_id" />
                        </group>
                        <group name="git_info">
                            <field name="action" />
                            <field name="result" />
                            <field name="commit_hash" widget="char" class="text-monospace" />
                        </group>
                    </group>
                    <group>
                        <field name="message" widget="text" class="text-monospace" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Git Update Log Search View -->
    <record id="view_git_update_log_search" model="ir.ui.view">
        <field name="name">git.update.log.search</field>
        <field name="model">git.update.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="workspace_id" />
                <field name="entity_id" />
                <field name="repo_id" />
                <filter string="Success" name="success" domain="[('result', '=', 'success')]" />
                <filter string="Failure" name="failure" domain="[('result', '=', 'failure')]" />
                <separator />
                <filter string="Clone" name="clone" domain="[('action', '=', 'clone')]" />
                <filter string="Pull" name="pull" domain="[('action', '=', 'pull')]" />
                <separator />
                <filter string="Today" name="today"
                    domain="[('timestamp', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]" />
                <filter string="Last 7 Days" name="last_week"
                    domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <filter string="Last 30 Days" name="last_month"
                    domain="[('timestamp', '&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]" />
                <group expand="0" string="Group By">
                    <filter string="Workspace" name="group_workspace"
                        context="{'group_by': 'workspace_id'}" />
                    <filter string="Entity" name="group_entity" context="{'group_by': 'entity_id'}" />
                    <filter string="Repository" name="group_repo" context="{'group_by': 'repo_id'}" />
                    <filter string="Action" name="group_action" context="{'group_by': 'action'}" />
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}" />
                    <filter string="Date" name="group_date" context="{'group_by': 'timestamp'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Git Update Log Action -->
    <record id="action_git_update_log" model="ir.actions.act_window">
        <field name="name">Update Logs</field>
        <field name="res_model">git.update.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_last_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No update logs yet
            </p>
            <p>
                Update logs will appear here when you run updates on workspaces.
            </p>
        </field>
    </record>

</odoo>
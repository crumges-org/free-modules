<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_git_manager_root"
        name="Git Source Manager"
        sequence="100"
        groups="group_git_manager_user"
        web_icon="odoo_git_source_manager,static/description/icon.png" />

    <!-- Repositories Menu -->
    <menuitem id="menu_git_repositories"
        name="Repositories"
        parent="menu_git_manager_root"
        action="action_git_source_repo"
        sequence="10" />

    <!-- Entity Links Menu -->
    <menuitem id="menu_git_entity_links"
        name="Entity Links"
        parent="menu_git_manager_root"
        action="action_git_entity_link"
        sequence="20" />

    <!-- Workspaces Menu -->
    <menuitem id="menu_git_workspaces"
        name="Workspaces"
        parent="menu_git_manager_root"
        action="action_git_workspace"
        sequence="30" />

    <!-- Update Logs Menu -->
    <menuitem id="menu_git_update_logs"
        name="Update Logs"
        parent="menu_git_manager_root"
        action="action_git_update_log"
        sequence="40" />

    <!-- Configuration Menu (Settings submenu) -->
    <menuitem id="menu_git_configuration"
        name="Configuration"
        parent="menu_git_manager_root"
        sequence="100"
        groups="base.group_system" />

    <!-- System Parameters Shortcut -->
    <record id="action_git_config_parameters" model="ir.actions.act_window">
        <field name="name">Git Manager Parameters</field>
        <field name="res_model">ir.config_parameter</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('key', '=like', 'git_mgr.%')]</field>
        <field name="context">{'default_key': 'git_mgr.'}</field>
    </record>

    <menuitem id="menu_git_config_parameters"
        name="System Parameters"
        parent="menu_git_configuration"
        action="action_git_config_parameters"
        sequence="10" />

</odoo>
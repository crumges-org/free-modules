<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Git Entity Link Tree View -->
    <record id="view_git_entity_link_tree" model="ir.ui.view">
        <field name="name">git.entity.link.tree</field>
        <field name="model">git.entity.link</field>
        <field name="arch" type="xml">
            <list string="Entity Links" decoration-muted="not enabled">
                <field name="sequence" widget="handle" />
                <field name="entity_id" />
                <field name="repo_id" />
                <field name="workspace_path" />
                <field name="enabled" />
                <field name="last_update_status" decoration-success="last_update_status == 'ok'"
                    decoration-danger="last_update_status == 'failed'"
                    decoration-warning="last_update_status == 'updating'" />
                <field name="last_updated" />
                <button name="action_update_workspace" string="Update" type="object"
                    icon="fa-refresh" class="btn-link" />
            </list>
        </field>
    </record>

    <!-- Git Entity Link Form View -->
    <record id="view_git_entity_link_form" model="ir.ui.view">
        <field name="name">git.entity.link.form</field>
        <field name="model">git.entity.link</field>
        <field name="arch" type="xml">
            <form string="Entity Link">
                <header>
                    <button name="action_update_workspace" string="Update Workspace" type="object"
                        class="oe_highlight" invisible="not enabled" />
                    <button name="action_view_workspace" string="View Workspace" type="object" />
                    <button name="action_view_logs" string="View Logs" type="object" />
                    <field name="enabled" widget="boolean_toggle" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"></i>
                        <strong>Workspace Path:</strong>
                        Automatically computed from entity and repository names. Configure base path
                        in System Parameters: <code>git_mgr.workspace_base_path</code>
                        <br />
                        <small>
                        Windows default: <code>C:\ProgramData\Odoo\GitWorkspaces</code> | Linux
                        default: <code>/var/lib/odoo/gitworkspaces</code>
                        </small>
                    </div>
                    <group>
                        <group name="link_info">
                            <field name="entity_id" options="{'no_create': True}" />
                            <field name="repo_id" options="{'no_create': True}" />
                            <field name="sequence" />
                        </group>
                        <group name="workspace_info">
                            <field name="workspace_path" readonly="1" widget="char"
                                class="text-monospace" />
                            <field name="workspace_id" readonly="1" />
                            <field name="last_update_status" readonly="1" />
                            <field name="last_updated" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Git Entity Link Search View -->
    <record id="view_git_entity_link_search" model="ir.ui.view">
        <field name="name">git.entity.link.search</field>
        <field name="model">git.entity.link</field>
        <field name="arch" type="xml">
            <search string="Search Entity Links">
                <field name="entity_id" />
                <field name="repo_id" />
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]" />
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]" />
                <separator />
                <filter string="Status: OK" name="status_ok"
                    domain="[('last_update_status', '=', 'ok')]" />
                <filter string="Status: Failed" name="status_failed"
                    domain="[('last_update_status', '=', 'failed')]" />
                <group expand="0" string="Group By">
                    <filter string="Entity" name="group_entity" context="{'group_by': 'entity_id'}" />
                    <filter string="Repository" name="group_repo" context="{'group_by': 'repo_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Git Entity Link Action -->
    <record id="action_git_entity_link" model="ir.actions.act_window">
        <field name="name">Entity Links</field>
        <field name="res_model">git.entity.link</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Link a Repository to an Entity
            </p>
            <p>
                Create entity links to assign Git repositories to specific entities
                (companies/databases).
            </p>
        </field>
    </record>

</odoo>
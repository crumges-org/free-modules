<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="knowledge_guide_book_create_wizard_form" model="ir.ui.view">
        <field name="name">knowledge.guide.book.create.wizard.form</field>
        <field name="model">knowledge.guide.book.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Book from Pages">
                <field name="has_blocked" invisible="1"/>
                <sheet>
                    <group>
                        <field name="name" placeholder="My new book"/>
                        <field name="slug" placeholder="my-new-book"/>
                    </group>
                    <notebook>
                        <page string="Selected pages" name="selected_pages">
                            <field name="page_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="book_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Conflicts" name="conflicts"
                              invisible="not has_blocked">
                            <div class="alert alert-warning" role="alert">
                                <strong>Some selected pages already belong to another book.</strong>
                                <br/>
                                Creation will be blocked. Detach them from their
                                current book first, or remove them from the
                                selection above.
                            </div>
                            <field name="blocked_page_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="book_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_book"
                            string="Create book"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="knowledge_guide_book_create_wizard_action" model="ir.actions.act_window">
        <field name="name">Create book from selection</field>
        <field name="res_model">knowledge.guide.book.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Send wizard form view -->
    <record id="view_knowledge_guide_send_wizard_form" model="ir.ui.view">
        <field name="name">knowledge.guide.send.wizard.form</field>
        <field name="model">knowledge.guide.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send the guide by email">
                <group>
                    <field name="book_id" invisible="1"/>
                    <field name="partner_ids" widget="many2many_tags_email"
                           placeholder="Select recipients..."
                           options="{'no_create': True, 'no_create_edit': True}"
                           context="{'show_email': True, 'form_view_ref': 'base.view_partner_simple_form'}"/>
                </group>
                <group>
                    <field name="subject" placeholder="Email subject"/>
                </group>
                <group>
                    <field name="body" widget="html"
                           placeholder="Write your message..."
                           options="{'codeview': true, 'sandboxedPreview': true}"/>
                </group>
                <footer>
                    <button string="Send" name="action_send"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

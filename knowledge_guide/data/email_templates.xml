<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Email template used to send the user guide.

        Anti-spam guidelines applied:
        - Plain subject without exclamation marks or excessive capitals
        - Simple body with mostly text and minimal styling
        - A single link (the guide URL)
        - No images
        - No spammy words (free, urgent, click here, ...)
        - Simple HTML structure (no nested tables)
        - Healthy text/HTML ratio
        - Footer that clearly identifies the sender

        Odoo 19 syntax:
        - subject / email_from : inline_template => {{ object.field }}
        - body_html : QWeb => t-out, t-if, t-foreach
    -->
    <record id="email_template_send_guide" model="mail.template">
        <field name="name">Send User Guide</field>
        <field name="model_id" ref="model_knowledge_guide_book"/>
        <field name="subject">Your user guide - {{ object.name }}</field>
        <field name="email_from">{{ (object.env.user.email_formatted or user.email_formatted) }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; font-size: 14px; color: #333333; line-height: 1.6; max-width: 600px; margin: 0 auto;">
    <p>Hello,</p>

    <p>Please find below the link to access your user guide.</p>

    <p><strong>Guide:</strong> <t t-out="object.name"/></p>

    <p><strong>Open the guide:</strong><br/>
    <a t-att-href="object.tracked_url or object.public_url"
       style="color: #714B67; text-decoration: none;">
        <t t-out="object.tracked_url or object.public_url"/>
    </a></p>

    <p>This guide contains <t t-out="object.page_count"/> documentation pages
    designed to help you get up to speed with your tool.</p>

    <p>The guide is accessible directly from your browser, with no
    authentication required. You can read it at any time and share it
    with your colleagues.</p>

    <p>Sections are organized by category for easy navigation. Use the
    built-in search to quickly find what you are looking for.</p>

    <p>Feel free to reach out if you have any questions or need clarification
    on a specific feature.</p>

    <p>Kind regards,<br/>
    <t t-out="object.env.company.name"/></p>

    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;"/>

    <p style="font-size: 12px; color: #666666;">
        This message was sent by <t t-out="object.env.company.name"/>.<br/>
        If you received this message by mistake, please let us know.
    </p>
</div>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_password_expiry" model="mail.template">
            <field name="name">Access Management: Password Expiry Reminder</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Your password expires in {{ ctx.get('aam_days_left', 7) }} day(s)</field>
            <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:13px;">
                    <p>Hello <t t-out="object.name or ''">Marc</t>,</p>
                    <p>
                        The password for your <t t-out="object.company_id.name or 'Odoo'">My Company</t>
                        account expires in
                        <strong><t t-out="ctx.get('aam_days_left', 7)">7</t> day(s)</strong>.
                    </p>
                    <p>
                        Please change it before then, or you will not be able to sign in.
                        You can do it from your own profile, under Preferences &gt; Account
                        Security.
                    </p>
                    <p>Thanks,<br/>
                        <t t-out="object.company_id.name or ''">My Company</t>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aam_audit_log_list" model="ir.ui.view">
        <field name="name">aam.audit.log.list</field>
        <field name="model">aam.audit.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-danger="event_type in ['denial', 'login_blocked']"
                  decoration-info="event_type == 'impersonate'">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="event_type"/>
                <field name="model_name" optional="show"/>
                <field name="operation" optional="show"/>
                <field name="res_id" optional="hide"/>
                <field name="rule_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_aam_audit_log_search" model="ir.ui.view">
        <field name="name">aam.audit.log.search</field>
        <field name="model">aam.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="rule_id"/>
                <filter name="denials" string="Denials" domain="[('event_type', '=', 'denial')]"/>
                <filter name="logins" string="Logins"
                        domain="[('event_type', 'in', ['login', 'logout', 'login_blocked'])]"/>
                <filter name="impersonation" string="Impersonation"
                        domain="[('event_type', '=', 'impersonate')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_event" string="Event" context="{'group_by': 'event_type'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aam_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">aam.audit.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing logged yet</p>
            <p>
                Login activity is recorded by default. Turn on "Log Access Denials" in
                Settings while you are tuning rules to see exactly what is being blocked.
            </p>
        </field>
    </record>


    <menuitem id="menu_aam_audit_log" name="Audit Log" parent="menu_aam_reporting"
              action="action_aam_audit_log" sequence="30"/>

</odoo>

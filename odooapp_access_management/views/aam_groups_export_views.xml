<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aam_groups_export_form" model="ir.ui.view">
        <field name="name">aam.groups.export.form</field>
        <field name="model">aam.groups.export</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="status">
                    Produces two sheets: the groups with their members, and the full
                    group-by-model permission matrix. This is the file auditors ask for.
                </div>
                <group>
                    <field name="include_users"/>
                    <field name="include_implied" readonly="1"/>
                    <field name="only_restricted"/>
                </group>
                <group invisible="not data">
                    <field name="filename" invisible="1"/>
                    <field name="data" filename="filename" readonly="1" string="Download"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aam_groups_export" model="ir.actions.act_window">
        <field name="name">Export Groups to Excel</field>
        <field name="res_model">aam.groups.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_aam_groups_export" name="Export Groups (Excel)"
              parent="menu_aam_reporting" action="action_aam_groups_export" sequence="20"/>

</odoo>

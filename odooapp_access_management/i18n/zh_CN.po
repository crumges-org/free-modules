msgid ""
"<div class='alert alert-success'>Every reference resolved. This file will "
"import cleanly.</div>"
msgstr "<div class='alert alert-success'>所有引用均已解析。该文件可以顺利导入。</div>"

#. module: odooapp_access_management
#. odoo-python
#: code:addons/odooapp_access_management/wizards/aam_presets.py:0
msgid ""
"<div class='alert alert-warning mb-0'><b>Skipped - not installed:</b> "
"%s</div>"
msgstr "<div class='alert alert-warning mb-0'><b>已跳过 - 未安装：</b> %s</div>"

#. module: odooapp_access_management
#. odoo-python
#: code:addons/odooapp_access_management/wizards/aam_rules_io.py:0
msgid ""
"<div class='alert alert-warning'><b>%(n)s reference(s) could not be "
"resolved</b> and will be skipped. This usually means the target database is "
"missing an app, or a field was renamed between versions.</div><table "
"class='table table-"
"sm'><thead><tr><th>Reference</th><th>Expected</th><th>Used "
"by</th></tr></thead><tbody>%(rows)s</tbody></table>"
msgstr "<div class='alert alert-warning'><b>有 %(n)s 个引用无法解析</b>，将被跳过。这通常意味着目标数据库缺少某个应用，或者字段在版本之间被重命名。</div><table class='table table-sm'><thead><tr><th>引用</th><th>期望值</th><th>使用者</th></tr></thead><tbody>%(rows)s</tbody></table>"

#. module: odooapp_access_management
#: model:mail.template,body_html:odooapp_access_management.mail_template_password_expiry
msgid ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                    <p>Hello <t t-out=\"object.name or ''\">Marc</t>,</p>\n"
"                    <p>\n"
"                        The password for your <t t-out=\"object.company_id.name or 'Odoo'\">My Company</t>\n"
"                        account expires in\n"
"                        <strong><t t-out=\"ctx.get('aam_days_left', 7)\">7</t> day(s)</strong>.\n"
"                    </p>\n"
"                    <p>\n"
"                        Please change it before then, or you will not be able to sign in.\n"
"                        You can do it from your own profile, under Preferences &gt; Account\n"
"                        Security.\n"
"                    </p>\n"
"                    <p>Thanks,<br/>\n"
"                        <t t-out=\"object.company_id.name or ''\">My Company</t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0px;padding:0px;font-size:13px;\">\n"
"                    <p><t t-out=\"object.name or ''\">Marc</t> 您好，</p>\n"
"                    <p>\n"
"                        您的 <t t-out=\"object.company_id.name or 'Odoo'\">My Company</t>\n"
"                        账户密码将在\n"
"                        <strong><t t-out=\"ctx.get('aam_days_left', 7)\">7</t> 天后</strong>过期。\n"
"                    </p>\n"
"                    <p>\n"
"                        请在此之前修改密码，否则您将无法登录。\n"
"                        您可以在个人资料中的“偏好设置 &gt; 账户安全”处修改。\n"
"                    </p>\n"
"                    <p>谢谢，<br/>\n"
"                        <t t-out=\"object.company_id.name or ''\">My Company</t>\n"
"                    </p>\n"
"                </div>\n"
"            "


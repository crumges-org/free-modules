<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="FieldTimePicker">
        <div class="o_field_timepicker" t-attf-class="{{ props.editMode ? 'o_edit_mode' : '' }}">
            <input
                type="text"
                t-ref="input_time"
                t-att-value="props.record.data[props.name]"
                t-on-click="_onClickTimeField"
                class="o_input o_field_time_input"
                placeholder="HH:MM:SS"
                readonly="readonly"
            />
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record model="ir.module.category" id="module_category_shipment_fleet_main">
        <field name="name">Shipment</field>
        <field name="sequence">1</field>
    </record>

    <record model="ir.module.category" id="module_category_shipment_fleet">
        <field name="name">Shipment</field>
        <field name="description">Create and update Shipment.</field>
        <field name="parent_id" ref="module_category_shipment_fleet_main"/>
        <field name="sequence">1</field>
    </record>

    <!-- Shipment - Call out Read Only User -->
     <!-- NOTE: Driver app -->

<!--    group_shipment_driver_user_access-->
    <record model="res.groups" id="group_shipment_driver_user_access">
        <field name="name">Shipment Driver User</field>
        <field name="category_id" ref="module_category_shipment_fleet"/>
    </record>

    <!-- Shipment - Dispatcher -->
    <record model="res.groups" id="group_shipment_dispatcher_access">
        <field name="name">Dispatcher</field>
        <field name="category_id" ref="module_category_shipment_fleet"/>
        <field name="implied_ids" eval="[(4, ref('group_shipment_driver_user_access'))]"/>
    </record>


    <record id="driver_shipment_dispatcher_user" model="ir.rule">
        <field name="name">User see own company related shipment record</field>
        <field name="model_id" ref="bista_driver_app.model_shipment_shipment"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('bista_driver_app.group_shipment_dispatcher_access'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="active" eval="True"/>
    </record>

    <!-- User Can See Related Shipments -->
    <record id="driver_shipment_readonly_user" model="ir.rule">
        <field name="name">User can see related shipments</field>
        <field name="model_id" ref="bista_driver_app.model_shipment_shipment"/>
<!--        <field name="domain_force">[('id', 'in', user.get_allowed_shipment_ids() or [] )]</field>-->
        <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bista_driver_app.group_shipment_driver_user_access'))]"/>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Dispatcher user can see All Location History -->
    <record id="driver_location_history_dispatcher_user" model="ir.rule">
        <field name="name">Dispatcher see all location history record</field>
        <field name="model_id" ref="bista_driver_app.model_geolocation_history"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('bista_driver_app.group_shipment_dispatcher_access'))]"/>
        <field name="perm_read" eval="True"/>
    </record>

    <record id="driver_location_history_callout_user_rule" model="ir.rule">
        <field name="name">Shipment/Driver User: See own company and unassigned customer locations</field>
        <field name="model_id" ref="bista_driver_app.model_shipment_location"/>
        <field name="domain_force">['|', ('customer', '=', user.company_id.id), ('customer', '=', False)]</field>
        <field name="groups" eval="[(4, ref('bista_driver_app.group_shipment_driver_user_access'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="driver_location_history_dispatcher_user_rule" model="ir.rule">
        <field name="name">Dispatcher: See all customer locations</field>
        <field name="model_id" ref="bista_driver_app.model_shipment_location"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('bista_driver_app.group_shipment_dispatcher_access'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Call out : Show All Dispatcher Users-->
    <!-- <record id="rule_res_partner_dispatcher_read" model="ir.rule">

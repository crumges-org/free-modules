<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="False">

        <record id="driver_document_type_bol_fleet" model="driver.documents.type">
            <field name="type_name">BOL</field>
            <field name="description">Bill of lading</field>
            <field name="is_shipment_document" eval="True"/>
            <field name="is_inventory_document" eval="True"/>
            <field name="is_default_shipment_document" eval="False"/>
        </record>

        <record id="driver_document_type_pod_fleet" model="driver.documents.type">
            <field name="type_name">POD</field>
            <field name="description">Proof of delivery</field>
            <field name="is_shipment_document" eval="True"/>
            <field name="is_inventory_document" eval="True"/>
            <field name="is_default_shipment_document" eval="True"/>
        </record>

        <record id="driver_document_type_jsa_fleet1" model="driver.documents.type">
            <field name="type_name">JSA</field>
            <field name="description">Job Safety Analysis</field>
            <field name="is_shipment_document" eval="True"/>
            <field name="is_inventory_document" eval="False"/>
            <field name="is_default_shipment_document" eval="False"/>
        </record>

        <record id="driver_document_type_mtr_fleet1" model="driver.documents.type">
            <field name="type_name">MTR</field>
            <field name="description">Material Test Results</field>
            <field name="is_shipment_document" eval="False"/>
            <field name="is_inventory_document" eval="True"/>
            <field name="is_default_shipment_document" eval="False"/>
        </record>

    </data>
</odoo>

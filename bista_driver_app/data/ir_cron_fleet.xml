        <record id="ir_cron_update_fleet_driver_partner_phone" model="ir.cron">
            <field name="name">Shipment\Fleet Driver Partner Phone Update</field>
            <field eval="False" name="active"/>
            <field name="interval_number">5</field>
            <field name="interval_type">months</field>
<!--            <field name="numbercall">-1</field>-->
            <field name="model_id" ref="bista_driver_app.model_fleet_driver"/>
            <field name="state">code</field>
            <field name="active">True</field>
<!--            <field name="doall" eval="False"/>-->
            <field name="code">model._update_driver_partner_phone()</field>
            <field name="help">Purpose: Synchronized the phone number from the driver's user record to their corresponding contact (res.partner) to ensure the Twilio SMS service used the correct number, as it sources this data from the res.partner model.

                Process:
                    1. Fetches all driver records in the system.
                    2. For each driver:
                        - Checks if the driver has:
                            -- A driver login, and
                            -- A linked user, and
                            -- That user has a partner record.
                        - If all conditions are met, the partner’s Phone field is updated to match the driver_login value.
                    3. Ensures that partner phone numbers always stay aligned with driver login information.</field>
        </record>


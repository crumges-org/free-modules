<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
<!--        From Geolocation History-->
        <record id="source_manual_update" model="geolocation.source">
            <field name="name">Manual Update</field>
            <field name="source_type">serial</field>
            <field name="source_description">Latitude and Longitude data in entered in Serial number screen\Geolocation Tab </field>
        </record>
        <record id="source_use_my_location_button" model="geolocation.source">
            <field name="name">Use My Location Button</field>
            <field name="source_type">serial</field>
            <field name="source_description">Use My Location button is pressed in Serial number screen\Geolocation tab
            </field>
        </record>
        <record id="source_driver_phone" model="geolocation.source">
            <field name="name">Driver Phone</field>
            <field name="source_type">shipment</field>
            <field name="source_description">A new location data comes from a mobile device.</field>
        </record>


        <!-- Status -->
        <record model="shipment.status" id="bista_driver_app.shipment_status_pending">
            <field name="name">Pending</field>
            <field name="name_es">Pendiente</field>
            <field name="sequence">1</field>
            <field name="color">9</field>
            <field name="is_driver_can_choose">False</field>
            <field name="location_tracking">disabled</field>
            <field name="status_action"/>
            <field name="is_completed">False</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_assigned">
            <field name="name">Assigned</field>
            <field name="name_es">Asignado</field>
            <field name="sequence">2</field>
            <field name="color">5</field>
            <field name="is_driver_can_choose">False</field>
            <field name="location_tracking">disabled</field>
            <field name="button_name_en">Mark as Going to Pickup</field>
            <field name="button_name_es">Marcar como En Camino a Recoger</field>
            <field name="status_action">action_set_accepted</field>
            <field name="is_completed">False</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_accepted">
            <field name="name">Dispatched</field>
            <field name="name_es">Enviado</field>
            <field name="sequence">3</field>
            <field name="color">2</field>
            <field name="is_driver_can_choose">True</field>
            <field name="location_tracking">enabled</field>
            <field name="button_name_en">Mark as At Pickup</field>
            <field name="button_name_es">Marcar como en la recogida</field>
            <field name="status_action">action_set_at_pickup</field>
            <field name="is_completed">False</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_at_pickup">
            <field name="name">At Pickup</field>
            <field name="name_es">En la recogida</field>
            <field name="sequence">4</field>
            <field name="color">3</field>
            <field name="is_driver_can_choose">True</field>
            <field name="location_tracking">enabled</field>
            <field name="button_name_en">Mark as In Transit</field>
            <field name="button_name_es">Marcar como en tránsito</field>
            <field name="status_action">action_set_in_transit</field>
            <field name="is_completed">False</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_in_transit">
            <field name="name">In Transit</field>
            <field name="name_es">En tránsito</field>
            <field name="sequence">5</field>
            <field name="color">8</field>
            <field name="is_driver_can_choose">True</field>
            <field name="location_tracking">enabled</field>
            <field name="button_name_en">Mark as At Delivery</field>
            <field name="button_name_es">Marcar como en el momento de la entrega</field>
            <field name="status_action">action_set_at_delivery</field>
            <field name="is_completed">False</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_at_delivery">
            <field name="name">At Delivery</field>
            <field name="name_es">En la entrega</field>
            <field name="sequence">6</field>
            <field name="color">7</field>
            <field name="is_driver_can_choose">True</field>
            <field name="location_tracking">enabled</field>
            <field name="button_name_en">Mark as Delivered</field>
            <field name="button_name_es">Marcar como entregado</field>
            <field name="status_action">action_set_delivered</field>
            <field name="is_completed">False</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_delivered">
            <field name="name">Delivered</field>
            <field name="name_es">Entregado</field>
            <field name="sequence">7</field>
            <field name="color">10</field>
            <field name="is_driver_can_choose">True</field>
            <field name="location_tracking">disabled</field>
            <field name="button_name_en">Completed</field>
            <field name="button_name_es">Terminado</field>
            <field name="status_action"/>
            <field name="is_completed">True</field>
            <field name="is_cancelled">False</field>
        </record>
        <record model="shipment.status" id="bista_driver_app.shipment_status_cancelled">
            <field name="name">Cancelled</field>
            <field name="name_es">Cancelado</field>
            <field name="sequence">8</field>
            <field name="color">1</field>
            <field name="is_driver_can_choose">False</field>
            <field name="location_tracking">disabled</field>
            <field name="button_name_en">Cancelled</field>
            <field name="button_name_es">Cancelado</field>
            <field name="status_action"/>
            <field name="is_completed">False</field>
            <field name="is_cancelled">True</field>
        </record>

        <!-- Call out Stage -->
        <!-- NOTE: Driver app: remove callout stage data -->
        <!-- <record model="call.out.stages" id="bista_driver_app.stage_pending">
            <field name="name">Pending</field>

            </function>
            <value eval="{'noupdate': True}"/>
        </function> -->

        <!--  Driver App server data -->
        <record model="driver.app.server" id="driver_app_production_server">
            <field name="name">Production</field>
<!--            <field name="server_route"> </field>-->
            <field name="server_route"> </field>
            <field name="api_route">/api/v1/fleet</field>
            <field name="content_route">/api/web/content</field>
            <field name="web_route">/web</field>
        </record>
        <record model="driver.app.server" id="driver_app_staging_server">
            <field name="name">Staging</field>
<!--            <field name="server_route"></field>-->
            <field name="server_route"> </field>
            <field name="api_route">/api/v1/fleet</field>
            <field name="content_route">/api/web/content</field>
            <field name="web_route">/web</field>
        </record>
        <record model="driver.app.server" id="driver_app_dev_server">
            <field name="name">Development</field>
<!--            <field name="server_route"></field>-->
            <field name="server_route"> </field>
            <field name="api_route">/api/v1/fleet</field>
            <field name="content_route">/api/web/content</field>
            <field name="web_route">/web</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="default_carrier" model="shipment.carrier">
            <field name="name">Default Carrier</field>
        </record>
        <!-- Driver for ios user-->
        <record id="ios_test_driver_rec" model="fleet.driver">
            <field name="driver_name">Apple Test Driver</field>
            <field name="driver_login">1234567891</field>
            <field name="carrier_id" ref="bista_driver_app.default_carrier"/>
            <field name="otp">Aa@123456</field>
            <field name="truck_no">ABC-13420</field>
            <field name="is_skip_sms">True</field>
        </record>
        <!-- In the generate_driver_otp function the following parameter will be set as ios_test_driver_rec OTP
            In order to avoid the password policy check for the given user while module upgrade at first the record is updated
            with the OTP following password rules. Later desired otp is set -->
         <record id="ios_test_driver_otp" model="ir.config_parameter">
            <field name="key">bista_driver_app.ios_test_driver_otp</field>
            <field name="value">98650</field>
        </record>
    </data>


    <data noupdate="1">
        <!-- Shipment Settings -->
        <record model="shipment.settings" id="shipment_settings_location_reporting_frequency">
            <field name="name">Location Reporting Frequency</field>
            <field name="value">5</field>
            <field name="unit">Minutes</field>
            <field name="description">Defines how often the driver app and the ELD device send location data to Driver App Default: 5 minutes.</field>
        </record>
        <record model="shipment.settings" id="shipment_settings_location_timeout_threshold">
            <field name="name">Location Timeout Threshold</field>
            <field name="value">30</field>
            <field name="unit">Minutes</field>
            <field name="description">If location isn't received from an active shipment for over this threshold, a mobile notification is sent to the driver.
            </field>
        </record>
        <record model="shipment.settings" id="shipment_settings_image_compression_ratio">
            <field name="name">Image Compression Ratio</field>
            <field name="value">40</field>
            <field name="unit">Percent</field>
            <field name="description">Compression level used when uploading files from the mobile app. 1:Max quality, 100:Lowest quality.</field>
        </record>
        <record model="shipment.settings" id="shipment_settings_auto_refresh_interval">
            <field name="name">Shipment Auto-Refresh Interval</field>
            <field name="value">5</field>
            <field name="unit">Minutes</field>
            <field name="description">The shipment list screen in the driver app refreshes automatically at this interval.</field>
        </record>
        <record model="shipment.settings" id="shipment_settings_geofence_radius">
            <field name="name">Geofence Radius</field>
            <field name="value">2640</field>
            <field name="unit">Feet</field>
            <field name="description">Updates the shipment status when the phone/ELD enters or exits a geofence with this radius. Default: 5280 Feet.</field>
        </record>
        <record model="shipment.settings" id="shipment_settings_location_reporting_distance_filter">
            <field name="name">Location Reporting Distance Filter</field>
            <field name="value">10</field>
            <field name="unit">Feet</field>
            <field name="description">Defines what distance the driver app sends location data to Driver App Default:33 Feet.</field>
        </record>
        <!-- T2787: url field name  and id change -->
        <record model="shipment.settings" id="shipment_settings_privacy_policy_url">
            <field name="name">Privacy Policy URL</field>
            <field name="url_value_en">https://Driver..com/public/knowledge/article/351</field>
            <field name="url_value_es">https://Driver..com/public/knowledge/article/352</field>
<!--            <field name="url_value_en"> </field>-->
<!--            <field name="url_value_es"> </field>-->
            <field name="value">0</field>
            <field name="unit"> </field>
            <field name="is_fleet_system_url">True</field>
        </record>
        <!-- T2787: url field name  and id change -->
        <record model="shipment.settings" id="shipment_settings_terms_and_conditions_url">
            <field name="name">Terms And Conditions URL</field>
<!--            <field name="url_value_en">https://Driver..com/public/knowledge/article/353</field>-->
<!--            <field name="url_value_es">https://Driver..com/public/knowledge/article/354</field>-->
            <field name="url_value_en"> </field>
            <field name="url_value_es"> </field>
            <field name="value">0</field>
            <field name="unit"> </field>
            <field name="is_fleet_system_url">True</field>
        </record>
        <!-- T2851: SMS frequency for location timeout-->
        <record model="shipment.settings" id="shipment_settings_location_time_out_sms_frequency">
            <field name="name">Location Timeout Sms Frequency</field>
            <field name="value">3</field>
            <field name="unit"> </field>
            <field name="description">If sms notifications sent for undetected shipment locations exceeds the allowed frequency, no further messages will be sent to the driver.
            </field>
        </record>
    </data>

    <data noupdate="1">
        <record model="ir.config_parameter" id="bista_driver_app.server_env">
            <field name="key">bista_driver_app.server_env</field>
            <field name="value">dev</field>
        </record>
    </data>
</odoo>

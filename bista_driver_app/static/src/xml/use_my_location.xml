<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="bista_driver_app.UseMyLocation" owl="1">
        <t t-if="is_callout_user or is_admin or is_shipment_dispatcher">
            <button type="button" class="btn btn-secondary d-flex align-items-center gap-1 font-size-sm" t-on-click="getLocationAndUpdate">
                <i class="fa fa-cog" aria-hidden="true"/>
                <span>Use My Location</span>
            </button>
        </t>
    </t>
</templates>
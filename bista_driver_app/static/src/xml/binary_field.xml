<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bista_driver_app.ListBinary" t-inherit="web.BinaryField" t-inherit-mode="primary">
        <xpath expr="//a[hasclass('o_form_uri')]" position="replace">
            <a class="o_form_uri o_list_binary" href="#" t-on-click.prevent.stop="onFileDownload">
                <span class="fa fa-download me-2" />
                <t t-if="fileName" t-esc="fileName" />
            </a>
        </xpath>
    </t>

</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--T2787: settingheader  hide during search-->
    <t t-name="bista_driver_app.settingAppInherit" t-inherit="web.SettingsApp" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'settingSearchHeader')]" position="attributes">
            <attribute name="t-if">state.search.value.length !== 0 and env.model.config.resModel !== 'shipment.config.settings'</attribute>
        </xpath>
    </t>
</templates>
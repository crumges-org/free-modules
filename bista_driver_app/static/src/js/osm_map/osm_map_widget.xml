<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.OsmMapWidget" owl="1">
        <div class="osm_map_wrapper">
            <t t-if="props.record.data.latitude and props.record.data.longitude">
                <div t-ref="osm_map_container" class="osm_map_container"/>
            </t>
            <t t-else="">
                <div class="osm_map_no_coords text-muted d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <i class="fa fa-map-marker fa-3x mb-2"/>
                        <p>No coordinates available. Please enter latitude and longitude values to display the map.</p>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>

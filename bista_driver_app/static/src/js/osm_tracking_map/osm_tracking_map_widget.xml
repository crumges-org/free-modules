<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.OsmTrackingMapWidget" owl="1">
        <div class="osm_tracking_map_wrapper">
            <t t-if="hasHistoryPoints">
                <div t-ref="osm_tracking_map_container" class="osm_tracking_map_container"/>
                <div class="osm_tracking_map_legend">
                    <span class="legend_item">
                        <span class="legend_dot legend_dot_online"/>
                        Online
                    </span>
                    <span class="legend_item">
                        <span class="legend_dot legend_dot_offline"/>
                        Offline
                    </span>
                </div>
            </t>
            <t t-else="">
                <div class="osm_tracking_map_no_data text-muted d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <i class="fa fa-map-o fa-3x mb-2"/>
                        <p>No geolocation history available for this shipment.</p>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>

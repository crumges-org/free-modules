<?xml version="1.0" encoding="utf-8"?>
<odoo>


        <record id="assign_driver_wizard_form" model="ir.ui.view">
            <field name="name">assign.driver.wizard.form</field>
            <field name="model">assign.driver</field>
            <field name="arch" type="xml">
                <form string="Assign Driver">
                    <group>
                        <field name="driver_id" required="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"
                            context="{'is_from_call_out_mst': True, 'tree_view_ref': 'bista_driver_app.bista_fleet_driver_optional_tree_view'}"/>
                    </group>
                    <footer>
                        <button name="assign_driver" confirm="Are you sure you want to assign this shipment to this driver?" string="Confirm" type="object" class="oe_highlight" />
                        <button name="cancel" string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

</odoo>
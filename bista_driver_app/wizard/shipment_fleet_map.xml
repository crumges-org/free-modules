<?xml version="1.0" encoding="utf-8"?>
<odoo>


        <record id="fleet_map_wizard_form" model="ir.ui.view">
            <field name="name">fleet.map.wizard.form</field>
            <field name="model">fleet.map</field>
            <field name="arch" type="xml">
                <form string="Google Map">
                    <field name="name" widget="fleet_maps" nolabel="1" readonly="1"/>
                    <footer>
                        <button name="cancel" string="Ok" class="oe_highlight" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

</odoo>
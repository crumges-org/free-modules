<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--T2787: form view for custom shipment  setting layout-->
    <record id="shipment_config_settings_view_form" model="ir.ui.view">
        <field name="name">shipment.config.settings.view.form</field>
        <field name="model">shipment.config.settings</field>
        <field name="arch" type="xml">
            <form string="Shipment Settings" class="oe_form_configuration" js_class="base_settings">
                <app data-string="" string="" name="">
                    <block title="Location" class="mt4 mw-100 mb-1">
                        <field name="location_reporting_freq_id" invisible="1"/>
                        <field name="location_timeout_threshold_id" invisible="1"/>
                        <field name="geofence_radius_id" invisible="1"/>
                        <field name="location_distance_filter_id" invisible="1"/>
                        <field name="location_timeout_freq_id" invisible="1"/>
                        <setting class="col-sm-6">
                            <label for="location_reporting_freq_id_value" string="Location Reporting Frequency"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="location_reporting_freq_id_value" class="w-25 w-lg-50"/> <span><field name="location_reporting_freq_id_unit"/></span>
                            </div>
                            <field name="location_reporting_freq_id_description" placeholder="Description..." class="w-100"/>
                        </setting>

                        <setting class="col-sm-6">
                            <label for="location_timeout_threshold_id_value" string="Location Timeout Threshold"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="location_timeout_threshold_id_value" class="w-25 w-lg-50"/> <span><field name="location_timeout_threshold_id_unit"/></span>
                            </div>
                            <field name="location_timeout_threshold_id_description" placeholder="Description..." class="w-100"/>
                        </setting>

                        <setting class="col-sm-6">
                            <label for="geofence_radius_id_value" string="Geofence Radius"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="geofence_radius_id_value" class="w-25 w-lg-50"/> <span><field name="geofence_radius_id_unit"/></span>
                            </div>
                            <field name="geofence_radius_id_description" placeholder="Description..." class="w-100"/>
                        </setting>

                        <setting class="col-sm-6">
                            <label for="location_distance_filter_id_value" string="Location Reporting Distance Filter"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="location_distance_filter_id_value" class="w-25 w-lg-50"/> <span><field name="location_distance_filter_id_unit"/></span>
                            </div>
                            <field name="location_distance_filter_id_description" placeholder="Description..." class="w-100"/>
                        </setting>
                        <!-- T2851: SMS frequency for location timeout-->
                        <setting class="col-sm-6">
                            <label for="location_timeout_freq_id_value" string="Location Timeout Sms Frequency"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="location_timeout_freq_id_value" class="w-25 w-lg-50"/>
                            </div>
                            <field name="location_timeout_freq_id_description" placeholder="Description..." class="w-100"/>
                        </setting>
                    </block>
                    <block title="Fleet Mobile App" class="mt4 mw-100 mb-1">
                        <field name="image_compression_ratio_id" invisible="1"/>
                        <field name="auto_refresh_interval_id" invisible="1"/>
                        <setting class="col-sm-6">
                            <label for="image_compression_ratio_id_value" string="Image Compression Ratio"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="image_compression_ratio_id_value" class="w-25 w-lg-50"/> <span><field name="image_compression_ratio_id_unit"/></span>
                            </div>
                            <field name="image_compression_ratio_id_description" placeholder="Description..." class="w-100"/>
                        </setting>
                        <setting class="col-sm-6">
                            <label for="auto_refresh_interval_id_value" string="Shipment Auto-Refresh Interval"/>
                            <div class="d-flex mt-2 col-lg-3">
                               <field name="auto_refresh_interval_id_value" class="w-25 w-lg-50"/> <span><field name="auto_refresh_interval_id_unit"/></span>
                            </div>
                            <field name="auto_refresh_interval_id_description" placeholder="Description..." class="w-100"/>
                        </setting>
                    </block>
                    <block title="Privacy" class="mt4 mw-100 mb-1">
                        <field name="privacy_policy_id" invisible="1"/>
                        <field name="terms_and_condition_id" invisible="1"/>
                        <setting class="col-sm-6">
                            <label for="privacy_policy_id_url_value_en" string="Privacy Policy URL(EN)"/>
                            <div class="d-flex mt-2">
                                <field name="privacy_policy_id_url_value_en" class="w-100"/>
                            </div>
                             <label for="privacy_policy_id_url_value_es" string="Privacy Policy URL(ES)"/>
                            <div class="d-flex mt-2">
                                <field name="privacy_policy_id_url_value_es" class="w-100"/>
                            </div>
                            <field name="privacy_policy_id_description" placeholder="Description..." class="w-100"/>
                        </setting>

                        <setting class="col-sm-6">
                            <label for="terms_and_condition_id_url_value_en" string="Terms and Condition URL(EN)"/>
                            <div class="d-flex mt-2">
                                <field name="terms_and_condition_id_url_value_en" class="w-100"/>
                            </div>
                            <label for="terms_and_condition_id_url_value_es" string="Terms and Condition URL(ES)"/>
                            <div class="d-flex mt-2">
                                <field name="terms_and_condition_id_url_value_es" class="w-100"/>
                            </div>
                            <field name="terms_and_condition_id_description" placeholder="Description..." class="w-100"/>
                        </setting>
                    </block>
                </app>
            </form>
        </field>
    </record>
    <!--T2787: action-->
    <record id="shipment_config_settings_act_window" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">shipment.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bista_driver_app.shipment_config_settings_view_form"/>
        <field name="target">inline</field>
        <field name="context">{'module' : 'bista_driver_app', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_fleet_settings" parent="bista_driver_app.group_shipment_administration_access"
        name="Settings" sequence="15" action="bista_driver_app.shipment_config_settings_act_window" groups="base.group_system"/>
</odoo>
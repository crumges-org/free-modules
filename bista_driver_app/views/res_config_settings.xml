<odoo>
    <record id="fleet_view_res_config_settings_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.custom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Shipment" string="Shipment" data-key="bista_driver_shipwell_api" name="bista_driver_shipwell_api" logo="/bista_driver_app/static/description/Shipping.png">
                    <block title="Shipment" name="driver_shipment">
                        <setting help="Enter the API key for Google Maps. This key is required to display the Tracking Map in shipments.">
                            <field name="shipment_google_map_api_key"/>
                        </setting>
                    </block>
<!--                    <block title="Fleet" name="driver_fleet">-->
<!--                        <setting help="Enter the API key for Google Maps. This key is required to display the Tracking Map in Fleet.">-->
<!--                            <field name="fleet_google_map_api_key"/>-->
<!--                        </setting>-->
<!--                    </block>-->
                    <!-- T2767 Fleet app Firebase settings -->
                    <block title="Firebase Settings" name="fleet_firebase_settings">
                        <setting string="Firebase Project Name" id="fleet_firebase_name" class="o_form_label">
                            <field name="fleet_firebase_name"/>
                        </setting>
                        <setting string="Firebase Project Id" id="fleet_firebase_project_id" class="o_form_label">
                            <field name="fleet_firebase_id"/>
                        </setting>
                        <setting string="Key File" id="fleet_firebase_key_file" class="o_form_label pr-2">
                            <field name="fleet_firebase_key_file"/>
                        </setting>
                    </block>
                </app>
<!--                <app data-string="Fleet" string="Fleet" data-key="bista_driver_app" name="bista_driver_app" logo="/bista_driver_app/static/description/fleet.jpg">-->
<!--                    <block title="Fleet" name="driver_fleet">-->
<!--                        <setting help="Enter the API key for Google Maps. This key is required to display the Tracking Map in Fleet.">-->
<!--                            <field name="fleet_google_map_api_key"/>-->
<!--                        </setting>-->
<!--                    </block>-->
<!--                    &lt;!&ndash; T2767 Fleet app Firebase settings &ndash;&gt;-->
<!--                    <block title="Firebase Settings" name="fleet_firebase_settings">-->
<!--                        <setting string="Firebase Project Name" id="fleet_firebase_name" class="o_form_label">-->
<!--                            <field name="fleet_firebase_name"/>-->
<!--                        </setting>-->
<!--                        <setting string="Firebase Project Id" id="fleet_firebase_project_id" class="o_form_label">-->
<!--                            <field name="fleet_firebase_id"/>-->
<!--                        </setting>-->
<!--                        <setting string="Key File" id="fleet_firebase_key_file" class="o_form_label pr-2">-->
<!--                            <field name="fleet_firebase_key_file"/>-->
<!--                        </setting>-->
<!--                    </block>-->
<!--                </app>-->
            </xpath>
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="Servers" name="driver_app_server">
                    <setting string="Servers" help="Servers info with path" groups="base.group_system">
                            <button type="action" name="%(bista_driver_app.action_driver_app_server_info)d" string="Open Servers Info" icon="oi-arrow-right" class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    

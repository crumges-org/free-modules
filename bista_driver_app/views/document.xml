<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_shipment_document_tree" model="ir.ui.view">
        <field name="name">shipment.document.list</field>
        <field name="model">shipment.document</field>
        <field name="arch" type="xml">
            <list string="Documents" create="false" delete="false" edit="false">
                <field name="document_type_id" string="Type"/>
                <field name="file"/>
                <field name="filename"/>
                <field name="is_signature" readonly="1"/>
                <field name="shipment_id" string="Reference"/>
                <field name="description"/>
                <field name="create_uid"/>
                <field name="driver_id" string="Carrier"/>
                <field name="truck_number"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shipment_document_form" model="ir.ui.view">
        <field name="name">shipment.document.form</field>
        <field name="model">shipment.document</field>
        <field name="arch" type="xml">
            <form string="Document" create="false" delete="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="document_type_id" string="Type" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="file" filename="filename"/>
                            <field name="filename"/>
                            <field name="is_signature" readonly="1"/>
                            <field name="description"/>
                            <!-- <field name="driver_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                            <field name="truck_number"/> -->
                        </group>
                        <group>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                            <field name="write_uid"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record model="ir.ui.view" id="view_shipment_document_kanban">
        <field name="name">shipment.document kanban</field>
        <field name="model">shipment.document</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false" edit="false" import="false">
                <field name="id"/>
                <field name="filename"/>
                <field name="file"/>
                <field name="description"/>
                <field name="carrier_id"/>
                <field name="document_type_id"/>
                <field name="shipment_id"/>
                <field name="driver_id"/>
                <field name="truck_number"/>
                <field name="driver_phone"/>
                <field name="driver_user_id"/>
                <!--T2858: write date instead of date in documents-->
                <field name="date" invisible="1"/>
                <field name="write_date"/>
                <field name="is_signature"/>
                <templates>
                    <t t-name="card">
                            <div class="oe_kanban_global_area oe_kanban_global_click o_kanban_attachment">
                                <div class="o_kanban_details">
                                    <div class="o_kanban_details_wrapper">
                                        <div t-att-title="record.filename.raw_value" class="o_kanban_record_title">
                                            <field name="filename" class="o_text_overflow"/>
                                        </div>
                                        <div t-att-title="record.filename.raw_value">
                                            <field name="shipment_id"/>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="document_type_id"/>
                                            <br/>
                                            <field name="file"/>
                                            <br/>
                                            <field name="driver_id"/>
                                        </div>
                                        <div class="o_kanban_record_bottom">
                                            <time class="oe_kanban_bottom_left">
                                                <field name="create_date" widget="date"/>
                                            </time>
                                            <div class="oe_kanban_bottom_right">
                                                <field name="create_uid" widget="many2one_avatar_user"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="bista_shipment_document_search_view" model="ir.ui.view">
        <field name="name">shipment.document.search.view</field>
        <field name="model">shipment.document</field>
        <field name="arch" type="xml">
            <search string="Shipment Documents">
                <field name="filename" />
                <field name="description"/>
                <field name="is_signature"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_document" model="ir.actions.act_window">
        <field name="name">Shipment Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipment.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Document found
            </p>
        </field>
    </record>

    <menuitem id="menu_shipment_document" parent="bista_driver_app.menu_driver_fleet_shipment_reporting_menu"
            name="Shipment Documents" sequence="10" action="bista_driver_app.action_shipment_document"
            groups="bista_driver_app.group_shipment_dispatcher_access,base.group_system"/>
</odoo>

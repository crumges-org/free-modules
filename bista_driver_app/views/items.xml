<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_shipment_item_tree" model="ir.ui.view">
        <field name="name">shipment.item.list</field>
        <field name="model">shipment.item</field>
        <field name="arch" type="xml">
            <list string="Items">
                <field name="name"/>
                <field name="shipment_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shipment_item_form" model="ir.ui.view">
        <field name="name">shipment.item.form</field>
        <field name="model">shipment.item</field>
        <field name="arch" type="xml">
            <form string="Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="shipment_id" invisible="1" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to open shipment.item -->
    <record id="action_shipment_item" model="ir.actions.act_window">
        <field name="name">Shipment Items</field>
        <field name="res_model">shipment.item</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

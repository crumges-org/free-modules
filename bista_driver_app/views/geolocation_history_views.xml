    <!-- view action -->
    <record id="driver_geolocation_history_view_action" model="ir.actions.act_window">
        <field name="name">Geolocation History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">geolocation.history</field>
        <field name="view_mode">list</field>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', context.get('allowed_company_ids'))]</field>
        <field name="search_view_id" ref="view_geolocation_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No geolocation history found!
            </p>
        </field>
    </record>


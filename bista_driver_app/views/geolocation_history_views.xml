<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- tree view -->
    <record id="geolocation_history_view_tree" model="ir.ui.view">
        <field name="name">geolocation.history.list</field>
        <field name="model">geolocation.history</field>
        <field name="arch" type="xml">
            <list string="Geolocation History" edit="false" create="false">
                <field name="date_recorded"/>
                <field name="source_id"/>
                <field name="reference" optional="show" widget="many2onebutton"/>
                <field name="lot_id" optional="hide"/>
<!--                <field name="samsara_eld_asset_id" optional="hide"/>-->
                <field name="device_unique_id" optional="hide"/>
                <field name="device_name" optional="hide"/>
                <field name="asset_latitude"/>
                <field name="asset_longitude"/>
                <field name="carrier_id" widget="many2onebutton" optional="hide"/>
                <field name="latest" optional="hide" readonly="1"/>
                <field name="create_date" optional="hide"/>
                <field name="create_uid"/>
                <field name="connectivity_status" widget="badge" decoration-success="connectivity_status == 'online'" decoration-danger="connectivity_status == 'offline'" optional="hide"/>
                <field name="company_id" optional="show" widget="many2one"/>
                <field name="approximate_location"/>
                <field name="speed"/>
<!--                <field name="product_id" optional="hide"/>-->
            </list>
        </field>
    </record>

    <!-- form view -->
    <record id="geolocation_history_view_form" model="ir.ui.view">
        <field name="name">geolocation.history.form</field>
        <field name="model">geolocation.history</field>
        <field name="arch" type="xml">
            <form string="Geolocation History" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="source_id"/>
                            <field name="carrier_id"/>
                            <field name="reference" widget="many2onebutton"/>
                            <field name="date_recorded"/>
                            <field name="asset_latitude" widget="location_map_link"/>
                            <field name="asset_longitude" widget="location_map_link"/>
                            <field name="approximate_location" string="Accuracy (ft)"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="create_uid"/>
                            <field name="connectivity_status"/>
                            <field name="company_id"/>
                            <field name="speed"/>
                            <field name="device_unique_id"/>
                            <field name="device_name"/>
                        </group>
                    </group>
<!--                T2564 Geolocation History List – Detail View with Map-->
                    <div>
                        <field name="latitude_longitude" readonly="1" widget="google_map_single_marker" nolabel="1" options="{'module': 'shipment'}"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_geolocation_history_search" model="ir.ui.view">
        <field name="name">geolocation.history.search</field>
        <field name="model">geolocation.history</field>
        <field name="arch" type="xml">
            <search>
<!--                <field name="source_id"/>-->
                <filter name="manual_update" string="Manual Update" domain="[('source_name', '=','Manual Update')]" help="Manual Update"/>
                <filter name="use_my_location_button" string="Use My Location Button" domain="[('source_name', '=', 'Use My Location Button')]" help="Use My Location Button"/>
                <filter name="driver_phone" string="Driver Phone" domain="[('source_name', '=', 'Driver Phone'), ('source_id.source_type', '=', 'shipment')]" help="Driver Phone"/>

                <separator/>
                <!-- group by -->
                <group expand="0" string="Group By">
                    <filter name="source_id" string="Source" context="{'group_by': 'source_id'}"/>
                </group>
            </search>
        </field>
    </record>


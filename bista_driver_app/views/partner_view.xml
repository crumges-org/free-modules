<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="dispatcher_contact_type_view_form_inherit" model="ir.ui.view">
        <field name="name">dispatcher.contact.type.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="before">
                <group>
                    <group>
                        <field name="dispatcher_contact_type" groups='base.group_system'/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--    Form view for Document Type-->
    <record id="view_driver_document_type" model="ir.ui.view">
        <field name="name">driver.document.type.form</field>
        <field name="model">driver.documents.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <group>
                        <group>
                            <field name="type_name"/>
                            <field name="description"/>
                             <field name="is_shipment_document"  widget="boolean_toggle"/>
                            <field name="is_inventory_document"  widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>
<!--    Tree view for Document Type-->
    <record id="driver_document_type_tree_view" model="ir.ui.view">
        <field name="name">driver.document.type.list</field>
        <field name="model">driver.documents.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="type_name"/>
                <field name="description"/>
                <field name="is_shipment_document" widget="boolean_toggle"/>
                <field name="is_default_shipment_document" widget="boolean_toggle" invisible="not is_shipment_document"/>
                <field name="is_shipment_document" widget="boolean_toggle"/>
                <field name="is_default_shipment_document" widget="boolean_toggle"/>
                <field name="is_shipment_document"  widget="boolean_toggle" optional="hide"/>
                <field name="is_inventory_document"  widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
<!--    Action for Document Type-->
    <record id="driver_document_type_action_fleet" model="ir.actions.act_window">
        <field name="name">Document Type</field>
        <field name="res_model">driver.documents.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="driver_document_type_tree_view"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a new Document Type
            </p>
        </field>
    </record>

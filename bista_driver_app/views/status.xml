<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_shipment_status_tree" model="ir.ui.view">
        <field name="name">shipment.status.list</field>
        <field name="model">shipment.status</field>
        <field name="arch" type="xml">
            <list string="Status">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="sequence"/>
                <field name="color" widget="color_picker"/>
                <field name="fold"/>
                <field name="button_name_en" optional="hide"/>
                <field name="button_name_es" optional="hide"/>
                <field name="location_tracking" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shipment_status_form" model="ir.ui.view">
        <field name="name">shipment.status.form</field>
        <field name="model">shipment.status</field>
        <field name="arch" type="xml">
            <form string="Status">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="name_es"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="fold"/>
                        </group>
                        <group>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                            <field name="write_uid"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                    <group name="mobile_app" string="Mobile App">
                        <group name="button_names">
                            <field name="button_name_en"/>
                            <field name="button_name_es"/>
                        </group>
                        <group name="location"> 
                            <label for="is_driver_can_choose" string="Driver Can Choose"/>
                            <div>
                                <field name="is_driver_can_choose" nolabel="1"/>
                                <br/>
                                <!-- <span class="fst-italic text-muted"/> -->
                                <span class="text-muted">
                                    If checked, this stage will be available to be selected in the Shipment's stage selection by the driver.
                                </span>
                            </div>

                            <label for="location_tracking" string="Location Tracking"/>
                            <div>
                                <field name="location_tracking" nolabel="1"/>
                                <span class="text-muted">
                                    When enabled, both the driver’s phone location and the ELD’s location are captured to update the Latest Lat/Long fields. Additionally, a new location History Record will be created for each.
                                </span>
                            </div>

                            <label for="do_eta_calculation" string="ETA Calculation"/>
                            <div>
                                <field name="do_eta_calculation" nolabel="1"/>
                                <br/>
                                <span class="text-muted">
                                    If checked, when a new location update is received, real time ETA fields (Remaining Mileage, Remaining Time, ETA, and ETA Last Updated Time) will be calculated based on Latest Lat/Long.
                                </span>
                            </div>
                        </group>
                    </group>
                    <group name="mobile_app_other" string="Mobile App Others" groups="base.group_no_one">
                        <field name="status_action"/>
                        <field name="is_completed"/>
                        <field name="is_cancelled"/>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_status" model="ir.actions.act_window">
        <field name="name">Shipment Status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipment.status</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Status found
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="shipment_location_tree_view" model="ir.ui.view">
        <field name="name">shipment.location.list.view</field>
        <field name="model">shipment.location</field>
        <field name="arch" type="xml">
            <list string="Locations">
                <field name="name"/>
                <field name="street_1"/>
                <field name="street_2" optional="hide"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="zip"/>
                <field name="county_id" optional="hide"/>
                <field name="country_id" optional="hide"/>
                <field name="person_name"/>
                <field name="person_phone"/>
                <field name="person_email"/>
                <field name="write_uid"/>
                <field name="write_date"/>
                <field name="customer" optional="hide"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="timezone" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="shipment_location_form_view" model="ir.ui.view">
        <field name="name">shipment.location.form.view</field>
        <field name="model">shipment.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <notebook>
                        <page string="Details">
                            <group>
                                <group>
                                    <separator string="Address"/>
<!--                                    <field name="address" class="o_address_street" widget="address_autocomplete_gmap_widget"-->
<!--                                           options="{-->
<!--                                                'street': 'street_1',-->
<!--                                                'street2': 'street_2',-->
<!--                                                'city': 'city',-->
<!--                                                'zip': 'zip',-->
<!--                                                'state': 'state_id',-->
<!--                                                'country': 'country_id',-->
<!--                                                'county': 'county_id',-->
<!--                                                'latitude': 'latitude',-->
<!--                                                'longitude': 'longitude'-->
<!--                                            }"/>-->
                                    <group>
                                        <field name="street_1"/>
                                        <field name="city"/>
                                        <field name="state_id" force_save="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                        <field name="country_id"  options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" />
                                    </group>
                                    <group>
                                        <field name="street_2" />
                                        <field name="zip"/>
                                        <field name="county_id" context="{'is_from_location_mst': True}" force_save="1"
                                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    </group>

                                    <separator string="Contact"/>
                                    <group>
                                        <field name="person_name" class="oe_person" string="Name"/>
                                        <field name="person_email" class="oe_person" string="Email"/>
                                        <field name="person_phone" class="oe_person" string="Phone"/>
                                    </group>

                                    <separator string="Timezone"/>
                                    <group>
                                        <field name="timezone"/>
                                    </group>
                                    <group>
                                        <field name="customer" readonly="1" invisible="customer == False"
                                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    </group>
                                </group>
                                <group>
                                    <separator string="Map"/>
                                    <group>
                                        <field name="latitude" readonly="0" required="1"/>
                                    </group>
                                    <group>
                                        <field name="longitude" readonly="0" required="1"/>
                                    </group>
                                    <div class="col-lg-12">
                                        <span class="text-muted">Click on anywhere on the map to set the exact location.</span>
                                        <widget name="use_my_location"/>
                                    </div>
                                    <field name="shape_data" invisible="1"/>
<!--                                    <field name="latitude_longitude" widget="location_maps" nolabel="1" readonly="1"/>-->
                                    <field name="zoom_level" invisible="1"/>
                                    <div>
                                        <button name="action_open_map" string="View on Map" type="object"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Directions">
                            <field name="directions" nolabel="1" options="{'resizable': false}"
                                   placeholder='Add directions here...'/>
                        </page>
                        <page string="Geolocation">
                            <widget name="osm_map"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" options="{'resizable': false}"
                                   placeholder='Add notes here...'/>
                        </page>
                        <page string="Others">
                            <group>
                                <group>
                                    <field name="create_uid"/>
                                    <field name="create_date"/>
                                </group>
                                <group>
                                    <field name="write_uid"/>
                                    <field name="write_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Location tree view with more optional Hide fields. -->
    <record id="shipment_location_more_optipnal_hide_tree_view" model="ir.ui.view">
        <field name="name">shipment.location.list.view</field>
        <field name="model">shipment.location</field>
        <field name="arch" type="xml">
            <list string="Locations">
                <field name="name"/>
                <field name="street_1"/>
                <field name="street_2" optional="hide"/>
                <field name="city"/>
                <field name="state_id"/>
                <field name="zip" optional="hide"/>
                <field name="county_id" optional="hide"/>
                <field name="country_id" optional="hide"/>
                <field name="person_name" optional="hide"/>
                <field name="person_phone" optional="hide"/>
                <field name="person_email" optional="hide"/>
                <field name="write_uid" optional="hide"/>
                <field name="write_date" optional="hide"/>
                <field name="customer"/>
                <field name="latitude" optional="hide"/>
                <field name="longitude" optional="hide"/>
                <field name="timezone" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipment.location</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Location found
            </p>
        </field>
    </record>

    <!-- Get Location Coordinates -->
    <record id="action_get_location_coordinates" model="ir.actions.server">
        <field name="name">Update Coordinates Based on Address</field>
        <field name="model_id" ref="bista_driver_app.model_shipment_location"/>
        <field name="binding_model_id" ref="bista_driver_app.model_shipment_location"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('bista_driver_app.group_shipment_dispatcher_access')), (4, ref('base.group_system'))]"/>
        <field name="code">action = records.get_location_coordinates()</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_shipment_location" parent="bista_driver_app.menu_driver_fleet_shipment_configuration_menu"
              name="Locations" sequence="2" action="action_shipment_location"
              groups="bista_driver_app.group_shipment_dispatcher_access"/>

</odoo>

<odoo>
    <data>
        <!-- tree view -->
        <record model="ir.ui.view" id="bista_fleet_driver_view_tree">
            <field name="name">fleet.driver.list</field>
            <field name="model">fleet.driver</field>
            <field name="arch" type="xml">
                <list>
                    <field name="driver_name"/>
                    <field name="truck_no"/>
                    <field name="carrier_id"/>
                    <field name="driver_login" string="Phone" required="1"/>
                    <field name="write_uid"/>
                    <field name="write_date"/>
                    <field name="otp" optional="hide"/>
                    <!-- <field name="otp_expiration_time" optional="hide"/> -->
                    <field name="user_id" optional="hide"/>
                    <field name="test_user" widget="boolean_toggle" readonly="1" optional="hide"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- form view -->
        <record id="bista_fleet_driver_view_form" model="ir.ui.view">
            <field name="name">fleet.driver.form</field>
            <field name="model">fleet.driver</field>
            <field name="arch" type="xml">
                <form string="Driver">
                    <header>
                        <button class="btn btn-primary" name="generate_driver_otp" string="Generate and Send PIN"
                                type="object" groups="bista_driver_app.group_shipment_dispatcher_access"/>
                                <!-- NOTE: Send a text message will be added in the view after twilio confiugration
                                    is done and based on the regular/test driver user condition  -->
                        <!-- <button class="btn btn-primary" name="action_driver_twilio_sms" string="Send Text Message"
                                type="object" invisible="0" groups="bista_driver_app.group_shipment_dispatcher_access"/>
                        <button class="btn btn-primary" name="action_driver_app_download_link" string="Send app download link"
                                type="object" invisible="0" groups="bista_driver_app.group_shipment_dispatcher_access"/> -->
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Driver User -->
                            <button name="action_open_user" type="object" class="oe_stat_button" icon="fa-user-circle icon" groups="bista_driver_app.group_shipment_dispatcher_access">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">User</span>
                                </div>
                            </button>
                            <!-- Driver Shipments -->
                            <field name="is_shipment_exists" invisible="1"/>
                            <button name="action_open_driver_shipments" type="object" class="oe_stat_button" invisible="is_shipment_exists == False" groups="bista_driver_app.group_shipment_dispatcher_access">
                                <img src="/bista_driver_app/static/description/shipping_process_9_01.png" style="height:100%;margin-right:5px;"/>
                                <div class="o_field_widget o_stat_info">
                                    <field name="shipment_count" class="text-center" widget="statinfo" string="Shipments"/>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="driver_name" placeholder='e.g. "John Doe"' required="1"/>
                                <field name="driver_login" string="Phone" placeholder='e.g. "8329998877"' required="1"/>
                                <field name="carrier_id"/>
                                <field name="truck_no" placeholder='e.g. "55444"'/>
                                <!-- <field name="otp_expiration_time" groups="bista_driver_app.group_shipment_dispatcher_access"/> -->
                                <field name="otp" string="PIN" readonly="1" groups="bista_driver_app.group_shipment_dispatcher_access"/>
                                <div style="width: max-content;" groups="bista_driver_app.group_shipment_dispatcher_access">
                                    <i class="fa fa-info-circle" title="Expiration Time"/>
                                    <span class="mr4"> This PIN will expire after 5 min.</span>
                                </div>
                            </group>
                            <!-- <group>
                                <field name="create_uid"/>
                                <field name="create_date"/>
                                <field name="write_uid"/>
                                <field name="write_date"/>
                                <field name="test_user" widget="boolean_toggle"/>
                            </group> -->
                        </group>

                        <group class="mt-2">
                            <group>
                                <field name="policy_accepted_on"/>
                            </group>
                        </group>
                        <div groups="bista_driver_app.group_shipment_dispatcher_access">
                            <i class="fa fa-info-circle"/>
                            The timestamp recorded is the exact time when the driver agrees to the Terms &amp; Condition and 
                            <br/>
                            Privacy Policy in the Fleet Mobile App. Whenever driver agrees with the policies, date should be updated.
                            <br/>
                            So it will be last agreed date.
                        </div>

                        <group class="mt-4">
                            <field name="test_user" widget="boolean_toggle" groups="bista_driver_app.group_shipment_dispatcher_access"/>
                        </group>
                        <div groups="bista_driver_app.group_shipment_dispatcher_access">
                            <i class="fa fa-info-circle"/>
                            A test user is a staging account used to simulate a real user during development and testing,<br/>
                            allowing you to test app features without impacting live customer data. This will be shown in Fleet<br/>
                            mobile app menu as a "Switch to Staging" button.
                        </div>
                        <group string="Additional Information" groups="base.group_no_one">
                            <group>
                                <field name="is_continuous_location_tracking"/>
                                <field name="current_shipment_id"/>
                            </group>
                            <group>
                                <!-- Driver app -->
                                <!-- <field name="is_skip_sms"/> -->
                                <field name="is_valid_phone"/>
                                <field name="partner_id"/>

                                <!-- Shipment Fields -->
                                <field name="shipment_ids" invisible="1"/>
                                <field name="is_shipment_exists" invisible="1"/>
                                <field name="shipment_count" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <!-- <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div> -->
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Show limited fields in tree view search -->
        <record model="ir.ui.view" id="bista_fleet_driver_optional_tree_view">
            <field name="name">fleet.driver.list</field>
            <field name="model">fleet.driver</field>
            <field name="arch" type="xml">
                <list>
                    <field name="driver_name"/>
                    <field name="truck_no"/>
                    <field name="carrier_id"/>
                    <field name="driver_login" string="Phone" required="1"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="bista_fleet_driver_optional_search_view" model="ir.ui.view">
            <field name="name">fleet.driver.search.view</field>
            <field name="model">fleet.driver</field>
            <field name="arch" type="xml">
                <search string="Stops">
                    <field name="driver_name"/>
                    <field name="truck_no"/>
                    <field name="carrier_id"/>
                    <field name="driver_login"/>
                </search>
            </field>
        </record>

        <!-- Send Text Message to All Drivers with Mobile Notifications -->
        <!-- <record id="action_send_message_to_all_drivers" model="ir.actions.server">
            <field name="name">Send Text Message</field>
            <field name="model_id" ref="bista_driver_app.model_fleet_driver"/>
            <field name="binding_model_id" ref="bista_driver_app.model_fleet_driver"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="groups_id" eval="[(4, ref('bista_driver_app.group_shipment_dispatcher_access')), (4, ref('base.group_system'))]"/>
            <field name="code">action = records.action_driver_twilio_sms()</field>
        </record> -->

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="action_driver_fleet_view">
            <field name="name">Driver</field>
            <field name="res_model">fleet.driver</field>
            <field name="view_mode">list,form</field>
            <field name="context"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Driver found
                </p>
            </field>
        </record>


        <!-- Top menu item -->
        <!-- <menuitem id="driver_fleet_view_menu" name="Driver Fleet"
                  action="action_driver_fleet_view"
                  parent="stock.menu_warehouse_report"
                  sequence="170"/> -->

    </data>
</odoo>

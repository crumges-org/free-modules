<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="driver_app_server_tree_view" model="ir.ui.view">
            <field name="name">driver.app.server.list</field>
            <field name="model">driver.app.server</field>
            <field name="arch" type="xml">
                <list string="Servers" editable="top" create="false" delete="false">
                    <field name="name"/>
                    <field name="server_ip_address"/>
                    <field name="server_route"/>
                    <field name="api_route"/>
                    <field name="content_route"/>
                    <field name="web_route"/>
                </list>
            </field>
        </record>

        <record id="action_driver_app_server_info" model="ir.actions.act_window">
            <field name="name">Servers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">driver.app.server</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new ModelTitle.
                </p>
            </field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_stop_status_status_tree" model="ir.ui.view">
        <field name="name">stop_status.status.list</field>
        <field name="model">stop.status</field>
        <field name="arch" type="xml">
            <list string="Stop Status">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stop_status_status_form" model="ir.ui.view">
        <field name="name">stop.status.form</field>
        <field name="model">stop.status</field>
        <field name="arch" type="xml">
            <form string="Status">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                            <field name="write_uid"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stop_status_status" model="ir.actions.act_window">
        <field name="name">Stop Status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stop.status</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Status found
            </p>
        </field>
    </record>

</odoo>

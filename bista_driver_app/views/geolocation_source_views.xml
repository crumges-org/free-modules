<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="driver_geolocation_source_form_view" model="ir.ui.view">
            <field name="name">driver.geolocation.source.form</field>
            <field name="model">geolocation.source</field>
            <field name="arch" type="xml">
                <form string="geolocation_source" delete="false">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="source_type"/>
                            <field name="source_description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="driver_geolocation_source_tree_view" model="ir.ui.view">
            <field name="name">driver.geolocation.source.list</field>
            <field name="model">geolocation.source</field>
            <field name="arch" type="xml">
                <list string="geolocation_source" delete="false">
                    <field name="name"/>
                    <field name="source_type"/>
                    <field name="source_description"/>
                </list>
            </field>
        </record>

        <record id="driver_geolocation_source_search_view" model="ir.ui.view">
            <field name="name">driver.geolocation.source.search</field>
            <field name="model">geolocation.source</field>
            <field name="arch" type="xml">
                <search string="geolocation_source">
                    <field name="name" string="Source"/>
                    <field name="source_type" string="Type"/>
                    <filter name="serial_type" string="Serial" domain="[('source_type', '=', 'serial')]"
                            help="Serial Type"/>
                    <group expand="1" string="Group By">
                        <filter name="source_type" string="Type" context="{'group_by': 'source_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_driver_geolocation_source" model="ir.actions.act_window">
            <field name="name">Geolocation Sources</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">geolocation.source</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Add Sources.
                </p>
            </field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_shipment_timeline_tree" model="ir.ui.view">
        <field name="name">shipment.timeline.list</field>
        <field name="model">shipment.timeline</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="datetime"/>
                <field name="user_id"/>
<!--                <field name="source_id"/>-->
                <field name="condition"/>
                <field name="driver_coords"/>
                <field name="location_coords"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_shipment_timeline_form" model="ir.ui.view">
        <field name="name">shipment.timeline.form</field>
        <field name="model">shipment.timeline</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="shipment_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="name"/>
                        <field name="datetime"/>
                        <field name="user_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
<!--                        <field name="source_id"/>-->
                        <field name="condition"/>
                        <field name="driver_coords"/>
                        <field name="location_coords"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_timeline" model="ir.actions.act_window">
        <field name="name">Timeline</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipment.timeline</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Timeline found
            </p>
        </field>
    </record>

</odoo>

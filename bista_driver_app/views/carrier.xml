<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_shipment_carrier_tree" model="ir.ui.view">
        <field name="name">shipment.carrier.list</field>
        <field name="model">shipment.carrier</field>
        <field name="arch" type="xml">
            <list string="Carriers">
                <field name="name"/>
                <field name="write_uid"/>
                <field name="write_date"/>
                <field name="create_uid" optional="hide"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shipment_carrier_form" model="ir.ui.view">
        <field name="name">shipment.carrier.form</field>
        <field name="model">shipment.carrier</field>
        <field name="arch" type="xml">
            <form string="Carrier">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="write_uid"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipment_carrier" model="ir.actions.act_window">
        <field name="name">Carriers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">shipment.carrier</field>
        <field name="view_mode">list,form</field>
        <field name="context"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Carrier found
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_shipment_carrier" parent="bista_driver_app.menu_driver_fleet_shipment_configuration_menu"
            name="Carriers" sequence="5" action="action_shipment_carrier" groups="bista_driver_app.group_shipment_dispatcher_access"/>

</odoo>

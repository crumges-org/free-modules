<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_back_to_admin" inherit_id="website.template_header_default"
              name="Portal: Add Back to Admin Button">
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="after">
            <t t-if="(request.session.get('previous_user')
                      and request.session.get('previous_user') != request.env.user.id)
                      or request.context.get('show_back_to_admin')">
                <a t-attf-href="/switch/admin/portal"
                   class="btn btn-outline-primary ms-2"
                   id="back_to_admin_btn">
                    <i class="fa fa-sign-in me-1"></i>
                    Back to Admin
                </a>
            </t>
        </xpath>
    </template>
</odoo>

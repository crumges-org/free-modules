<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">view.product.category.form.inherit</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group[@name='first']/field[@name='parent_id']" position="after">
                <field name="prefix_barcode"/>
            </xpath>
        </field>
    </record>
</odoo>
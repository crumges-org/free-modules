<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_audit_log" model="ir.actions.report">
        <field name="name">Audit Log Report</field>
        <field name="model">audit.log.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ma_audit_log_viewer.report_audit_log_template</field>
        <field name="report_file">ma_audit_log_viewer.report_audit_log_template</field>
        <field name="print_report_name">'Audit Log'</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <template id="report_audit_log_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 style="margin-bottom:16px;">Audit Log Report</h2>
                    <table class="table table-sm table-striped"
                           style="font-size:10px;width:100%;">
                        <thead style="background-color:#1B2A4A;color:#fff;">
                            <tr>
                                <th style="padding:4px;">Date</th>
                                <th style="padding:4px;">Model</th>
                                <th style="padding:4px;">Record</th>
                                <th style="padding:4px;">Field</th>
                                <th style="padding:4px;">Op</th>
                                <th style="padding:4px;">Changed By</th>
                                <th style="padding:4px;">Old Value</th>
                                <th style="padding:4px;">New Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="line">
                                <tr>
                                    <td style="padding:3px;white-space:nowrap;">
                                        <t t-esc="line.date"/>
                                    </td>
                                    <td style="padding:3px;">
                                        <t t-esc="line.model_name"/>
                                    </td>
                                    <td style="padding:3px;">
                                        <t t-esc="line.res_name"/>
                                    </td>
                                    <td style="padding:3px;">
                                        <t t-esc="line.field_label"/>
                                    </td>
                                    <td style="padding:3px;">
                                        <t t-esc="line.operation"/>
                                    </td>
                                    <td style="padding:3px;">
                                        <t t-esc="line.user_id.name"/>
                                    </td>
                                    <td style="padding:3px;word-break:break-all;">
                                        <t t-esc="line.old_value"/>
                                    </td>
                                    <td style="padding:3px;word-break:break-all;">
                                        <t t-esc="line.new_value"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_export_wizard_form" model="ir.ui.view">
        <field name="name">audit.export.wizard.form</field>
        <field name="model">audit.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Audit Log">
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filters (optional)">
                        <field name="model_name"
                               placeholder="e.g. res.partner — leave empty for all"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <group>
                    <field name="export_format" widget="radio"/>
                </group>
                <footer>
                    <button name="action_export"
                            type="object"
                            string="Export"
                            class="btn btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_audit_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Audit Log</field>
        <field name="res_model">audit.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_config_form" model="ir.ui.view">
        <field name="name">audit.config.form</field>
        <field name="model">audit.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="field_ids"
                               widget="many2many_tags"
                               domain="[('model_id', '=', model_id), ('ttype', 'not in', ['binary', 'one2many'])]"/>
                        <field name="retention_days"/>
                        <field name="active"/>
                    </group>
                    <group string="Email Alert (optional)">
                        <field name="notify_user_id"/>
                        <field name="notify_on_field_ids"
                               widget="many2many_tags"
                               domain="[('id', 'in', field_ids)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_audit_config_list" model="ir.ui.view">
        <field name="name">audit.config.list</field>
        <field name="model">audit.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id" string="Model"/>
                <field name="field_ids" widget="many2many_tags" string="Tracked Fields"/>
                <field name="retention_days" string="Keep (days)"/>
                <field name="notify_user_id" string="Alert Recipient"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_audit_config" model="ir.actions.act_window">
        <field name="name">Audit Config</field>
        <field name="res_model">audit.config</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
